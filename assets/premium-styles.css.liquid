/* ============================================================
   THE VAULT — PREMIUM STYLES v8.0 (GROUND-UP REBUILD)
   - Single source of truth for all shop/collection/product CSS
   - No conflicting rules, no scroll-snap overrides
   - Mobile-first, then enhanced for larger screens
   ============================================================ */

/* ── DESIGN TOKENS ──────────────────────────────────────────── */
:root {
  /* System defaults (overridden below by Shopify settings where set) */
  --secret-red: {{ settings.color_secret_red | default: '#c60000' }};
  --page-bg: {{ settings.color_page_bg | default: '#0a0a0a' }};
  --surface: {{ settings.color_surface | default: '#141414' }};
  --surface-2: #1c1c1c;
  --border: rgba(255,255,255,0.07);
  --text-primary: {{ settings.color_body_text | default: '#ffffff' }};
  --text-heading: {{ settings.color_heading_text | default: '#ffffff' }};
  --text-muted: {{ settings.color_muted_text | default: '#999999' }};
  --text-dim: rgba(255,255,255,0.25);
  --link-color: {{ settings.color_link | default: '#ffffff' }};
  --link-hover: {{ settings.color_link_hover | default: '#cccccc' }};
  --btn-primary-bg: {{ settings.color_btn_primary_bg | default: '#c60000' }};
  --btn-primary-text: {{ settings.color_btn_primary_text | default: '#ffffff' }};
  --btn-secondary-bg: {{ settings.color_btn_secondary_bg | default: '#ffffff' }};
  --btn-secondary-text: {{ settings.color_btn_secondary_text | default: '#000000' }};
  --accent-green: #22c55e;
  --transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  --font-ui: 'Inter', 'Helvetica Neue', Arial, sans-serif;
  --font-display: 'Barlow Condensed', 'Inter', sans-serif;
  --pad-h: 3rem;
  --glass-bg: rgba(255,255,255,0.05);
  --glass-border: rgba(255,255,255,0.1);
  --glass-blur: blur(12px);
  --premium-shadow: 0 10px 30px -10px rgba(0,0,0,0.5);
  --transition-smooth: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  --gradient-dark: linear-gradient(180deg, rgba(0,0,0,0) 0%, rgba(0,0,0,0.8) 100%);
}



@media (max-width: 767px) {
  :root { --pad-h: 1rem; }
}

/* ── GLOBAL RESETS ──────────────────────────────────────────── */
*, *::before, *::after { box-sizing: border-box; }
.w-commerce-commerceaddtocarterrorstate { display: none !important; }

/* Force main layout wrappers to allow height to flow naturally for scroll behavior */
.barba-wrapper,
.page-content {
  height: auto !important;
}

html, body {
  background-color: #0b0b0b !important;
  color: #fff !important;
  overflow: visible !important;
}
.page-content {
  overflow: visible !important;
  overflow-x: clip !important;
}

/* ── PAGE TRANSITIONS ───────────────────────────────────────── */
.page-transition-overlay {
  position: fixed; top: 0; left: 0; width: 100%; height: 100%;
  background: #000; z-index: 10000;
  transform: translateY(100%); pointer-events: none;
}

/* ── LOADING SHIMMER ────────────────────────────────────────── */
@keyframes shimmer {
  0% { background-position: -468px 0; }
  100% { background-position: 468px 0; }
}

/* ── SHOP / COLLECTION PAGE SHELL ───────────────────────────── */
.jj-page-shell {
  background: var(--page-bg);
  min-height: 100vh;
  width: 100%;
}

/* ── ANNOUNCEMENT BAR ───────────────────────────────────────── */
.jj-announce-bar {
  width: 100%;
  background: var(--surface);
  border-bottom: 1px solid var(--border);
  overflow: hidden;
}

/* ── MARQUEE ────────────────────────────────────────────────── */
.jj-marquee-wrapper {
  width: 100%;
  height: 42px;
  display: flex;
  align-items: center;
  overflow: hidden;
  mask-image: linear-gradient(to right, transparent 0%, black 10%, black 90%, transparent 100%);
  -webkit-mask-image: linear-gradient(to right, transparent 0%, black 10%, black 90%, transparent 100%);
}

.jj-marquee-track {
  display: flex;
  align-items: center;
  width: max-content;
  flex-shrink: 0;
  animation: marquee-scroll 30s linear infinite;
}

@keyframes marquee-scroll {
  0% { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}

.jj-content-group {
  display: flex;
  align-items: center;
  padding-right: 8rem;
}

.jj-text-item {
  font-family: var(--font-ui);
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--text-muted);
  white-space: nowrap;
  margin-right: 5rem;
}

/* ── FILTER BAR ─────────────────────────────────────────────── */
.jj-filter-root {
  position: sticky;
  top: 0;
  z-index: 800;
  background: rgba(10,10,10,0.92);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-bottom: 1px solid var(--border);
  width: 100%;
}

.jj-filter-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 var(--pad-h);
  height: 52px;
  gap: 2rem;
  flex-wrap: wrap;
}

@media (max-width: 767px) {
  .jj-filter-inner {
    height: auto;
    padding: 0.75rem var(--pad-h);
    gap: 0.75rem;
  }
}

.jj-filter-groups {
  display: flex;
  align-items: center;
  gap: 0;
  flex-wrap: wrap;
}

.jj-filter-hint {
  font-family: var(--font-ui);
  font-size: 10px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--text-dim);
  margin-right: 1rem;
}

.jj-filter-chip {
  font-family: var(--font-ui);
  font-size: 11px;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--text-muted);
  text-decoration: none;
  padding: 4px 14px;
  border: 1px solid transparent;
  border-radius: 2px;
  transition: var(--transition);
  white-space: nowrap;
  margin-right: 4px;
}
.jj-filter-chip:hover, .jj-filter-chip.is-active {
  color: var(--text-primary);
  border-color: var(--border);
  background: var(--glass-bg);
}

/* Dropdown groups */
.jj-filter-group { position: relative; }

.jj-filter-trigger {
  display: flex;
  align-items: center;
  gap: 6px;
  font-family: var(--font-ui);
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--text-muted);
  background: none;
  border: none;
  cursor: pointer;
  padding: 4px 16px;
  height: 52px;
  border-right: 1px solid var(--border);
  transition: color 0.2s ease;
}

@media (max-width: 767px) {
  .jj-filter-trigger { height: auto; padding: 6px 10px; border-right: none; }
}

.jj-filter-trigger:hover, .jj-filter-trigger.is-open { color: var(--text-primary); }
.jj-filter-trigger svg { transition: transform 0.2s ease; }
.jj-filter-trigger.is-open svg { transform: rotate(180deg); }

.jj-filter-menu {
  position: absolute;
  top: calc(100% + 4px);
  left: 0;
  min-width: 220px;
  max-height: 320px;
  overflow-y: auto;
  background: #111;
  border: 1px solid var(--border);
  border-radius: 4px;
  box-shadow: 0 20px 50px rgba(0,0,0,0.8);
  z-index: 1000;
  padding: 8px 0;
}

.jj-filter-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 9px 16px;
  cursor: pointer;
  font-family: var(--font-ui);
  font-size: 12px;
  color: var(--text-muted);
  transition: background 0.15s ease, color 0.15s ease;
  gap: 8px;
}
.jj-filter-option input { display: none; }
.jj-filter-option:hover, .jj-filter-option.is-active {
  background: var(--surface-2);
  color: var(--text-primary);
}
.jj-filter-option.is-active { color: var(--accent-green); }

.jj-filter-count {
  font-size: 10px;
  color: var(--text-dim);
  margin-left: auto;
  flex-shrink: 0;
}

/* Sort chips */
.jj-filter-sort {
  display: flex;
  align-items: center;
  gap: 4px;
  flex-wrap: wrap;
}

.jj-sort-chip {
  font-family: var(--font-ui);
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--text-dim);
  text-decoration: none;
  padding: 4px 10px;
  border: 1px solid transparent;
  border-radius: 2px;
  transition: var(--transition);
  white-space: nowrap;
}
.jj-sort-chip:hover, .jj-sort-chip.is-active {
  color: var(--text-primary);
  border-color: var(--border);
}
.jj-sort-chip.is-clear { color: var(--secret-red); border-color: rgba(198,0,0,0.3); }

/* ── PAGE CONTENT AREA ──────────────────────────────────────── */
.jj-page-content { padding: 3rem var(--pad-h) 6rem; }

.jj-page-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 2.5rem;
  gap: 1rem;
  flex-wrap: wrap;
}

.jj-page-title {
  font-family: var(--font-display);
  font-size: clamp(1.8rem, 4vw, 3rem);
  font-weight: 800;
  letter-spacing: -0.01em;
  color: var(--text-primary);
  margin: 0;
  line-height: 1;
}

.jj-page-count {
  font-family: var(--font-ui);
  font-size: 10px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--text-dim);
  flex-shrink: 0;
}

/* ── PRODUCT GRID ───────────────────────────────────────────── */
.jj-product-grid-wrapper { width: 100%; }

.jj-grid-v4 {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1px;
  background: var(--border);
  border: 1px solid var(--border);
}

@media (min-width: 992px) {
  .jj-grid-v4 { grid-template-columns: repeat(3, 1fr); }
}

/* ── PRODUCT CARD ───────────────────────────────────────────── */
.jj-card {
  display: flex;
  flex-direction: column;
  background: var(--page-bg);
  text-decoration: none;
  color: var(--text-primary);
  transition: background 0.2s ease;
  overflow: hidden;
}
.jj-card:hover { background: var(--surface); }

.jj-card-image {
  position: relative;
  width: 100%;
  aspect-ratio: 3 / 4;
  overflow: hidden;
  background: var(--surface);
}

.jj-card-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
}

.jj-card:hover .jj-card-image img { transform: scale(1.04); }

.jj-card-no-image { width: 100%; height: 100%; background: var(--surface-2); }

.jj-badge {
  position: absolute;
  top: 12px; left: 12px;
  font-family: var(--font-ui);
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  padding: 4px 8px;
  background: var(--surface);
  color: var(--text-muted);
  border: 1px solid var(--border);
}
.jj-badge.sold-out { color: var(--text-dim); }

.jj-card-info {
  padding: 14px 16px 18px;
  border-top: 1px solid var(--border);
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.jj-card-vendor {
  font-family: var(--font-ui);
  font-size: 9px;
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--text-dim);
}

.jj-card-title {
  font-family: var(--font-ui);
  font-size: 13px;
  font-weight: 500;
  color: var(--text-primary);
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

@media (max-width: 767px) { .jj-card-title { font-size: 12px; } }

.jj-card-price {
  font-family: var(--font-ui);
  font-size: 13px;
  font-weight: 600;
  color: var(--text-primary);
  display: flex;
  align-items: center;
  gap: 8px;
  margin-top: 2px;
}

.jj-card-compare {
  font-size: 11px;
  color: var(--text-dim);
  text-decoration: line-through;
}

/* ── EMPTY STATE ────────────────────────────────────────────── */
.jj-empty-state {
  padding: 6rem var(--pad-h);
  text-align: center;
  color: var(--text-muted);
  font-family: var(--font-ui);
  font-size: 14px;
}

.jj-btn-outline {
  display: inline-block;
  margin-top: 1.5rem;
  padding: 12px 28px;
  border: 1px solid var(--border);
  color: var(--text-primary);
  text-decoration: none;
  font-family: var(--font-ui);
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  transition: var(--transition);
}
.jj-btn-outline:hover { background: var(--glass-bg); border-color: rgba(255,255,255,0.3); }

/* ── PRODUCT PAGE ───────────────────────────────────────────── */

/* Kill all Webflow height constraints that create vertical voids */
.div-block-629,
.thumbnail-section,
.main-image-container,
.more-image-container,
.product-template-container {
  height: auto !important;
  min-height: 0 !important;
  max-height: none !important;
  overflow: visible !important;
}

@media (min-width: 992px) {
  .div-block-629 {
    display: flex !important;
    flex-direction: row !important;
    align-items: flex-start !important;
    gap: 3rem !important;
    justify-content: space-between !important;
  }
  .thumbnail-section { width: 50% !important; flex-shrink: 0 !important; }
  .product-container {
    width: 50% !important;
    padding-left: 2rem !important;
    border-left: 1px solid #252525 !important;
    border-right: none !important;
    padding-right: 0 !important;
  }
}

@media (max-width: 991px) {
  .div-block-629 { flex-direction: column !important; }
  .thumbnail-section { width: 100% !important; }
  .product-container { width: 100% !important; padding: 1.5rem 0 !important; border: none !important; }
  .main-image-container { height: auto !important; }
  .image-4 { width: 100% !important; height: auto !important; display: block !important; }
}

@media (max-width: 767px) {
  .div-block-629 { padding-left: 0 !important; padding-right: 0 !important; }
  .div-block-1155 { padding-top: 0 !important; }
}

/* ── PRODUCT DESCRIPTION ────────────────────────────────────── */
.jj-product-status { display: flex; align-items: center; gap: 8px; margin-bottom: 14px; }

.jj-status-dot {
  width: 7px; height: 7px;
  border-radius: 50%;
  background: var(--accent-green);
  flex-shrink: 0;
  animation: pulse-dot 1.5s ease-in-out infinite alternate;
}

@keyframes pulse-dot {
  0% { box-shadow: 0 0 5px var(--accent-green); opacity: 0.8; }
  100% { box-shadow: 0 0 15px var(--accent-green), 0 0 25px rgba(34,197,94,0.5); opacity: 1; }
}

.jj-status-text {
  font-family: var(--font-ui);
  font-size: 9px;
  font-weight: 600;
  letter-spacing: 0.14em;
  color: var(--text-muted);
  text-transform: uppercase;
}

.jj-price-row {
  display: flex;
  align-items: baseline;
  gap: 12px;
  margin-bottom: 1.25rem;
  flex-wrap: wrap;
}

.jj-compare-price {
  font-size: 0.85rem;
  color: var(--text-dim);
  text-decoration: line-through;
  font-family: var(--font-ui);
}

.jj-meta-row {
  display: flex;
  align-items: stretch;
  border: 1px solid var(--border);
  border-radius: 6px;
  overflow: hidden;
  margin-bottom: 1.25rem;
}

.jj-meta-item { flex: 1; display: flex; flex-direction: column; gap: 3px; padding: 9px 12px; min-width: 0; }

.jj-meta-divider { width: 1px; flex-shrink: 0; background: var(--border); }

.jj-meta-label {
  font-family: var(--font-ui);
  font-size: 8px;
  font-weight: 700;
  letter-spacing: 0.14em;
  color: var(--text-dim);
  text-transform: uppercase;
  white-space: nowrap;
}

.jj-meta-value {
  font-family: var(--font-display);
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.06em;
  color: var(--text-primary);
  text-transform: uppercase;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.jj-vendor-link { color: var(--text-primary) !important; text-decoration: none; }
.jj-auth-badge { color: var(--accent-green) !important; }

.jj-description { margin-bottom: 1.25rem; padding: 14px 0; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
.jj-description p { font-family: var(--font-ui); font-size: 12px; line-height: 1.75; color: var(--text-muted); margin: 0; }

.jj-trust-row { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 1.25rem; padding-top: 1rem; border-top: 1px solid var(--border); }
.jj-trust-item { display: flex; align-items: center; gap: 7px; color: var(--text-muted); font-family: var(--font-ui); font-size: 10px; letter-spacing: 0.04em; }
.jj-trust-item svg { flex-shrink: 0; opacity: 0.45; width: 15px; height: 15px; }

@media (max-width: 479px) {
  .jj-meta-row { flex-direction: column; }
  .jj-meta-divider { width: 100%; height: 1px; }
  .jj-meta-item { flex-direction: row; justify-content: space-between; align-items: center; }
}

/* ── SIMILAR ITEMS ──────────────────────────────────────────── */
.new-similar-items { width: 100%; padding: 3rem 0 5rem; }

.new-similar-items .title-label.product {
  font-family: var(--font-display);
  font-size: 1.5rem !important;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  margin-bottom: 1.5rem;
  display: block;
  color: var(--text-primary);
}

@media (min-width: 768px) {
  .new-similar-items .collection-list-2 {
    display: grid !important;
    grid-template-columns: repeat(4, 1fr) !important;
    gap: 20px !important;
    overflow: visible !important;
    width: 100% !important;
  }
  .new-similar-items .collection-item-2 { width: 100% !important; margin: 0 !important; display: block !important; }
}

@media (max-width: 767px) {
  .new-similar-items .collection-list-2 {
    display: grid !important;
    grid-template-columns: repeat(2, 1fr) !important;
    gap: 10px !important;
    overflow: visible !important;
    width: 100% !important;
  }
  .new-similar-items .collection-item-2 { width: 100% !important; margin: 0 !important; padding: 0 0 0.5rem 0 !important; display: block !important; }
}

/* Fix card images in similar items and elsewhere */
.collection-item-2 .image-6,
.collection-item-2 img {
  width: 100% !important;
  height: auto !important;
  aspect-ratio: 3/4 !important;
  object-fit: cover !important;
  display: block !important;
  border-radius: 2px;
}

.collection-item-2 { transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1); }
.collection-item-2:hover { transform: translateY(-4px); }

/* ── VARIANT PILLS ──────────────────────────────────────────── */
.w-commerce-commerceaddtocartoptionpill.w--selected,
[role="radio"][aria-checked="true"] {
  background: transparent !important;
  color: var(--text-primary) !important;
  border: 2px solid var(--secret-red) !important;
  box-shadow: 0 0 12px rgba(198,0,0,0.3) !important;
  font-weight: 700 !important;
}
.w-commerce-commerceaddtocartoptionpill:hover { border-color: rgba(255,255,255,0.4) !important; }

/* ── BUTTONS ────────────────────────────────────────────────── */
.add-to-cart-button, .w-commerce-commerceaddtocartbutton {
  height: 56px !important;
  font-size: 13px !important;
  letter-spacing: 0.12em !important;
  border-radius: 0 !important;
  transition: var(--transition) !important;
}
.add-to-cart-button:hover, .w-commerce-commerceaddtocartbutton:hover {
  border: 1px solid var(--secret-red) !important;
  box-shadow: 0 0 15px rgba(198,0,0,0.25) !important;
}

/* ── LAYOUT GLOBALS ─────────────────────────────────────────── */
.premium-container { max-width: 100%; padding: 0 var(--pad-h); }



/* ── TYPOGRAPHY ─────────────────────────────────────────────── */
h1, .heading { letter-spacing: -0.02em; line-height: 1; }
.title-label { font-size: 42px !important; letter-spacing: -1px !important; margin-bottom: 20px !important; }
.field-label.asd { text-transform: uppercase; letter-spacing: 2px; font-size: 11px; opacity: 0.5; margin-bottom: 12px; }

/* ── CART ───────────────────────────────────────────────────── */
.cart-item { padding-left: 1rem !important; padding-right: 1rem !important; }

/* ── GLASS EFFECT ───────────────────────────────────────────── */
.glass-effect {
  background: var(--glass-bg);
  backdrop-filter: var(--glass-blur);
  -webkit-backdrop-filter: var(--glass-blur);
  border: 1px solid var(--glass-border);
  box-shadow: var(--premium-shadow);
}

/* ── VENDOR LIST ────────────────────────────────────────────── */
.vendor-list-scroll { max-height: 80vh; overflow-y: auto; padding-right: 15px; }
.vendor-list-scroll::-webkit-scrollbar { width: 4px; }
.vendor-list-scroll::-webkit-scrollbar-track { background: transparent; }
.vendor-list-scroll::-webkit-scrollbar-thumb { background: #333; border-radius: 10px; }

/* ── SEO HIDDEN ─────────────────────────────────────────────── */
.seo-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); border: 0; }

/* ── OVERHAUL AESTHETICS (legacy card classes) ──────────────── */
.collection-item-2.w-dyn-item { transition: all 0.4s cubic-bezier(0.25, 1, 0.5, 1); background: transparent; border: none; }
.image-6 { border-radius: 2px; }

/* ── MOBILE GLOBAL CLEANUP ──────────────────────────────────── */
@media (max-width: 767px) {
  .tabs-menu.w-tab-menu, .w-tab-link, .w-tab-content { border: none !important; background: transparent !important; }
  .desciption-contaer { border: none !important; }
  .section-5.mobile.shop { padding: 0 1rem !important; }
}

/* ── SHIMMER WRAPPER ────────────────────────────────────────── */
.shimmer-wrapper {
  background: #111;
  background-image: linear-gradient(to right, #111 0%, #181818 20%, #111 40%, #111 100%);
  background-repeat: no-repeat;
  background-size: 800px 100%;
  display: inline-block;
  position: relative;
