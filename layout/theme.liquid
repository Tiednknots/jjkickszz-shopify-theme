<!DOCTYPE html>

<html data-wf-page="{{ wfPage }}" data-wf-site="692e9588093fdf59aecf42c9" lang="{{ request.locale.iso_code }}" data-money-format="{{ shop.money_format | escape }}"><!--Last Published: 2026-05-01T08:33:24.877Z--><head>{%- liquid
    if headerSnippetPath
        include headerSnippetPath
    else
        render "__default-head"
    endif
-%}
{{content_for_header}}
{% if template contains 'customers' %}
    {{ "shopify_common.js" | shopify_asset_url | script_tag }}
{% endif %}
{{ "premium-styles.css" | asset_url | stylesheet_tag }}
</head>
<body class="{{ bodyClasses }} {{ "template-" | append: request.page_type | handle }}">
{% if headerSnippetPath %}
    {{ content_for_layout }}
{% else %}
    {% include "backup-layout" %}
{% endif %}
{%- render 'music-player' -%}
<script>
  (function() {
    function translateSizes() {
      const elements = document.querySelectorAll('.sizes-variants');
      elements.forEach(el => {
        let txt = el.textContent.trim().toUpperCase();
        if (txt === 'XSMALL' || txt === 'X-SMALL' || txt === 'XS' || txt === 'EXTRA SMALL' || txt === 'X SMALL') el.textContent = 'XS';
        else if (txt === 'SMALL') el.textContent = 'S';
        else if (txt === 'MEDIUM') el.textContent = 'M';
        else if (txt === 'LARGE') el.textContent = 'L';
        else if (txt === 'XLARGE' || txt === 'X-LARGE' || txt === 'EXTRA LARGE') el.textContent = 'XL';
        else if (txt === 'XXLARGE' || txt === 'XX-LARGE' || txt === '2XL' || txt === 'XX LARGE') el.textContent = 'XXL';
        else if (txt === 'XXXLARGE' || txt === 'XXX-LARGE' || txt === '3XL' || txt === 'XXX LARGE') el.textContent = '3XL';
        else if (txt === 'ONE SIZE' || txt === 'ONESIZE') el.textContent = 'O/S';
      });
    }

    // Run immediately
    translateSizes();

    // Run on DOM load
    document.addEventListener('DOMContentLoaded', translateSizes);
    window.addEventListener('load', translateSizes);

    // Watch for dynamic updates (Finsweet, Udesly, Shopify Apps)
    const observer = new MutationObserver((mutations) => {
      let shouldRun = false;
      for (const mutation of mutations) {
        if (mutation.addedNodes.length > 0) {
          shouldRun = true;
          break;
        }
      }
      if (shouldRun) {
        translateSizes();
      }
    });

    observer.observe(document.body, { childList: true, subtree: true });
  })();
</script>
<script>
  // --- SCROLL POSITION RETENTION ON BACK NAVIGATION ---
  (function() {
    const safeStorage = {
      getItem(key) {
        try { return sessionStorage.getItem(key); } catch (e) { return null; }
      },
      setItem(key, value) {
        try { sessionStorage.setItem(key, value); } catch (e) {}
      }
    };

    const getStorageKey = () => `jj_scroll_${window.location.pathname}${window.location.search}`;

    const saveScrollPositions = () => {
      const data = {
        windowY: window.scrollY,
        containers: []
      };
      document.querySelectorAll('.contents-of-scroll').forEach((el, index) => {
        data.containers.push({
          index: index,
          scrollLeft: el.scrollLeft,
          scrollTop: el.scrollTop
        });
      });
      safeStorage.setItem(getStorageKey(), JSON.stringify(data));
    };

    // Save scroll state on clicking any internal links
    document.addEventListener('click', (e) => {
      const link = e.target.closest('a');
      if (link && link.href && link.href.startsWith(window.location.origin)) {
        saveScrollPositions();
      }
    });

    // Save scroll state on page unload
    window.addEventListener('beforeunload', saveScrollPositions);
    window.addEventListener('pagehide', saveScrollPositions);

    const restoreScrollPositions = () => {
      const saved = safeStorage.getItem(getStorageKey());
      if (!saved) return;
      try {
        const data = JSON.parse(saved);
        if (typeof data.windowY === 'number') {
          window.scrollTo(0, data.windowY);
        }
        if (Array.isArray(data.containers)) {
          const containers = document.querySelectorAll('.contents-of-scroll');
          data.containers.forEach(item => {
            const el = containers[item.index];
            if (el) {
              if (typeof item.scrollLeft === 'number') el.scrollLeft = item.scrollLeft;
              if (typeof item.scrollTop === 'number') el.scrollTop = item.scrollTop;
            }
          });
        }
      } catch (e) {}
    };

    // Restore scroll positions at multiple intervals to handle dynamic load-in
    document.addEventListener('DOMContentLoaded', restoreScrollPositions);
    window.addEventListener('load', () => {
      setTimeout(restoreScrollPositions, 50);
      setTimeout(restoreScrollPositions, 150);
      setTimeout(restoreScrollPositions, 350);
      setTimeout(restoreScrollPositions, 750);
      setTimeout(restoreScrollPositions, 1500);
    });
  })();
</script>
</body></html>