</style>
  <script>
  // --- 1. SCROLLBAR ENGINE ---
  function initCustomScroll() {
    const containers = document.querySelectorAll('.contents-of-scroll');
    containers.forEach(container => {
      let track = null; let bar = null; let parent = container.parentElement;
      for (let i = 0; i < 6; i++) {
        if (parent) {
          track = parent.querySelector('.track-for-scrolly');
          if (track) { bar = track.querySelector('.bar-of-scrolly') || parent.querySelector('.bar-of-scrolly'); break; }
          parent = parent.parentElement;
        }
      }
      if (track && bar) {
        let isDragging = false; let startX, startLeft;
        const updateBar = () => {
          if (isDragging) return; 
          const scrollLeft = container.scrollLeft;
          const maxScroll = container.scrollWidth - container.clientWidth;
          if (maxScroll <= 0) return;
          const scrollPercent = scrollLeft / maxScroll;
          const maxMove = track.clientWidth - bar.clientWidth;
          bar.style.transform = `translateX(${scrollPercent * maxMove}px)`;
        };
        const onMouseDown = (e) => {
          isDragging = true; startX = e.pageX;
          const matrix = new DOMMatrix(window.getComputedStyle(bar).getPropertyValue('transform'));
          startLeft = matrix.m41; 
          document.body.style.userSelect = 'none'; bar.style.cursor = 'grabbing';
          document.addEventListener('mousemove', onMouseMove);
          document.addEventListener('mouseup', onMouseUp);
        };
        const onMouseMove = (e) => {
          if (!isDragging) return;
          const maxMove = track.clientWidth - bar.clientWidth;
          let newLeft = startLeft + (e.pageX - startX);
          if (newLeft < 0) newLeft = 0; if (newLeft > maxMove) newLeft = maxMove;
          bar.style.transform = `translateX(${newLeft}px)`;
          container.scrollLeft = (newLeft / maxMove) * (container.scrollWidth - container.clientWidth);
        };
        const onMouseUp = () => {
          isDragging = false; document.body.style.userSelect = ''; bar.style.cursor = 'pointer';
          document.removeEventListener('mousemove', onMouseMove);
          document.removeEventListener('mouseup', onMouseUp);
        };
        container.addEventListener('scroll', updateBar);
        window.addEventListener('resize', updateBar);
        bar.addEventListener('mousedown', onMouseDown);
        setTimeout(updateBar, 100);
      }
    });
  }
  // --- 2. GALLERY CLICK WATCHER ---
  function initGallery() {
    document.addEventListener('click', function(e) {
      const thumbWrapper = e.target.closest('.thumb-image');
      if (!thumbWrapper) return; 
      const thumbImg = thumbWrapper.tagName === 'IMG' ? thumbWrapper : thumbWrapper.querySelector('img');
      if (!thumbImg) return;
      const mainImg = document.getElementById('main-image');
      if (!mainImg) return;
      const oldMainSrc = mainImg.src; const oldMainSrcSet = mainImg.srcset;
      mainImg.src = thumbImg.src; mainImg.srcset = thumbImg.srcset;
      thumbImg.src = oldMainSrc; thumbImg.srcset = oldMainSrcSet;
    }, true);
  }
  // --- 3. CURSOR LOGIC ---
  function initCursor() {
    var tricksCursor = document.querySelector('.cursor');
    if (tricksCursor) {
      if (window.cursorFunc) window.removeEventListener('mousemove', window.cursorFunc);
      window.cursorFunc = function(e) {
        tricksCursor.style.top = e.clientY + 'px';
        tricksCursor.style.left = e.clientX + 'px';
      };
      window.addEventListener('mousemove', window.cursorFunc);
    }
    if (typeof $ !== 'undefined') {
      $("a, .nav_link, .project-block, .logo").off("mouseenter mouseleave").hover(
        function() { $('.cursor').addClass('cursor-hover'); },
        function() { $('.cursor').removeClass('cursor-hover'); }
      );
      $("body").off("mousedown mouseup").hover(function(){}, function(){});
      $("body").mousedown(function() { $('.cursor').addClass('cursor-pressed'); });
      $("body").mouseup(function() { $('.cursor').removeClass('cursor-pressed'); });
    }
  }
  // --- 4. TABS LOGIC ---
  function initTabs() {
    if (typeof FsLibrary !== 'undefined' && document.querySelector('.fs-dynamic-feed')) {
      try {
        new FsLibrary('.fs-dynamic-feed').tabs({
          tabComponent: '.fs-tabs', tabContent: '.fs-tab-content',
          tabbackground: '.fs-background', tabName: '.fs-tab-name'
        });
      } catch(e) {}
    }
  }
    // Actively watch and hide Webflow error state
    const observer = new MutationObserver((mutations) => {
      mutations.forEach((m) => {
        if (m.target.classList.contains('w-commerce-commerceaddtocarterrorstate') && m.target.style.display !== 'none') {
          m.target.style.display = 'none';
        }
      });
    });
    document.querySelectorAll('.w-commerce-commerceaddtocarterrorstate').forEach(el => {
      observer.observe(el, { attributes: true, attributeFilter: ['style'] });
    });
  }
  // --- 6. WEBFLOW RELOAD (Fixes Accordions & UI) ---
  function forceWebflowReload() {
    if (window.Webflow) {
      window.Webflow.destroy();
      window.Webflow.ready();
      if (window.Webflow.require('ix2')) window.Webflow.require('ix2').init();
    }
    // Fallback script reload
    const scripts = document.querySelectorAll('script');
    let webflowSrc = null;
    scripts.forEach(s => { if (s.src && s.src.includes('webflow')) { webflowSrc = s.src; s.remove(); } });
    if (webflowSrc) {
      const ns = document.createElement('script');
      ns.src = webflowSrc; ns.type = 'text/javascript'; ns.async = false;
      document.body.appendChild(ns);
    }
  }
  // --- 7. ACCORDION (Shop By Brand Filter) ---
  function initAccordion() {
    // Start all accordions closed
    document.querySelectorAll('.accordion-bottom').forEach(function(b) {
      b.style.display = 'none';
    });
    document.querySelectorAll('.accordion-top').forEach(function(top) {
      top.addEventListener('click', function() {
        var accordion = this.closest('.accordion');
        if (!accordion) return;
        var bottom = accordion.querySelector('.accordion-bottom');
        if (!bottom) return;
        var isOpen = bottom.style.display === 'block';
        // Close all others first
        document.querySelectorAll('.accordion').forEach(function(a) {
          var b = a.querySelector('.accordion-bottom');
          var t = a.querySelector('.accordion-top');
          if (b) b.style.display = 'none';
          if (t) t.classList.remove('active');
        });
        // Toggle this one
        if (!isOpen) {
          bottom.style.display = 'block';
          this.classList.add('active');
        }
      });
    });
  }
  document.addEventListener('DOMContentLoaded', function() {
    initCustomScroll();
    initGallery();
    initCursor();
    initTabs();
    initAccordion();
  });
  window.addEventListener('load', function() {
    initCustomScroll();
    initAccordion();
  });
</script>

