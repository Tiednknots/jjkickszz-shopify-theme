{%- assign headerSnippetPath = "header-search" -%}{%- assign wfPage = "69dd6e2db9eddc61a86d9f97" -%}{%- assign bodyClasses = "" -%}
  {%- render 'global-navbar' -%}
  {%- section 'scrolling-highlights' -%}
  <div class="div-block-1155 {% if search.performed %}has-results{% endif %}" id="jj-search-root" style="opacity:0;transition:opacity 0.15s ease;">
    <!-- Streetwear landing hero (shows only when no results are active) -->
    <div class="search-hero-container">
      <div class="search-landing-hero">
        <h1 class="search-hero-title">FIND YOUR GRAILS.</h1>
        <p class="search-hero-subtitle">ENTER SNEAKERS, BRANDS, OR SIZES BELOW</p>
      </div>
    </div>

    <div data-node-type="search-result-wrapper" style="width: 100% !important; max-width: none !important;">
      {%- if search.performed -%}
        {%- paginate search.results by 48 -%}
          {%- if search.results_count > 0 -%}
            <div class="search-result-list">
              {%- for item in search.results -%}
                {%- if item.object_type == 'product' -%}
                  {%- if item.handle == 'shipping-insurance' or item.title contains 'Insurance' -%}{%- continue -%}{%- endif -%}
                  <div class="search-result-item" data-vendor="{{ item.vendor | escape }}">
                    <div class="search-result-image-wrap">
                      <img class="search-result-image" loading="lazy" src="{{ item.featured_image | img_url: '400x' }}" alt="{{ item.featured_image.alt | default: item.title }}">
                    </div>
                    <div class="search-result-info">
                      <div class="search-result-meta-top">
                        <div class="search-result-vendor">{{ item.vendor }}</div>
                        <h3 class="search-result-title">{{ item.title }}</h3>
                        <div class="search-result-desc">{{ item.description | strip_html | truncate: 120 }}</div>
                        <div class="search-result-price">{{ item.price | money }}</div>
                      </div>
                      <div class="search-result-actions">
                        <a href="{{ item.url }}" class="search-btn search-btn-view">View</a>
                        <form action="/cart/add" method="post" enctype="multipart/form-data" style="flex:1; display:flex; margin:0; padding:0;">
                          <input type="hidden" name="id" value="{{ item.variants.first.id }}">
                          <input type="hidden" name="quantity" value="1">
                          <button type="submit" class="search-btn search-btn-cart" {% unless item.available %}disabled style="opacity:0.5; cursor:not-allowed;"{% endunless %}>
                            {% if item.available %}Add to Cart{% else %}Sold Out{% endif %}
                          </button>
                        </form>
                      </div>
                    </div>
                    {%- capture _jj_meta -%}{{ item.vendor }}|{{ item.product_type }}|{{ item.tags | join: "|" }}|{{ item.price | money_without_trailing_zeros }}|{{ item.price_min | money_without_trailing_zeros }}|{{ item.price_max | money_without_trailing_zeros }}{%- for _v in item.variants -%}|{{ _v.title }}{%- endfor -%}{%- for _opt in item.options_with_values -%}{%- for _val in _opt.values -%}|{{ _val }}{%- endfor -%}{%- endfor -%}{%- endcapture -%}<span class="jj-search-meta" aria-hidden="true" style="display:none;position:absolute;width:1px;height:1px;overflow:hidden;">{{ _jj_meta }}</span>
                  </div>
                {%- endif -%}
              {%- endfor -%}
              <div class="search-end-of-results" style="width: 100%; text-align: center; padding: 40px 0; color: rgba(255,255,255,0.3); font-family: 'Inter', sans-serif; font-size: 11px; letter-spacing: 0.15em; text-transform: uppercase; grid-column: 1 / -1;">— END OF RESULTS —</div>
            </div>
            {%- if paginate.pages > 1 -%}
              <div class="jj-pagination-container" style="display: flex; justify-content: center; align-items: center; gap: 8px; margin: 40px 0 20px 0; width: 100%; font-family: 'Inter', sans-serif;">
                {%- if paginate.previous -%}
                  <a href="{{ paginate.previous.url }}" class="jj-page-link jj-page-prev" style="padding: 10px 18px; background: #141414; border: 1px solid #2e2e2e; color: #ffffff; text-decoration: none; border-radius: 4px; font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; transition: all 0.2s ease;">← Previous</a>
                {%- endif -%}
                {%- for part in paginate.parts -%}
                  {%- if part.is_link -%}
                    <a href="{{ part.url }}" class="jj-page-link" style="padding: 8px 14px; background: #141414; border: 1px solid #2e2e2e; color: rgba(255,255,255,0.7); text-decoration: none; border-radius: 4px; font-size: 13px; font-weight: 600; transition: all 0.2s ease;">{{ part.title }}</a>
                  {%- else -%}
                    {%- if part.title == paginate.current_page -%}
                      <span class="jj-page-link jj-page-active" style="padding: 8px 14px; background: #c60000; border: 1px solid #c60000; color: #ffffff; border-radius: 4px; font-size: 13px; font-weight: 700;">{{ part.title }}</span>
                    {%- else -%}
                      <span class="jj-page-link jj-page-dots" style="padding: 8px 10px; color: rgba(255,255,255,0.4); font-size: 13px;">{{ part.title }}</span>
                    {%- endif -%}
                  {%- endif -%}
                {%- endfor -%}
                {%- if paginate.next -%}
                  <a href="{{ paginate.next.url }}" class="jj-page-link jj-page-next" style="padding: 10px 18px; background: #141414; border: 1px solid #2e2e2e; color: #ffffff; text-decoration: none; border-radius: 4px; font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; transition: all 0.2s ease;">Next →</a>
                {%- endif -%}
              </div>
            {%- endif -%}
          {%- endif -%}
          {%- if search.results_count == 0 -%}
            <div class="search-result-list" style="display:none;"></div>
            <div data-node-type="search-result-empty">
              <div data-node-type="block" style="text-align: center; padding: 40px; color: rgba(255,255,255,0.4); font-family: 'Inter', sans-serif; font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase;">No results found matching your search.</div>
            </div>
          {%- endif -%}
        {%- endpaginate -%}
      {%- else -%}
        <div class="search-result-list"></div>
      {%- endif -%}
    </div>
    
    <!-- Fixed bottom search bar container -->
    <div class="search-bar-sticky-container">
      <form action="/search" class="search w-form" method="get" role="search">
        <input type="hidden" name="type" value="product">
        <input type="hidden" name="options[prefix]" value="last">
        <input type="hidden" name="options[unavailable_products]" value="show">
        <div class="search-input-wrapper">
          <span class="search-icon-left">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,0.4)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
          </span>
          <input class="search-input w-input" maxlength="256" name="q" placeholder="WHAT HEAT ARE YOU LOOKING FOR?" type="search" id="search" autocomplete="off" required="">
        </div>
        <input type="submit" class="search-button w-button" value="Search">
      </form>
    </div>
  </div>
  <script src="https://d3e54v103j8qbb.cloudfront.net/js/jquery-3.5.1.min.dc5e7f18c8.js?site=692e9588093fdf59aecf42c9" type="text/javascript" integrity="sha256-9/aliU8dGd2tb6OSsuzixeV4y/faTqgFtohetphbbj0=" crossorigin="anonymous"></script>
  <script src="{{ 'webflow.js' | asset_url }}" type="text/javascript"></script>
  <script src="https://unpkg.com/@barba/core"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/@finsweet/cms-library@1/cms-library.js"></script>
  <style>
  /* ── ANTI-FOUC: Hide page immediately so Webflow default styles never show ── */
  #jj-search-root { opacity: 0 !important; }

  /* Force hide the native Webflow error state */
  .w-commerce-commerceaddtocarterrorstate { display: none !important; }

  /* Redesigned Search Layout with Bottom Input & Centered Hero */
  .div-block-1155 {
    background-color: #0b0b0b !important;
    padding-top: calc(10vh + 30px) !important;
    padding-left: 2rem !important;
    padding-right: 2rem !important;
    padding-bottom: 100px !important; /* Space for fixed bottom bar */
    min-height: 100vh;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
  }
  @media (min-width: 768px) {
    .div-block-1155 {
      padding-left: 5rem !important;
      padding-right: 5rem !important;
      padding-top: calc(10vh + 40px) !important;
    }
  }

  .search-hero-container {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 40px 0;
  }
  
  .div-block-1155.has-results .search-hero-container {
    display: none !important;
  }

  .search-landing-hero {
    text-align: center;
    animation: fadeIn 0.5s ease;
  }

  .search-hero-title {
    font-family: 'Aerosoldier basic', 'Inter', sans-serif !important;
    font-size: 3rem !important;
    font-weight: 700 !important;
    letter-spacing: 0.12em !important;
    color: #fff !important;
    margin: 0 0 12px 0 !important;
    text-transform: uppercase !important;
    text-shadow: 0 0 30px rgba(198, 0, 0, 0.35);
  }
  @media (max-width: 480px) {
    .search-hero-title {
      font-size: 2rem !important;
    }
  }

  .search-hero-subtitle {
    font-family: 'Inter', sans-serif !important;
    font-size: 11px !important;
    letter-spacing: 0.25em !important;
    color: #c60000 !important;
    margin: 0 !important;
    text-transform: uppercase !important;
    font-weight: 700 !important;
  }

  /* Fixed Bottom Search Bar Container */
  .search-bar-sticky-container {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    background: rgba(11, 11, 11, 0.96);
    backdrop-filter: blur(15px);
    -webkit-backdrop-filter: blur(15px);
    border-top: 1px solid #2e2e2e;
    padding: 16px 2rem;
    box-shadow: 0 -10px 30px rgba(0, 0, 0, 0.5);
    box-sizing: border-box;
  }
  @media (min-width: 768px) {
    .search-bar-sticky-container {
      padding: 18px 5rem;
    }
  }

  form.search {
    display: flex !important;
    flex-direction: row !important;
    width: 100% !important;
    max-width: 1200px !important;
    margin: 0 auto !important;
    gap: 12px !important;
    align-items: center !important;
  }

  .search-input-wrapper {
    position: relative;
    flex: 1;
    display: flex;
    align-items: center;
  }

  .search-icon-left {
    position: absolute;
    left: 16px;
    display: flex;
    align-items: center;
    pointer-events: none;
    z-index: 2;
  }

  .search-input {
    width: 100% !important;
    height: 50px !important;
    background: rgba(255, 255, 255, 0.04) !important;
    border: 1px solid rgba(255, 255, 255, 0.12) !important;
    border-radius: 6px !important;
    padding: 10px 16px 10px 44px !important; /* Left padding for search icon */
    color: #fff !important;
    font-family: 'Inter', sans-serif !important;
    font-size: 14px !important;
    letter-spacing: 0.03em !important;
    outline: none !important;
    box-sizing: border-box !important;
    transition: border-color 0.25s ease, box-shadow 0.25s ease !important;
  }
  .search-input:focus {
    border-color: #c60000 !important;
    box-shadow: 0 0 12px rgba(198, 0, 0, 0.25) !important;
    background: rgba(255, 255, 255, 0.06) !important;
  }

  .search-button {
    height: 50px !important;
    background: #ffffff !important;
    border: 1px solid #ffffff !important;
    border-radius: 6px !important;
    padding: 0 35px !important;
    color: #000000 !important;
    font-family: 'Inter', sans-serif !important;
    font-size: 13px !important;
    font-weight: 700 !important;
    text-transform: uppercase !important;
    letter-spacing: 0.08em !important;
    cursor: pointer !important;
    transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease !important;
    box-sizing: border-box !important;
  }
  .search-button:hover {
    background: #e6e6e6 !important;
    border-color: #e6e6e6 !important;
    color: #000000 !important;
  }

  /* Fixed squeezed column layout & stretch items to full width of columns */
  .search-result-list {
    display: grid !important;
    grid-template-columns: 1fr !important;
    gap: 20px !important;
    width: 100% !important;
    max-width: none !important;
    margin: 20px 0 !important;
    padding: 0 !important;
    box-sizing: border-box !important;
  }
  @media (min-width: 768px) {
    .search-result-list {
      grid-template-columns: repeat(2, 1fr) !important;
      gap: 24px !important;
    }
  }

  .search-result-item {
    display: flex;
    flex-direction: row;
    background: #0d0d0d;
    border: 1px solid #2e2e2e;
    border-radius: 8px;
    overflow: hidden;
    height: 180px;
    transition: border-color 0.2s ease, transform 0.2s ease;
    box-sizing: border-box;
    /* OVERRIDE WEBFLOW SQUEEZED COLUMN LIMIT */
    width: 100% !important;
    max-width: none !important;
  }
  .search-result-item:hover {
    border-color: #c60000;
  }
  .search-result-image-wrap {
    width: 150px;
    height: 100%;
    flex-shrink: 0;
    position: relative;
    background: #111;
    border-right: 1px solid #2e2e2e;
    overflow: hidden;
  }
  .search-result-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .search-result-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 16px;
    min-width: 0;
    justify-content: space-between;
    font-family: 'Inter', sans-serif;
  }
  .search-result-meta-top {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .search-result-vendor {
    font-size: 9px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgba(255,255,255,0.4);
  }
  .search-result-title {
    font-size: 14px;
    font-weight: 700;
    color: #fff;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin: 0;
  }
  .search-result-desc {
    font-size: 11px;
    color: rgba(255,255,255,0.5);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin: 4px 0 0 0;
    line-height: 1.4;
  }
  .search-result-price {
    font-size: 13px;
    font-weight: 700;
    color: #fff;
    margin-top: 6px;
  }
  .search-result-actions {
    display: flex;
    gap: 8px;
    margin-top: 12px;
    width: 100%;
  }
  .search-btn {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 34px;
    border-radius: 4px;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    cursor: pointer;
    text-decoration: none;
    transition: all 0.2s ease;
    box-sizing: border-box;
    font-family: 'Inter', sans-serif;
  }
  .search-btn-view {
    background: transparent;
    border: 1px solid #2e2e2e;
    color: #fff;
  }
  .search-btn-view:hover {
    background: rgba(255,255,255,0.05);
    border-color: #fff;
  }
  .search-btn-cart {
    background: #c60000;
    border: 1px solid #c60000;
    color: #fff;
  }
  .search-btn-cart:hover {
    background: #e60000;
    border-color: #e60000;
  }
  
  @media (max-width: 480px) {
    .search-result-item {
      height: 150px;
    }
    .search-result-image-wrap {
      width: 110px;
    }
    .search-result-info {
      padding: 10px;
    }
    .search-result-desc {
      display: none;
    }
    .search-result-actions {
      margin-top: 8px;
    }
    .search-btn {
      height: 28px;
      font-size: 9px;
    }
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(15px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>
  <script>
  // ── ANTI-FOUC REVEAL: run immediately after styles load ──────────
  (function() {
    var root = document.getElementById('jj-search-root');
    if (root) {
      // Small rAF to ensure our <style> block above has been applied to the cascade
      requestAnimationFrame(function() {
        root.style.opacity = '1';
      });
    }
  })();

  // --- 1. SCROLLBAR ENGINE ---
  function initCustomScroll() {
    const containers = document.querySelectorAll('.contents-of-scroll');
    containers.forEach(container => {
      let track = null; let bar = null; let parent = container.parentElement;
      for (let i = 0; i < 6; i++) {
        if (parent) {
          track = parent.querySelector('.track-for-scrolly');
          if (track) { bar = track.querySelector('.bar-of-scrolly') || parent.querySelector('.bar-of-scrolly'); break; }
          parent = parent.parentElement;
        }
      }
      if (track && bar) {
        let isDragging = false; let startX, startLeft;
        const updateBar = () => {
          if (isDragging) return; 
          const scrollLeft = container.scrollLeft;
          const maxScroll = container.scrollWidth - container.clientWidth;
          if (maxScroll <= 0) return;
          const scrollPercent = scrollLeft / maxScroll;
          const maxMove = track.clientWidth - bar.clientWidth;
          bar.style.transform = `translateX(${scrollPercent * maxMove}px)`;
        };
        const onMouseDown = (e) => {
          isDragging = true; startX = e.pageX;
          const matrix = new DOMMatrix(window.getComputedStyle(bar).getPropertyValue('transform'));
          startLeft = matrix.m41; 
          document.body.style.userSelect = 'none'; bar.style.cursor = 'grabbing';
          document.addEventListener('mousemove', onMouseMove);
          document.addEventListener('mouseup', onMouseUp);
        };
        const onMouseMove = (e) => {
          if (!isDragging) return;
          const maxMove = track.clientWidth - bar.clientWidth;
          let newLeft = startLeft + (e.pageX - startX);
          if (newLeft < 0) newLeft = 0; if (newLeft > maxMove) newLeft = maxMove;
          bar.style.transform = `translateX(${newLeft}px)`;
          container.scrollLeft = (newLeft / maxMove) * (container.scrollWidth - container.clientWidth);
        };
        const onMouseUp = () => {
          isDragging = false; document.body.style.userSelect = ''; bar.style.cursor = 'pointer';
          document.removeEventListener('mousemove', onMouseMove);
          document.removeEventListener('mouseup', onMouseUp);
        };
        container.addEventListener('scroll', updateBar);
        window.addEventListener('resize', updateBar);
        bar.addEventListener('mousedown', onMouseDown);
        setTimeout(updateBar, 100);
      }
    });
  }
  // --- 2. GALLERY CLICK WATCHER ---
  function initGallery() {
    document.addEventListener('click', function(e) {
      const thumbWrapper = e.target.closest('.thumb-image');
      if (!thumbWrapper) return; 
      const thumbImg = thumbWrapper.tagName === 'IMG' ? thumbWrapper : thumbWrapper.querySelector('img');
      if (!thumbImg) return;
      const mainImg = document.getElementById('main-image');
      if (!mainImg) return;
      const oldMainSrc = mainImg.src; const oldMainSrcSet = mainImg.srcset;
      mainImg.src = thumbImg.src; mainImg.srcset = thumbImg.srcset;
      thumbImg.src = oldMainSrc; thumbImg.srcset = oldMainSrcSet;
    }, true);
  }
  // --- 3. CURSOR LOGIC ---
  function initCursor() {
    var tricksCursor = document.querySelector('.cursor');
    if (tricksCursor) {
      if (window.cursorFunc) window.removeEventListener('mousemove', window.cursorFunc);
      window.cursorFunc = function(e) {
        tricksCursor.style.top = e.clientY + 'px';
        tricksCursor.style.left = e.clientX + 'px';
      };
      window.addEventListener('mousemove', window.cursorFunc);
    }
    if (typeof $ !== 'undefined') {
      $("a, .nav_link, .project-block, .logo").off("mouseenter mouseleave").hover(
        function() { $('.cursor').addClass('cursor-hover'); },
        function() { $('.cursor').removeClass('cursor-hover'); }
      );
      $("body").off("mousedown mouseup").hover(function(){}, function(){});
      $("body").mousedown(function() { $('.cursor').addClass('cursor-pressed'); });
      $("body").mouseup(function() { $('.cursor').removeClass('cursor-pressed'); });
    }
  }
  // --- 4. TABS LOGIC ---
  function initTabs() {
    if (typeof FsLibrary !== 'undefined' && document.querySelector('.fs-dynamic-feed')) {
      try {
        new FsLibrary('.fs-dynamic-feed').tabs({
          tabComponent: '.fs-tabs', tabContent: '.fs-tab-content',
          tabbackground: '.fs-background', tabName: '.fs-tab-name'
        });
      } catch(e) {}
    }
  }
  // --- 5. ERROR WATCHER ---
  function initErrorWatcher() {
    const observer = new MutationObserver((mutations) => {
      mutations.forEach((m) => {
        if (m.target.classList.contains('w-commerce-commerceaddtocarterrorstate') && m.target.style.display !== 'none') {
          m.target.style.display = 'none';
        }
      });
    });
    document.querySelectorAll('.w-commerce-commerceaddtocarterrorstate').forEach(el => {
      observer.observe(el, { attributes: true, attributeFilter: ['style'] });
    });
  }

  // --- 6. WEBFLOW RELOAD (Fixes Accordions & UI) ---
  function forceWebflowReload() {
    if (window.Webflow) {
      window.Webflow.destroy();
      window.Webflow.ready();
      if (window.Webflow.require('ix2')) window.Webflow.require('ix2').init();
    }
    // Fallback script reload
    const scripts = document.querySelectorAll('script');
    let webflowSrc = null;
    scripts.forEach(s => { if (s.src && s.src.includes('webflow')) { webflowSrc = s.src; s.remove(); } });
    if (webflowSrc) {
      const ns = document.createElement('script');
      ns.src = webflowSrc; ns.type = 'text/javascript'; ns.async = false;
      document.body.appendChild(ns);
    }
  }

  // --- 7. LIVE SEARCH PAGE CACHE ENGINE ---
  var searchCache = null;
  var searchCacheLoading = false;
  var searchCacheLoaded = false;

  function loadSearchCache(callback) {
    if (searchCacheLoaded) {
      if (callback) callback();
      return;
    }
    if (searchCacheLoading) {
      var interval = setInterval(function() {
        if (searchCacheLoaded) {
          clearInterval(interval);
          if (callback) callback();
        }
      }, 50);
      return;
    }
    searchCacheLoading = true;

    var url = '/search?view=ajax-row&type=product&options[prefix]=last&options[unavailable_products]=show&q=*';
    fetch(url)
      .then(function(res) { return res.text(); })
      .then(function(html) {
        var temp = document.createElement('div');
        temp.innerHTML = html.trim();
        var items = temp.querySelectorAll('.search-result-item');
        var parsed = [];
        items.forEach(function(item) {
          parsed.push({
            element: item,
            text: (item.textContent || '').toLowerCase(),
            meta: (item.querySelector('.jj-search-meta')?.textContent || '').toLowerCase()
          });
        });
        searchCache = parsed;
        searchCacheLoaded = true;
        searchCacheLoading = false;
        if (callback) callback();
      })
      .catch(function(err) {
        console.error('Error preloading search results:', err);
        searchCacheLoading = false;
      });
  }

  function performLiveSearch(query) {
    const grid = document.querySelector('.search-result-list');
    const pagination = document.querySelector('.jj-pagination-container') || document.querySelector('.w-pagination-wrapper');
    const originalGridHTML = window.jjOriginalGridHTML || '';
    const container = document.querySelector('.div-block-1155');

    if (!grid) return;

    loadSearchCache(function() {
      var q = query.trim().toLowerCase();
      if (q.length === 0) {
        grid.innerHTML = originalGridHTML;
        if (pagination) pagination.style.display = '';
        if (container) container.classList.remove('has-results');
        return;
      }

      if (container) container.classList.add('has-results');
      if (pagination) pagination.style.display = 'none';

      var queryWords = q.split(/\s+/).filter(function(w) { return w.length > 0; });

      var matches = searchCache.filter(function(prod) {
        return queryWords.every(function(word) {
          var normalizedWord = word;
          if (word === 'small') normalizedWord = 's';
          else if (word === 'medium') normalizedWord = 'm';
          else if (word === 'large') normalizedWord = 'l';
          else if (word === 'x-large' || word === 'xlarge') normalizedWord = 'xl';
          else if (word === 'xx-large' || word === 'xxlarge') normalizedWord = 'xxl';
          else if (word === 'xxx-large' || word === 'xxxlarge') normalizedWord = '3xl';

          // 1. Substring text match
          if (prod.text.indexOf(word) !== -1 || prod.meta.indexOf(word) !== -1) {
            return true;
          }

          // 2. Size match checking bounding pipe chars
          if (prod.meta.indexOf('|' + normalizedWord + '|') !== -1 || 
              prod.meta.endsWith('|' + normalizedWord)) {
            return true;
          }

          // 3. Typo/spacing boundary checking (e.g. 'rough play' -> 'roughplay')
          var cleanMeta = prod.meta.replace(/[\s\-_]/g, '');
          var cleanWord = normalizedWord.replace(/[\s\-_]/g, '');
          if (cleanMeta.indexOf(cleanWord) !== -1) {
            return true;
          }

          return false;
        });
      });

      if (matches.length > 0) {
        grid.innerHTML = '';
        matches.forEach(function(match) {
          grid.appendChild(match.element.cloneNode(true));
        });
        var endOfResults = document.createElement('div');
        endOfResults.className = 'search-end-of-results';
        endOfResults.style.cssText = 'width: 100%; text-align: center; padding: 40px 0; color: rgba(255,255,255,0.3); font-family: "Inter", sans-serif; font-size: 11px; letter-spacing: 0.15em; text-transform: uppercase; grid-column: 1 / -1;';
        endOfResults.textContent = '— END OF RESULTS —';
        grid.appendChild(endOfResults);
      } else {
        grid.innerHTML = '<div style="width:100%; text-align:center; padding: 40px; color:rgba(255,255,255,0.4); font-family:Inter,sans-serif; font-size:12px; letter-spacing:0.1em; text-transform:uppercase; grid-column: 1/-1;">No products found matching your search.</div>';
      }
    });
  }

  function initLiveSearchPage() {
    initErrorWatcher();
    
    // Intercept search result Add to Cart form submissions and handle via AJAX
    document.addEventListener('submit', function(e) {
      var form = e.target.closest('form[action="/cart/add"]');
      if (!form) return;

      e.preventDefault();
      e.stopPropagation();

      var submitBtn = form.querySelector('button[type="submit"]');
      var originalText = submitBtn ? submitBtn.textContent : 'Add to Cart';
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Adding...';
      }

      var formData = new FormData(form);
      fetch('/cart/add.js', {
        method: 'POST',
        body: formData,
        headers: {
          'Accept': 'application/json'
        }
      })
      .then(function(res) {
        if (!res.ok) throw new Error('Add to cart failed');
        return res.json();
      })
      .then(function(data) {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = originalText;
        }
        if (typeof window.Udesly !== 'undefined') {
          window.Udesly.dispatch('product-added', true);
        } else {
          window.location.href = '/cart';
        }
      })
      .catch(function(err) {
        console.error('Error adding to cart:', err);
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Error';
          setTimeout(function() { submitBtn.textContent = originalText; }, 2000);
        }
      });
    });

    const grid = document.querySelector('.search-result-list');
    if (grid && !window.jjOriginalGridHTML) {
      window.jjOriginalGridHTML = grid.innerHTML;
    }
    const searchInput = document.getElementById('search');
    var searchTimeout = null;
    if (searchInput) {
      searchInput.addEventListener('input', function(e) {
        var val = e.target.value;
        if (searchTimeout) clearTimeout(searchTimeout);
        searchTimeout = setTimeout(function() {
          performLiveSearch(val);
        }, 50);
      });

      var searchForm = searchInput.closest('form');
      if (searchForm) {
        searchForm.addEventListener('submit', function(e) {
          e.preventDefault();
          performLiveSearch(searchInput.value);
        });
      }

      // If page was loaded with a query in the URL, run search live!
      var params = new URLSearchParams(window.location.search);
      var qParam = params.get('q');
      if (qParam) {
        searchInput.value = qParam;
        setTimeout(function() {
          performLiveSearch(qParam);
        }, 150);
      }
    }

    // Preload search catalog cache
    setTimeout(function() {
      loadSearchCache();
    }, 200);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initLiveSearchPage);
  } else {
    initLiveSearchPage();
  }
</script>

