{% layout none %}
{% paginate search.results by 250 %}
  {%- if search.performed and search.results_count > 0 -%}
    {%- for item in search.results -%}
      {%- if item.object_type == 'product' -%}
        {%- if item.handle == 'shipping-insurance' or item.title contains 'Insurance' -%}{%- continue -%}{%- endif -%}
        <div role="listitem" class="collection-item-2 margin w-dyn-item" data-id="{{ item.id }}" data-created="{{ item.created_at | date: '%s' }}" data-vendor="{{ item.vendor | escape }}">
          <a href="{{ item.url }}" class="link-block-2 w-inline-block">
            {%- assign _is_sold_out = true -%}
            {%- assign _avail_count = 0 -%}
            {%- capture _sizes_rendered -%}
              {%- for _sv in item.variants -%}
                {%- if _sv.inventory_quantity > 0 or _sv.inventory_policy == 'continue' -%}
                  {%- assign _is_sold_out = false -%}
                  {%- assign _avail_count = _avail_count | plus: 1 -%}
                  {%- assign _sl = _sv.title | strip -%}
                  {%- assign _sl_down = _sl | downcase -%}
                  {%- if _sl_down contains 'xxxl' or _sl_down contains '3xl' -%}{%- assign _sl = '3XL' -%}
                  {%- elsif _sl_down contains 'xxl' or _sl_down contains '2xl' or _sl_down contains 'xx-large' or _sl_down contains 'xx large' or _sl_down == 'xxlarge' -%}{%- assign _sl = 'XXL' -%}
                  {%- elsif _sl_down contains 'xl' or _sl_down contains 'x-large' or _sl_down contains 'x large' or _sl_down contains 'xlarge' -%}{%- assign _sl = 'XL' -%}
                  {%- elsif _sl_down contains 'small' or _sl_down == 's' -%}{%- assign _sl = 'S' -%}
                  {%- elsif _sl_down contains 'medium' or _sl_down == 'm' -%}{%- assign _sl = 'M' -%}
                  {%- elsif _sl_down contains 'large' or _sl_down == 'l' -%}{%- assign _sl = 'L' -%}
                  {%- elsif _sl_down contains 'one size' or _sl_down contains 'onesize' or _sl_down contains 'osfm' or _sl_down contains 'os' -%}{%- assign _sl = 'O/S' -%}
                  {%- endif -%}
                  <div class="text-block-4 asd sizes-variants">{{ _sl }}</div>
                {%- endif -%}
              {%- endfor -%}
            {%- endcapture -%}
            <div class="div-block-15 {% unless item.available %}jj-sold-out-card{% endunless %}">
              <img loading="lazy" src="{{ item.featured_image | img_url: '600x' }}" alt="{{ item.featured_image.alt | default: item.title }}" class="image-6" data-commerce-type="variation-image" srcset="{{ item.featured_image | img_url: '600x' }} 600w, {{ item.featured_image | img_url: '1024x' }} 1024w">
              {%- if _is_sold_out -%}
                <div class="sold-out-label">
                  <div class="div-block-1167">
                    <div class="text-block-793">Sold Out</div>
                  </div>
                </div>
              {%- endif -%}
              {%- unless item.available -%}<div class="jj-sold-out-badge">SOLD OUT</div>{%- endunless -%}
            </div>
            <div class="text-block-4 title hsf">{{ item.vendor }}</div>
            <div class="text-block-4 title dfg">{{ item.title }}</div>
            <div data-commerce-type="variation-price" class="text-block-779">{{ item.price | money }}</div>
            <div class="div-block-1163">
              <div class="text-block-4 asd">Sizes :</div>
              <div class="size-contents">
                {%- if _avail_count > 3 -%}
                  <div class="text-block-4 asd sizes-variants">Multiple Sizes</div>
                {%- else -%}
                  {{ _sizes_rendered }}
                {%- endif -%}
              </div>
            </div>
            {%- capture _jj_meta -%}{{ item.vendor }}|{{ item.product_type }}|{{ item.tags | join: "|" }}|{{ item.price | money_without_trailing_zeros }}|{{ item.price_min | money_without_trailing_zeros }}|{{ item.price_max | money_without_trailing_zeros }}{%- for _v in item.variants -%}|{{ _v.title }}{%- endfor -%}{%- for _opt in item.options_with_values -%}{%- for _val in _opt.values -%}|{{ _val }}{%- endfor -%}{%- endfor -%}{%- endcapture -%}<span class="jj-search-meta" aria-hidden="true" style="display:none;position:absolute;width:1px;height:1px;overflow:hidden;">{{ _jj_meta }}</span>
          </a>
        </div>
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}
{% endpaginate %}
