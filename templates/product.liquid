  <script>
  // --- 1. SCROLLBAR ENGINE ---
  function initCustomScroll() {
    const containers = document.querySelectorAll('.contents-of-scroll');
    containers.forEach(container => {
      let track = null; let bar = null; let parent = container.parentElement;
      for (let i = 0; i < 6; i++) {
        if (parent) {
          track = parent.querySelector('.track-for-scrolly');
          if (track) { bar = track.querySelector('.bar-of-scrolly') || parent.querySelector('.bar-of-scrolly'); break; }
          parent = parent.parentElement;
        }
      }
      if (track && bar) {
        let isDragging = false; let startX, startLeft;
        const updateBar = () => {
          if (isDragging) return; 
          const scrollLeft = container.scrollLeft;
          const maxScroll = container.scrollWidth - container.clientWidth;
          if (maxScroll <= 0) return;
          const scrollPercent = scrollLeft / maxScroll;
          const maxMove = track.clientWidth - bar.clientWidth;
          bar.style.transform = `translateX(${scrollPercent * maxMove}px)`;
        };
        const onMouseDown = (e) => {
          isDragging = true; startX = e.pageX;
          const matrix = new DOMMatrix(window.getComputedStyle(bar).getPropertyValue('transform'));
          startLeft = matrix.m41; 
          document.body.style.userSelect = 'none'; bar.style.cursor = 'grabbing';
          document.addEventListener('mousemove', onMouseMove);
          document.addEventListener('mouseup', onMouseUp);
        };
        const onMouseMove = (e) => {
          if (!isDragging) return;
          const maxMove = track.clientWidth - bar.clientWidth;
          let newLeft = startLeft + (e.pageX - startX);
          if (newLeft < 0) newLeft = 0; if (newLeft > maxMove) newLeft = maxMove;
          bar.style.transform = `translateX(${newLeft}px)`;
          container.scrollLeft = (newLeft / maxMove) * (container.scrollWidth - container.clientWidth);
        };
        const onMouseUp = () => {
          isDragging = false; document.body.style.userSelect = ''; bar.style.cursor = 'pointer';
          document.removeEventListener('mousemove', onMouseMove);
          document.removeEventListener('mouseup', onMouseUp);
        };
        container.addEventListener('scroll', updateBar);
        window.addEventListener('resize', updateBar);
        bar.addEventListener('mousedown', onMouseDown);
        setTimeout(updateBar, 100);
      }
    });
  }
</script>
<script>
  // ── PRODUCT PAGE: GALLERY ENGINE v2 (LIGHTBOX + DOTS + SWIPE) ────
  (function() {
    // Collect all product images into a flat ordered array
    function getAllImages() {
      var imgs = [];
      var thumbs = document.querySelectorAll('.jj-thumb');
      if (thumbs.length > 0) {
        thumbs.forEach(function(t) {
          var src = t.getAttribute('data-full') || t.src;
          if (src) {
            var norm = src.replace(/_(\d+x|\d+x\d+)(\.[a-z]+)$/i, '_1920x$2');
            if (!imgs.includes(norm)) imgs.push(norm);
          }
        });
      }
      if (!imgs.length) {
        var mobileSlides = document.querySelectorAll('.jj-mobile-slide');
        if (mobileSlides.length > 0) {
          mobileSlides.forEach(function(s) {
            var src = s.getAttribute('data-full') || s.src;
            if (src) {
              var norm = src.replace(/_(\d+x|\d+x\d+)(\.[a-z]+)$/i, '_1920x$2');
              if (!imgs.includes(norm)) imgs.push(norm);
            }
          });
        }
      }
      if (!imgs.length) {
        var focal = document.getElementById('jj-focal-img');
        if (focal && focal.src) {
          imgs.push(focal.src.replace(/_(\d+x|\d+x\d+)(\.[a-z]+)$/i, '_1920x$2'));
        }
      }
      return imgs;
    }

    // ── LIGHTBOX ENGINE ────────────────────────────────────────────
    var lb = document.getElementById('jj-lightbox');
    var lbImg = document.getElementById('jj-lb-img');
    var lbClose = document.getElementById('jj-lb-close');
    var lbPrev = document.getElementById('jj-lb-prev');
    var lbNext = document.getElementById('jj-lb-next');
    var lbCounter = document.getElementById('jj-lb-counter');
    var lbImages = [];
    var lbIndex = 0;
    var lbZoomed = false;
    var lbScale = 1;
    var lbTouchStartX = 0;

    function openLightbox(clickedSrc) {
      lbImages = getAllImages();
      if (!lbImages.length) return;
      var norm = clickedSrc ? clickedSrc.replace(/_(\d+x|\d+x\d+)(\.[a-z]+)$/i, '_1920x$2') : '';
      lbIndex = lbImages.indexOf(norm);
      if (lbIndex < 0) lbIndex = 0;
      showLbImage();
      if (lb) lb.classList.add('open');
      document.body.style.overflow = 'hidden';
      var hasMultiple = lbImages.length > 1;
      if (lbPrev) lbPrev.style.display = hasMultiple ? '' : 'none';
      if (lbNext) lbNext.style.display = hasMultiple ? '' : 'none';
      populateLbThumbs();
      triggerImmediateZoom();
    }

    function closeLightbox() {
      if (lb) lb.classList.remove('open');
      document.body.style.overflow = '';
      resetZoom();
    }

    function showLbImage() {
      if (!lbImages.length || !lbImg) return;
      lbImg.src = lbImages[lbIndex];
      if (lbCounter) lbCounter.textContent = lbImages.length > 1 ? (lbIndex + 1) + ' / ' + lbImages.length : '';
      
      document.querySelectorAll('.jj-lb-thumb').forEach(function(thumb, idx) {
        thumb.classList.toggle('jj-lb-thumb-active', idx === lbIndex);
      });

      resetZoom();
      if (lb && lb.classList.contains('open')) {
        triggerImmediateZoom();
      }
    }

    function triggerImmediateZoom() {
      lbZoomed = true;
      lbScale = 1.8;
      if (lbImg) {
        lbImg.classList.add('zoomed');
        lbImg.style.cursor = 'zoom-out';
        lbTranslateX = 0;
        lbTranslateY = 0;
        lbImg.style.transform = 'scale(' + lbScale + ') translate(0,0)';
        lbImg.style.transition = 'transform 0.25s ease';
      }
    }

    function resetZoom() {
      lbZoomed = false;
      lbScale = 1.0;
      if (lbImg) {
        lbImg.style.transform = 'scale(1) translate(0,0)';
        lbImg.classList.remove('zoomed');
        lbImg.style.cursor = 'zoom-in';
      }
    }

    function populateLbThumbs() {
      var thumbsContainer = document.getElementById('jj-lb-thumbs');
      if (!thumbsContainer) return;
      thumbsContainer.innerHTML = '';
      if (lbImages.length < 2) {
        thumbsContainer.style.display = 'none';
        return;
      }
      thumbsContainer.style.display = 'flex';
      lbImages.forEach(function(src, idx) {
        var img = document.createElement('img');
        img.src = src.replace('_1920x', '_150x');
        img.className = 'jj-lb-thumb' + (idx === lbIndex ? ' jj-lb-thumb-active' : '');
        img.addEventListener('click', function(e) {
          e.stopPropagation();
          lbIndex = idx;
          showLbImage();
        });
        thumbsContainer.appendChild(img);
      });
    }

    // ── DESKTOP GALLERY THUMBNAIL CLICK & FOCAL SWAP ────────────────
    document.addEventListener('click', function(e) {
      var target = e.target;
      if (!target) return;

      // 1. Desktop thumbnail click -> snap to focal image
      var thumb = target.closest('.jj-thumb');
      if (thumb) {
        e.preventDefault();
        var fullSrc = thumb.getAttribute('data-full') || thumb.src;
        var focalImg = document.getElementById('jj-focal-img');
        if (focalImg) {
          focalImg.src = fullSrc;
          focalImg.setAttribute('data-index', thumb.getAttribute('data-index') || '0');
        }
        document.querySelectorAll('.jj-thumb').forEach(function(t) {
          t.classList.remove('jj-thumb-active');
        });
        thumb.classList.add('jj-thumb-active');
        return;
      }

      // 2. Focal image click -> open lightbox
      var focal = target.closest('#jj-focal-img, .jj-focal-image');
      if (focal) {
        e.preventDefault();
        openLightbox(focal.src);
        return;
      }

      // 3. Mobile slide click -> open lightbox
      var mobileSlide = target.closest('.jj-mobile-slide');
      if (mobileSlide) {
        e.preventDefault();
        openLightbox(mobileSlide.src);
        return;
      }
    });

    // Close on backdrop or empty wrap click
    if (lb) lb.addEventListener('click', function(e) {
      if (e.target === lb || e.target.id === 'jj-lb-img-wrap') closeLightbox();
    });
    if (lbClose) lbClose.addEventListener('click', closeLightbox);

    // Arrow nav
    if (lbPrev) lbPrev.addEventListener('click', function(e) {
      e.stopPropagation();
      lbIndex = (lbIndex - 1 + lbImages.length) % lbImages.length;
      showLbImage();
    });
    if (lbNext) lbNext.addEventListener('click', function(e) {
      e.stopPropagation();
      lbIndex = (lbIndex + 1) % lbImages.length;
      showLbImage();
    });

    // Keyboard navigation
    document.addEventListener('keydown', function(e) {
      if (!lb || !lb.classList.contains('open')) return;
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowLeft') { lbIndex = (lbIndex - 1 + lbImages.length) % lbImages.length; showLbImage(); }
      if (e.key === 'ArrowRight') { lbIndex = (lbIndex + 1) % lbImages.length; showLbImage(); }
    });

    // Touch swipe inside lightbox
    if (lb) {
      lb.addEventListener('touchstart', function(e) { 
        if (!lbZoomed) lbTouchStartX = e.touches[0].clientX; 
      }, {passive: true});
      lb.addEventListener('touchend', function(e) {
        if (lbZoomed) return;
        var dx = e.changedTouches[0].clientX - lbTouchStartX;
        if (Math.abs(dx) > 50 && lbImages.length > 1) {
          if (dx < 0) { lbIndex = (lbIndex + 1) % lbImages.length; }
          else { lbIndex = (lbIndex - 1 + lbImages.length) % lbImages.length; }
          showLbImage();
        }
      }, {passive: true});
    }

    // Toggle zoom on image click in lightbox
    var lbTranslateX = 0, lbTranslateY = 0;
    var wrap = document.getElementById('jj-lb-img-wrap');
    if (lbImg && wrap) {
      lbImg.addEventListener('click', function(e) {
        e.stopPropagation();
        if (!lbZoomed) {
          triggerImmediateZoom();
        } else {
          resetZoom();
        }
      });

      wrap.addEventListener('mousemove', function(e) {
        if (!lbZoomed) return;
        var rect = wrap.getBoundingClientRect();
        var cx = (e.clientX - rect.left) / rect.width - 0.5;
        var cy = (e.clientY - rect.top) / rect.height - 0.5;
        lbTranslateX = -cx * rect.width * (lbScale - 1) * 0.45;
        lbTranslateY = -cy * rect.height * (lbScale - 1) * 0.45;
        lbImg.style.transform = 'scale(' + lbScale + ') translate(' + lbTranslateX + 'px,' + lbTranslateY + 'px)';
        lbImg.style.transition = 'none';
      });
    }

    // ── MOBILE SWIPE CAROUSEL & DOT INDICATORS ────────────────────
    function initDots() {
      var dotsContainer = document.getElementById('jj-swipe-dots');
      var swipeTrack = document.getElementById('jj-mobile-swipe');
      if (!dotsContainer || !swipeTrack) return;

      var slides = swipeTrack.querySelectorAll('.jj-mobile-slide');
      if (slides.length <= 1) {
        dotsContainer.style.display = 'none';
