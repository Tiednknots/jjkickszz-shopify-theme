  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/@finsweet/cms-library@1/cms-library.js"></script>
  <style>
  /* Force hide the native Webflow error state */
  .w-commerce-commerceaddtocarterrorstate { display: none !important; }

  /* ── PRODUCT PAGE 2-COLUMN GRID — DESKTOP ─────────────────────── */
  @media screen and (min-width: 992px) {
    .div-block-629 {
      display: grid !important;
      grid-template-columns: 1fr 1fr !important;
      gap: 3rem !important;
      align-items: start !important;
      padding: 2rem 3rem 4rem !important;
      box-sizing: border-box !important;
      max-width: 100% !important;
    }

    /* LEFT: Sticky gallery column — sticks until right column scrolls past */
    .thumbnail-section {
      position: sticky !important;
      top: 124px !important; /* 80px navbar + 40px marquee + 4px buffer */
      align-self: flex-start !important;
      width: 90% !important;
      margin: 0 auto !important;
      overflow: visible !important;
      max-height: none !important;
    }

    /* RIGHT: Normal scroll — no sticky */
    .product-container {
      position: relative !important;
      top: auto !important;
      max-height: none !important;
      overflow: visible !important;
      width: 90% !important;
      margin: 0 auto !important;
      padding-top: 1rem !important;
      padding-left: 2rem !important;
      border-left: 1px solid #252525 !important;
    }

    /* Desktop gallery: HIDE mobile swipe, SHOW desktop layout */
    .jj-gallery-mobile { display: none !important; }
    .jj-gallery-desktop { display: flex !important; }

    /* ── DESKTOP: Thumbnail strip left of focal image ── */
    .jj-gallery-desktop {
      flex-direction: row !important;
      align-items: flex-start !important;
      gap: 12px !important;
      width: 100% !important;
    }

    /* Single-image: no strip needed */
    .jj-gallery-single {
      flex-direction: column !important;
    }
    .jj-gallery-single .jj-thumb-strip { display: none !important; }

    /* Thumbnail strip: vertical column on the left */
    .jj-thumb-strip {
      display: flex !important;
      flex-direction: column !important;
      gap: 8px !important;
      width: 72px !important;
      min-width: 72px !important;
      flex-shrink: 0 !important;
      max-height: calc(100vh - 148px) !important;
      overflow-y: auto !important;
      scrollbar-width: none !important;
    }
    .jj-thumb-strip::-webkit-scrollbar { display: none !important; }

    /* Individual thumbnail */
    .jj-thumb {
      width: 72px !important;
      height: 72px !important;
      object-fit: cover !important;
      border-radius: 6px !important;
      border: 2px solid transparent !important;
      opacity: 0.55 !important;
      cursor: pointer !important;
      flex-shrink: 0 !important;
      transition: opacity 0.2s ease, border-color 0.2s ease !important;
      background: #111 !important;
    }
    .jj-thumb:hover { opacity: 0.85 !important; }
    .jj-thumb.jj-thumb-active {
      opacity: 1 !important;
      border-color: #ffffff !important;
    }

    /* Focal image: fills remaining column width */
    .jj-focal-wrap {
      flex: 1 !important;
      min-width: 0 !important;
    }
    .jj-focal-image {
      width: 100% !important;
      aspect-ratio: 1 / 1 !important;
      object-fit: cover !important;
      border-radius: 12px !important;
      cursor: zoom-in !important;
      display: block !important;
      background: #0d0d0d !important;
    }
  }

  /* ── TABLET & MOBILE (≤991px) — Swipe gallery ─────────────────── */
  @media (max-width: 991px) {
    .div-block-629 {
      display: flex !important;
      flex-direction: column !important;
      padding: 0 !important;
      gap: 0 !important;
    }

    .thumbnail-section {
      position: static !important;
      max-height: none !important;
      overflow: visible !important;
      width: 100% !important;
      margin: 0 !important;
    }

    /* Mobile: HIDE desktop layout, SHOW swipe carousel */
    .jj-gallery-desktop { display: none !important; }
    .jj-gallery-mobile {
      display: block !important;
      width: 100% !important;
    }

    /* 65vh mobile swipe track */
    .jj-mobile-swipe {
      display: flex !important;
      flex-direction: row !important;
      overflow-x: auto !important;
      overflow-y: hidden !important;
      scroll-snap-type: x mandatory !important;
      scrollbar-width: none !important;
      -ms-overflow-style: none !important;
      width: 100% !important;
      height: 65vh !important;
      min-height: 280px !important;
    }
    .jj-mobile-swipe::-webkit-scrollbar { display: none !important; }

    .jj-mobile-slide {
      flex-shrink: 0 !important;
      width: 100vw !important;
      height: 65vh !important;
      min-height: 280px !important;
      object-fit: cover !important;
      scroll-snap-align: center !important;
      display: block !important;
    }

    /* Dot indicators spacing */
    .jj-swipe-dots {
      display: flex !important;
      justify-content: center !important;
      align-items: center !important;
      gap: 6px !important;
      padding: 12px 0 16px !important;
    }

    /* Product details */
    .product-container {
      position: static !important;
      max-height: none !important;
