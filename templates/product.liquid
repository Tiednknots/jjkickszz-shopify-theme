  <script>
  // --- 1. SCROLLBAR ENGINE ---
  function initCustomScroll() {
    const containers = document.querySelectorAll('.contents-of-scroll');
    containers.forEach(container => {
      let track = null; let bar = null; let parent = container.parentElement;
      for (let i = 0; i < 6; i++) {
        if (parent) {
          track = parent.querySelector('.track-for-scrolly');
          if (track) { bar = track.querySelector('.bar-of-scrolly') || parent.querySelector('.bar-of-scrolly'); break; }
          parent = parent.parentElement;
        }
      }
      if (track && bar) {
        let isDragging = false; let startX, startLeft;
        const updateBar = () => {
          if (isDragging) return; 
          const scrollLeft = container.scrollLeft;
          const maxScroll = container.scrollWidth - container.clientWidth;
          if (maxScroll <= 0) return;
          const scrollPercent = scrollLeft / maxScroll;
          const maxMove = track.clientWidth - bar.clientWidth;
          bar.style.transform = `translateX(${scrollPercent * maxMove}px)`;
        };
        const onMouseDown = (e) => {
          isDragging = true; startX = e.pageX;
          const matrix = new DOMMatrix(window.getComputedStyle(bar).getPropertyValue('transform'));
          startLeft = matrix.m41; 
          document.body.style.userSelect = 'none'; bar.style.cursor = 'grabbing';
          document.addEventListener('mousemove', onMouseMove);
          document.addEventListener('mouseup', onMouseUp);
        };
        const onMouseMove = (e) => {
          if (!isDragging) return;
          const maxMove = track.clientWidth - bar.clientWidth;
          let newLeft = startLeft + (e.pageX - startX);
          if (newLeft < 0) newLeft = 0; if (newLeft > maxMove) newLeft = maxMove;
          bar.style.transform = `translateX(${newLeft}px)`;
          container.scrollLeft = (newLeft / maxMove) * (container.scrollWidth - container.clientWidth);
        };
        const onMouseUp = () => {
          isDragging = false; document.body.style.userSelect = ''; bar.style.cursor = 'pointer';
          document.removeEventListener('mousemove', onMouseMove);
          document.removeEventListener('mouseup', onMouseUp);
        };
        container.addEventListener('scroll', updateBar);
        window.addEventListener('resize', updateBar);
        bar.addEventListener('mousedown', onMouseDown);
        setTimeout(updateBar, 100);
      }
    });
  }
</script>
<script>
  // ── PRODUCT PAGE: GALLERY ENGINE v2 (LIGHTBOX + DOTS + SWIPE) ────
  (function() {
    // Collect all product images into a flat ordered array
    function getAllImages() {
      var imgs = [];
      var mainImg = document.getElementById('main-image');
      if (mainImg) imgs.push(mainImg.src.replace(/_(\d+x|\d+x\d+)(\.[a-z]+)$/i, '_1920x$2'));
      document.querySelectorAll('.thumb-image').forEach(function(img) {
        var src = img.src.replace(/_(\d+x|\d+x\d+)(\.[a-z]+)$/i, '_1920x$2');
        if (src && !imgs.includes(src)) imgs.push(src);
      });
      return imgs;
    }

    // ── LIGHTBOX ENGINE ────────────────────────────────────────────
    var lb = document.getElementById('jj-lightbox');
    var lbImg = document.getElementById('jj-lb-img');
    var lbClose = document.getElementById('jj-lb-close');
    var lbPrev = document.getElementById('jj-lb-prev');
    var lbNext = document.getElementById('jj-lb-next');
    var lbCounter = document.getElementById('jj-lb-counter');
    var lbImages = [];
    var lbIndex = 0;
    var lbZoomed = false;
    var lbScale = 1;
    var lbTouchStartX = 0;

    function openLightbox(clickedSrc) {
      lbImages = getAllImages();
      // Find the index of the clicked image
      var norm = clickedSrc.replace(/_(\d+x|\d+x\d+)(\.[a-z]+)$/i, '_1920x$2');
      lbIndex = lbImages.indexOf(norm);
      if (lbIndex < 0) lbIndex = 0;
      showLbImage();
      lb.classList.add('open');
      document.body.style.overflow = 'hidden';
      // Show/hide arrows based on image count
      var hasMultiple = lbImages.length > 1;
      if (lbPrev) lbPrev.style.display = hasMultiple ? '' : 'none';
      if (lbNext) lbNext.style.display = hasMultiple ? '' : 'none';
    }

    function closeLightbox() {
      lb.classList.remove('open');
      document.body.style.overflow = '';
      resetZoom();
    }

    function showLbImage() {
      if (!lbImages.length) return;
      lbImg.src = lbImages[lbIndex];
      if (lbCounter) lbCounter.textContent = lbImages.length > 1 ? (lbIndex + 1) + ' / ' + lbImages.length : '';
      resetZoom();
    }

    function resetZoom() {
      lbZoomed = false;
      lbScale = 1;
      if (lbImg) {
        lbImg.style.transform = 'scale(1) translate(0,0)';
        lbImg.classList.remove('zoomed');
        lbImg.style.cursor = 'zoom-in';
      }
    }

    // Trigger lightbox from clicking any product image
    document.addEventListener('click', function(e) {
      var target = e.target;
      if (!target) return;
      if (target.id === 'main-image' || target.classList.contains('thumb-image') || target.closest('.collection-item-3')) {
        var img = target.tagName === 'IMG' ? target : target.querySelector('img');
        if (img) {
          e.preventDefault();
          openLightbox(img.src);
        }
      }
    });

    // Close on backdrop click
    if (lb) lb.addEventListener('click', function(e) {
      if (e.target === lb) closeLightbox();
    });
    if (lbClose) lbClose.addEventListener('click', closeLightbox);

    // Arrow nav
    if (lbPrev) lbPrev.addEventListener('click', function(e) {
      e.stopPropagation();
      lbIndex = (lbIndex - 1 + lbImages.length) % lbImages.length;
      showLbImage();
    });
    if (lbNext) lbNext.addEventListener('click', function(e) {
      e.stopPropagation();
      lbIndex = (lbIndex + 1) % lbImages.length;
      showLbImage();
    });

    // Keyboard navigation
    document.addEventListener('keydown', function(e) {
      if (!lb || !lb.classList.contains('open')) return;
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowLeft') { lbIndex = (lbIndex - 1 + lbImages.length) % lbImages.length; showLbImage(); }
      if (e.key === 'ArrowRight') { lbIndex = (lbIndex + 1) % lbImages.length; showLbImage(); }
    });

    // Touch swipe inside lightbox
    if (lb) {
      lb.addEventListener('touchstart', function(e) { lbTouchStartX = e.touches[0].clientX; }, {passive: true});
      lb.addEventListener('touchend', function(e) {
        var dx = e.changedTouches[0].clientX - lbTouchStartX;
        if (Math.abs(dx) > 50 && lbImages.length > 1) {
          if (dx < 0) { lbIndex = (lbIndex + 1) % lbImages.length; }
          else { lbIndex = (lbIndex - 1 + lbImages.length) % lbImages.length; }
          showLbImage();
        }
      }, {passive: true});
    }

    // Single-image: hover zoom following mouse
    var lbTranslateX = 0, lbTranslateY = 0;
    if (lbImg) {
      lbImg.addEventListener('click', function(e) {
        e.stopPropagation();
        if (!lbZoomed) {
          lbZoomed = true;
          lbScale = 2.5;
          lbImg.classList.add('zoomed');
          lbImg.style.cursor = 'move';
          lbImg.style.transition = 'transform 0.2s ease';
        } else {
          resetZoom();
        }
      });

      // Mouse follow when zoomed
      lbImg.addEventListener('mousemove', function(e) {
        if (!lbZoomed) return;
        var rect = lbImg.getBoundingClientRect();
        var cx = (e.clientX - rect.left) / rect.width - 0.5;
        var cy = (e.clientY - rect.top) / rect.height - 0.5;
        lbTranslateX = -cx * rect.width * (lbScale - 1) * 0.5;
        lbTranslateY = -cy * rect.height * (lbScale - 1) * 0.5;
        lbImg.style.transform = 'scale(' + lbScale + ') translate(' + lbTranslateX + 'px,' + lbTranslateY + 'px)';
        lbImg.style.transition = 'none';
      });
    }

    // ── MOBILE DOT INDICATORS ──────────────────────────────────────
    function initDots() {
      var dotsContainer = document.getElementById('jj-swipe-dots');
      if (!dotsContainer) return;
      var wrapper = document.querySelector('.more-image-wrapper');
      if (!wrapper) return;

      var imgs = wrapper.querySelectorAll('img');
      if (imgs.length < 2) return;

      // Build dots
      dotsContainer.innerHTML = '';
      imgs.forEach(function(img, i) {
        var dot = document.createElement('div');
        dot.className = 'jj-swipe-dot' + (i === 0 ? ' active' : '');
        dot.addEventListener('click', function() {
          img.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
        });
        dotsContainer.appendChild(dot);
      });

      // Update dots on scroll
      wrapper.addEventListener('scroll', function() {
        var scrollLeft = wrapper.scrollLeft;
        var itemWidth = wrapper.offsetWidth;
        var activeIndex = Math.round(scrollLeft / itemWidth);
        dotsContainer.querySelectorAll('.jj-swipe-dot').forEach(function(d, i) {
          d.classList.toggle('active', i === activeIndex);
        });
      }, {passive: true});
    }

    // ── CURSOR LOGIC ───────────────────────────────────────────────
    function initCursor() {
      var tricksCursor = document.querySelector('.cursor');
      if (tricksCursor) {
        if (window.cursorFunc) window.removeEventListener('mousemove', window.cursorFunc);
        window.cursorFunc = function(e) {
          tricksCursor.style.top = e.clientY + 'px';
          tricksCursor.style.left = e.clientX + 'px';
        };
        window.addEventListener('mousemove', window.cursorFunc);
      }
    }

    // ── CART ERROR OBSERVER ────────────────────────────────────────
    function initCartObserver() {
      var observer = new MutationObserver(function(mutations) {
        mutations.forEach(function(m) {
          if (m.target.classList.contains('w-commerce-commerceaddtocarterrorstate') && m.target.style.display !== 'none') {
            m.target.style.display = 'none';
          }
        });
      });
      document.querySelectorAll('.w-commerce-commerceaddtocarterrorstate').forEach(function(el) {
        observer.observe(el, { attributes: true, attributeFilter: ['style'] });
      });
    }

    document.addEventListener('DOMContentLoaded', function() {
      initDots();
      initCursor();
      initCartObserver();
    });
  })();
</script>

