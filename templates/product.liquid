      slides.forEach(function(slide, i) {
        var dot = document.createElement('div');
        dot.className = 'jj-swipe-dot' + (i === 0 ? ' active' : '');
        dot.addEventListener('click', function() {
          slide.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
        });
        dotsContainer.appendChild(dot);
      });

      swipeTrack.addEventListener('scroll', function() {
        var scrollLeft = swipeTrack.scrollLeft;
        var slideWidth = swipeTrack.offsetWidth || window.innerWidth;
        var activeIndex = Math.round(scrollLeft / slideWidth);
        dotsContainer.querySelectorAll('.jj-swipe-dot').forEach(function(d, i) {
          d.classList.toggle('active', i === activeIndex);
        });
      }, {passive: true});
    }

