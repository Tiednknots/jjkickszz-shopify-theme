      <!-- ── FIT CURATOR WIDGET ── -->
      <div class="jj-fit-curator-section" style="background:#050505; border-top:1px solid #1a1a1a; padding:60px 0; font-family:'Inter', sans-serif;">
        <div style="max-width:1200px; margin:0 auto; padding: 0 20px;">
          <h2 style="font-size:24px; font-weight:800; letter-spacing:2px; text-transform:uppercase; color:#fff; margin-bottom:8px; text-align:center;">FIT CURATOR: COMPLETE THE LOOK</h2>
          <p style="font-size:11px; color:#888; text-align:center; max-width:550px; margin:0 auto 40px; line-height:1.6; letter-spacing:1px; text-transform:uppercase;">Curate your custom outfit. On desktop, drag pieces to construct your look. Add the bundle to cart to automatically apply a $25 discount.</p>
          
          <div class="jj-curator-workspace">
            <div class="jj-canvas-container" id="jj-canvas-container">
              <div id="jj-curator-loading" style="position:absolute; inset:0; display:flex; align-items:center; justify-content:center; color:#fff; font-size:12px; font-weight:600; letter-spacing:1px; text-transform:uppercase; background:rgba(0,0,0,0.85); z-index:100;">
                Curating your custom outfit...
              </div>
            </div>
            
            <div class="jj-curator-summary" style="width:380px; flex-shrink:0; background:#0b0b0b; border:1px solid #1a1a1a; border-radius:12px; padding:24px; box-sizing:border-box; display:flex; flex-direction:column; justify-content:space-between; box-shadow:0 10px 30px rgba(0,0,0,0.5);">
              <div>
                <h3 style="font-size:11px; font-weight:800; color:#fff; border-bottom:1px solid #1a1a1a; padding-bottom:12px; margin-bottom:16px; letter-spacing:1px; text-transform:uppercase;">OUTFIT SELECTIONS</h3>
                <div id="jj-curator-items-list" style="display:flex; flex-direction:column; gap:16px; margin-bottom:24px;"></div>
              </div>
              
              <div style="border-top:1px solid #1a1a1a; padding-top:16px;">
                <div style="display:flex; justify-content:space-between; margin-bottom:8px; font-size:11px; color:#888; font-weight:600; text-transform:uppercase; letter-spacing:0.5px;">
                  <span>Subtotal</span>
                  <span id="jj-bundle-subtotal">$0.00</span>
                </div>
                <div id="jj-bundle-discount-row" style="display:flex; justify-content:space-between; margin-bottom:12px; font-size:11px; color:#ef4444; font-weight:800; text-transform:uppercase; letter-spacing:0.5px;">
                  <span>Bundle Discount</span>
                  <span>-$25.00</span>
                </div>
                <div style="display:flex; justify-content:space-between; margin-bottom:20px; font-size:15px; color:#fff; font-weight:800; text-transform:uppercase; letter-spacing:1px;">
                  <span>Bundle Total</span>
                  <span id="jj-bundle-total" style="color:#22c55e;">$0.00</span>
                </div>
                
                <button id="jj-add-bundle-btn" style="width:100%; background:#fff; color:#000; border:none; border-radius:6px; padding:16px; font-size:11px; font-weight:800; text-transform:uppercase; letter-spacing:1px; cursor:pointer; transition:background 0.2s;">Add Outfit to Cart</button>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="new-similar-items">
        <h1 class="title-label product">You might also like 👀</h1>
        {%- render "products_where_category_idin_currentcategory_sorted_by_created_on" -%}
      </div>
      {%- section 'footer' -%}

      <!-- ── LIGHTBOX OVERLAY ────────────────────────────────────── -->
      <div id="jj-lightbox" role="dialog" aria-modal="true" aria-label="Image lightbox">
        <button class="jj-lb-close" id="jj-lb-close" aria-label="Close lightbox">&times;</button>
        <div class="jj-lb-img-wrap" id="jj-lb-img-wrap">
          <img id="jj-lb-img" src="" alt="Product image">
        </div>
        <div class="jj-lb-bottom-bar">
          <button class="jj-lb-arrow" id="jj-lb-prev" aria-label="Previous image">&#8592;</button>
          <div class="jj-lb-thumbs" id="jj-lb-thumbs"></div>
          <button class="jj-lb-arrow" id="jj-lb-next" aria-label="Next image">&#8594;</button>
        </div>
        <div class="jj-lb-counter" id="jj-lb-counter"></div>
      </div>

      <!-- ── IOS-STYLE SLIDE-UP CONTACT DRAWER ────────────────────── -->
      <div id="jj-drawer-overlay"></div>
      <div id="jj-contact-drawer" role="dialog" aria-modal="true" aria-label="Ask a question drawer">
        <div class="jj-drawer-handle"></div>
        <div class="jj-drawer-header">
          <h2 class="jj-drawer-title">Ask a Question</h2>
          <button class="jj-drawer-close" id="jj-drawer-close" aria-label="Close drawer">&times;</button>
        </div>
        <div class="jj-drawer-content">
          <!-- Product Context Row -->
          <div class="jj-drawer-product-row">
            <img src="{{ product.featured_image | img_url: '150x' }}" class="jj-drawer-product-img" alt="{{ product.title }}">
            <div class="jj-drawer-product-info">
              <h3 class="jj-drawer-product-title">{{ product.title }}</h3>
              <p class="jj-drawer-product-price">{{ product.price | money }}</p>
            </div>
          </div>

          {%- form "contact", id: "jj-drawer-form" -%}
            <input type="hidden" name="contact[product_title]" value="{{ product.title }}">
            <input type="hidden" name="contact[product_url]" value="{{ shop.url }}{{ product.url }}">
            
            <div class="jj-drawer-fields">
              <div class="jj-drawer-field">
                <input type="text" id="drawer-name" name="contact[name]" placeholder="Your Name" required autocomplete="name">
              </div>
              <div class="jj-drawer-field">
                <input type="email" id="drawer-email" name="contact[email]" placeholder="Your Email" required autocomplete="email">
              </div>
              <div class="jj-drawer-field">
                <input type="tel" id="drawer-phone" name="contact[phone]" placeholder="Phone Number (Optional)" autocomplete="tel">
              </div>
              <div class="jj-drawer-field">
                <select id="drawer-reason" name="contact[reason]" required>
                  <option value="Product Question" selected>Reason: Product Question</option>
                  <option value="Sizing Advice">Reason: Sizing Advice</option>
                  <option value="Availability">Reason: Availability / Restocks</option>
                </select>
              </div>
              <div class="jj-drawer-field">
                <textarea id="drawer-message" name="contact[body]" placeholder="Your Message" required>Hi, I have a question about the {{ product.title }}: </textarea>
              </div>
            </div>

            <button type="submit" class="jj-drawer-submit">Send Message</button>
            
            <div class="jj-drawer-success" id="jj-drawer-success">✓ Message sent successfully!</div>
            <div class="jj-drawer-error" id="jj-drawer-error">Something went wrong. Please try again.</div>
          {%- endform -%}
        </div>
      </div>
    </div>
  </div>
