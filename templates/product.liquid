                              </div>
                            {%- endfor -%}
                          </div>
                          <!-- Styled visible dropdown (mirrors pill selection) -->
                          <div class="jj-select-wrap">
                            <select class="jj-styled-select" data-option-index="{{ forloop.index }}" name="jj-visible-option{{ forloop.index }}" id="jj-option-{{ forloop.index }}" aria-label="{{ option.name }}">
                              <option value="" disabled selected>Select {{ option.name }}</option>
                              {%- for value in option.values -%}
                                {%- assign is_available = false -%}
                                {%- for variant in product.variants -%}
                                  {%- if variant.options contains value -%}
                                    {%- if variant.available -%}{%- assign is_available = true -%}{%- endif -%}
                                  {%- endif -%}
                                {%- endfor -%}
                                <option value="{{ value }}"{% unless is_available %} class="jj-opt-soldout" disabled{% endunless %}>
