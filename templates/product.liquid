          <div class="thumbnail-section">
            {%- if product.images.size > 1 -%}
              <!-- ── DESKTOP: Thumbnail strip left + focal image right ── -->
              <div class="jj-gallery-desktop">
                <div class="jj-thumb-strip">
                  {%- for image in product.images -%}
                    <img
                      class="jj-thumb{% if forloop.first %} jj-thumb-active{% endif %}"
                      src="{{ image | product_img_url: '200x' }}"
                      data-full="{{ image | product_img_url: '1200x' }}"
                      data-index="{{ forloop.index0 }}"
                      alt="{{ image.alt | default: product.title }}"
                      loading="lazy"
                    >
                  {%- endfor -%}
                </div>
                <div class="jj-focal-wrap">
                  <img
                    id="jj-focal-img"
                    class="jj-focal-image"
                    src="{{ product.images.first | product_img_url: '1200x' }}"
                    alt="{{ product.images.first.alt | default: product.title }}"
                    data-index="0"
                    loading="eager"
                    fetchpriority="high"
                  >
                </div>
              </div>

              <!-- ── MOBILE/TABLET: Horizontal swipe carousel ── -->
              <div class="jj-gallery-mobile">
                <div class="jj-mobile-swipe" id="jj-mobile-swipe">
                  {%- for image in product.images -%}
                    <img
                      class="jj-mobile-slide"
                      src="{{ image | product_img_url: '1024x' }}"
                      alt="{{ image.alt | default: product.title }}"
                      data-index="{{ forloop.index0 }}"
                      loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                      {% if forloop.first %}fetchpriority="high"{% endif %}
                    >
                  {%- endfor -%}
                </div>
                <!-- Mobile dot indicators -->
                <div class="jj-swipe-dots" id="jj-swipe-dots"></div>
              </div>
            {%- else -%}
              <!-- ── SINGLE IMAGE: Full width focal ── -->
              <div class="jj-gallery-desktop jj-gallery-single">
                <div class="jj-focal-wrap">
                  <img
                    id="jj-focal-img"
                    class="jj-focal-image"
                    src="{{ product.featured_image | product_img_url: '1200x' }}"
                    alt="{{ product.featured_image.alt | default: product.title }}"
                    data-index="0"
                    loading="eager"
                    fetchpriority="high"
                  >
                </div>
              </div>
              <!-- Mobile single image -->
              <div class="jj-gallery-mobile">
                <div class="jj-mobile-swipe" id="jj-mobile-swipe">
                  <img
                    class="jj-mobile-slide"
                    src="{{ product.featured_image | product_img_url: '1024x' }}"
                    alt="{{ product.featured_image.alt | default: product.title }}"
                    loading="eager"
                    fetchpriority="high"
                  >
                </div>
              </div>
            {%- endif -%}
