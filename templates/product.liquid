<style>
  /* ── 0. IMMEDIATE CRITICAL LAYOUT STYLES (PREVENTS FLASH OF WRONG GALLERY) ── */
  .w-commerce-commerceaddtocarterrorstate { display: none !important; }

  /* ── PRODUCT PAGE 2-COLUMN GRID — DESKTOP ─────────────────────── */
  @media screen and (min-width: 992px) {
    .div-block-629 {
      display: grid !important;
      grid-template-columns: 1fr 1fr !important;
      gap: 3rem !important;
      align-items: start !important;
      padding: 2rem 3rem 4rem !important;
      box-sizing: border-box !important;
      max-width: 100% !important;
      min-height: 0 !important;
      height: auto !important;
      max-height: none !important;
    }

    /* LEFT: Sticky gallery column — sticks until right column scrolls past */
    .thumbnail-section {
      position: -webkit-sticky !important;
      position: sticky !important;
      top: 124px !important; /* 80px navbar + 40px marquee + 4px buffer */
      align-self: flex-start !important;
      width: 90% !important;
      max-width: 100% !important;
      margin: 0 auto !important;
      overflow: visible !important;
      max-height: none !important;
      height: auto !important;
      box-sizing: border-box !important;
    }

    /* RIGHT: Normal scroll — no sticky, NO internal scrollbar */
    .product-container {
      position: relative !important;
      top: auto !important;
      max-height: none !important;
      height: auto !important;
      overflow: visible !important;
      overflow-y: visible !important;
      width: 90% !important;
      margin: 0 auto !important;
      padding-top: 1rem !important;
      padding-left: 2rem !important;
      border-left: 1px solid #252525 !important;
      scrollbar-width: none !important;
      -ms-overflow-style: none !important;
    }
    .product-container::-webkit-scrollbar { display: none !important; }

    /* Desktop gallery: HIDE mobile swipe, SHOW desktop layout */
    .jj-gallery-mobile { display: none !important; }
    .jj-gallery-desktop { display: flex !important; }

    /* ── DESKTOP: Thumbnail strip left of focal image ── */
    .jj-gallery-desktop {
      display: flex !important;
      flex-direction: row !important;
      align-items: flex-start !important;
      gap: 16px !important;
      width: 100% !important;
      max-width: 100% !important;
      box-sizing: border-box !important;
    }

    /* Single-image: no strip needed */
    .jj-gallery-single {
      flex-direction: column !important;
    }
    .jj-gallery-single .jj-thumb-strip { display: none !important; }

    /* Thumbnail strip: vertical column on the left */
    .jj-thumb-strip {
      display: flex !important;
      flex-direction: column !important;
      gap: 8px !important;
      width: 72px !important;
      min-width: 72px !important;
      max-width: 72px !important;
      flex-shrink: 0 !important;
      max-height: calc(100vh - 160px) !important;
      overflow-y: auto !important;
      scrollbar-width: none !important;
      box-sizing: border-box !important;
    }
    .jj-thumb-strip::-webkit-scrollbar { display: none !important; }

    /* Individual thumbnail */
    .jj-thumb {
      width: 72px !important;
      height: 72px !important;
      object-fit: cover !important;
      border-radius: 6px !important;
      border: 2px solid transparent !important;
      opacity: 0.55 !important;
      cursor: pointer !important;
      flex-shrink: 0 !important;
      transition: opacity 0.2s ease, border-color 0.2s ease !important;
      background: #111 !important;
    }
    .jj-thumb:hover { opacity: 0.85 !important; }
    .jj-thumb.jj-thumb-active {
      opacity: 1 !important;
      border-color: #ffffff !important;
    }

    /* Focal image container: hover zoom ready */
    .jj-focal-wrap {
      flex: 1 !important;
      min-width: 0 !important;
      max-width: calc(100% - 88px) !important;
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
      background: #090909 !important;
      border: 1px solid #1c1c1c !important;
      border-radius: 12px !important;
      overflow: hidden !important;
      box-sizing: border-box !important;
      cursor: zoom-in !important;
      position: relative !important;
    }
    .jj-gallery-single .jj-focal-wrap {
      max-width: 100% !important;
    }
    .jj-focal-image {
      width: 100% !important;
      max-width: 100% !important;
      max-height: calc(100vh - 160px) !important;
      aspect-ratio: 1 / 1 !important;
      object-fit: contain !important;
      border-radius: 12px !important;
      display: block !important;
      background: transparent !important;
      transition: transform 0.15s ease-out !important;
      user-select: none !important;
    }
  }

  /* ── TABLET & MOBILE (≤991px) — Swipe gallery ─────────────────── */
  @media (max-width: 991px) {
    .div-block-629 {
      display: flex !important;
      flex-direction: column !important;
      padding: 0 !important;
      gap: 0 !important;
    }

    .thumbnail-section {
      position: static !important;
      max-height: none !important;
      overflow: visible !important;
      width: 100% !important;
      margin: 0 !important;
      padding: 0 !important;
    }

    /* Mobile: HIDE desktop layout, SHOW swipe carousel */
    .jj-gallery-desktop { display: none !important; }
    .jj-gallery-mobile {
      display: block !important;
      width: 100% !important;
      box-sizing: border-box !important;
    }

    /* 65vh mobile swipe track with side padding */
    .jj-mobile-swipe {
      display: flex !important;
      flex-direction: row !important;
      overflow-x: auto !important;
      overflow-y: hidden !important;
      scroll-snap-type: x mandatory !important;
      scrollbar-width: none !important;
      -ms-overflow-style: none !important;
      width: 100% !important;
      height: 65vh !important;
      min-height: 280px !important;
      padding: 0 1rem !important;
      gap: 12px !important;
      box-sizing: border-box !important;
    }
    .jj-mobile-swipe::-webkit-scrollbar { display: none !important; }

    .jj-mobile-slide {
      flex-shrink: 0 !important;
      width: calc(100vw - 2rem) !important;
      height: 65vh !important;
      min-height: 280px !important;
      object-fit: cover !important;
      border-radius: 12px !important;
      scroll-snap-align: center !important;
      display: block !important;
      background: #0d0d0d !important;
    }

    /* Indicator lines spacing */
    .jj-swipe-dots {
      display: flex !important;
      justify-content: center !important;
      align-items: center !important;
      gap: 8px !important;
      padding: 14px 0 18px !important;
      width: 100% !important;
    }
    .jj-swipe-dot {
      width: 24px !important;
      height: 3px !important;
      border-radius: 2px !important;
      background: rgba(255, 255, 255, 0.25) !important;
      transition: all 0.25s ease !important;
      cursor: pointer !important;
    }
    .jj-swipe-dot.active {
      background: #ffffff !important;
      width: 42px !important;
    }

    /* Product details */
    .product-container {
      position: static !important;
      max-height: none !important;
      overflow: visible !important;
      overflow-y: visible !important;
      width: 100% !important;
      margin: 0 !important;
      padding: 0 1.25rem 2rem !important;
      border-left: none !important;
    }
  }

  /* ── STYLED VARIANT DROPDOWN ──────────────────────────────────── */
  .jj-pills-hidden {
    display: none !important;
    visibility: hidden !important;
    height: 0 !important;
    overflow: hidden !important;
    pointer-events: none !important;
  }

  .jj-option-fieldset {
    border: none !important;
    padding: 0 !important;
    margin: 0 0 16px 0 !important;
  }

  .jj-option-label {
    display: block !important;
    font-size: 10px !important;
    font-weight: 700 !important;
    letter-spacing: 0.12em !important;
    text-transform: uppercase !important;
    color: rgba(255,255,255,0.55) !important;
    margin-bottom: 8px !important;
  }

  .jj-select-wrap {
    position: relative !important;
    width: 100% !important;
  }

  .jj-styled-select {
    width: 100% !important;
    appearance: none !important;
    -webkit-appearance: none !important;
    background: #111111 !important;
    border: 1px solid #2e2e2e !important;
    border-radius: 8px !important;
    color: #ffffff !important;
    font-family: 'Inter', sans-serif !important;
    font-size: 13px !important;
    font-weight: 500 !important;
    letter-spacing: 0.03em !important;
    padding: 11px 42px 11px 14px !important;
    cursor: pointer !important;
    outline: none !important;
    transition: border-color 0.2s ease !important;
    font-size: max(13px, 16px) !important;
  }

  @media (min-width: 992px) {
    .jj-styled-select { font-size: 13px !important; }
  }

  .jj-styled-select:focus {
    border-color: rgba(255,255,255,0.5) !important;
    box-shadow: 0 0 0 2px rgba(255,255,255,0.08) !important;
  }

  .jj-styled-select option { background: #111111; color: #ffffff; }
  .jj-styled-select .jj-opt-soldout,
  .jj-styled-select option:disabled { color: #555555 !important; }

  .jj-select-arrow {
    position: absolute !important;
    right: 14px !important;
    top: 50% !important;
    transform: translateY(-50%) !important;
    pointer-events: none !important;
    color: rgba(255,255,255,0.4) !important;
    display: flex !important;
    align-items: center !important;
  }

  /* ── PRODUCT TITLE ─────────────────────────────────────────────── */
  .title-label.producc {
    white-space: normal !important;
    word-break: break-word !important;
    overflow-wrap: break-word !important;
    max-width: 100% !important;
    line-height: 1.2 !important;
    font-size: 2rem !important;
  }

  /* ── ASK A QUESTION BUTTON ─────────────────────────────────────── */
  .jj-ask-question-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    margin-top: 16px;
    padding: 6px 0;
    background: transparent;
    border: none;
    color: rgba(255,255,255,0.45);
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: none;
    text-decoration: underline;
    cursor: pointer;
    transition: color 0.2s ease;
  }
  .jj-ask-question-btn:hover { color: rgba(255,255,255,0.9); }

  /* ── IOS-STYLE SLIDE-UP CONTACT DRAWER ─────────────────────────── */
  #jj-drawer-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
    z-index: 999998;
  }
  #jj-drawer-overlay.open {
    opacity: 1;
    visibility: visible;
  }

  #jj-contact-drawer {
    position: fixed;
    bottom: 0;
    left: 50%;
    transform: translate(-50%, 100%);
    width: 100%;
    max-width: 480px;
    max-height: 90vh;
    background: #0e0e0e;
    border: 1px solid #222222;
    border-bottom: none;
    border-radius: 20px 20px 0 0;
    box-shadow: 0 -10px 40px rgba(0, 0, 0, 0.8);
    z-index: 999999;
    overflow-y: auto;
    scrollbar-width: none;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    box-sizing: border-box;
    padding: 16px 24px 32px;
  }
  #jj-contact-drawer::-webkit-scrollbar { display: none; }
  #jj-contact-drawer.open {
    transform: translate(-50%, 0);
  }

  .jj-drawer-handle {
    width: 40px;
    height: 4px;
    background: rgba(255, 255, 255, 0.25);
    border-radius: 2px;
    margin: 0 auto 16px;
  }

  .jj-drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20px;
    padding-bottom: 12px;
    border-bottom: 1px solid #1a1a1a;
  }
  .jj-drawer-title {
    font-family: 'Inter', sans-serif;
    font-size: 16px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #ffffff;
    margin: 0;
  }
  .jj-drawer-close {
    background: transparent;
    border: none;
    color: rgba(255, 255, 255, 0.5);
    font-size: 24px;
    line-height: 1;
    cursor: pointer;
    padding: 4px 8px;
    transition: color 0.15s ease;
  }
  .jj-drawer-close:hover { color: #ffffff; }

  .jj-drawer-product-row {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 12px;
    background: #141414;
    border: 1px solid #222222;
    border-radius: 10px;
    margin-bottom: 20px;
  }
  .jj-drawer-product-img {
    width: 48px;
    height: 48px;
    object-fit: cover;
    border-radius: 6px;
    background: #000;
  }
  .jj-drawer-product-info { flex: 1; min-width: 0; }
  .jj-drawer-product-title {
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    font-weight: 600;
    color: #ffffff;
    margin: 0 0 4px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .jj-drawer-product-price {
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    color: rgba(255, 255, 255, 0.6);
    margin: 0;
  }

  .jj-drawer-fields {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 20px;
  }
  .jj-drawer-field input,
  .jj-drawer-field select,
  .jj-drawer-field textarea {
    width: 100%;
    background: #141414;
    border: 1px solid #282828;
    border-radius: 8px;
    padding: 12px 14px;
    color: #ffffff;
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    box-sizing: border-box;
    outline: none;
    transition: border-color 0.2s ease;
  }
  .jj-drawer-field input:focus,
  .jj-drawer-field select:focus,
  .jj-drawer-field textarea:focus {
    border-color: rgba(255, 255, 255, 0.5);
  }
  .jj-drawer-field textarea {
    min-height: 80px;
    resize: vertical;
  }

  .jj-drawer-submit {
    width: 100%;
    background: #ffffff;
    color: #000000;
    border: none;
    border-radius: 8px;
    padding: 14px;
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    cursor: pointer;
    transition: background 0.2s ease;
  }
  .jj-drawer-submit:hover { background: #e0e0e0; }

  .jj-drawer-success {
    display: none;
    margin-top: 12px;
    color: #22c55e;
    font-size: 12px;
    text-align: center;
    font-weight: 600;
  }
  .jj-drawer-error {
    display: none;
    margin-top: 12px;
    color: #ef4444;
    font-size: 12px;
    text-align: center;
  }

  /* ── LIGHTBOX ──────────────────────────────────────────────────── */
  #jj-lightbox {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 999999;
    background: rgba(0,0,0,0.97);
    align-items: center;
    justify-content: center;
    flex-direction: column;
  }
  #jj-lightbox.open {
    display: flex;
    animation: jj-lb-fadein 0.2s ease;
  }
  @keyframes jj-lb-fadein {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  .jj-lb-close {
    position: absolute;
    top: 20px; right: 24px;
    background: transparent; border: none;
    color: rgba(255,255,255,0.6);
    font-size: 28px; cursor: pointer;
    line-height: 1; padding: 8px;
    transition: color 0.15s ease; z-index: 10;
  }
  .jj-lb-close:hover { color: #fff; }
  .jj-lb-img-wrap {
    position: relative;
    display: flex; align-items: center; justify-content: center;
    flex: 1; width: 100%; overflow: hidden;
  }
  #jj-lb-img {
    max-width: 90vw; max-height: 80vh;
    object-fit: contain;
    user-select: none;
    transition: transform 0.1s ease;
    cursor: zoom-in;
  }
  #jj-lb-img.zoomed { cursor: move; }

  /* Lightbox bottom bar: prev | thumbnails | next */
  .jj-lb-bottom-bar {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    width: 100%;
    padding: 12px 24px 20px;
    box-sizing: border-box;
  }
  .jj-lb-thumbs {
    display: flex;
    flex-direction: row;
    gap: 8px;
    overflow-x: auto;
    max-width: 70vw;
    scrollbar-width: none;
  }
  .jj-lb-thumbs::-webkit-scrollbar { display: none; }
  .jj-lb-thumb {
    width: 52px; height: 52px;
    object-fit: cover;
    border-radius: 4px;
    border: 2px solid transparent;
    opacity: 0.5;
    cursor: pointer;
    flex-shrink: 0;
    transition: opacity 0.15s ease, border-color 0.15s ease;
  }
  .jj-lb-thumb:hover { opacity: 0.85; }
  .jj-lb-thumb.jj-lb-thumb-active {
    opacity: 1 !important;
    border-color: #ffffff !important;
  }
  .jj-lb-arrow {
    background: transparent;
    border: 1px solid rgba(255,255,255,0.2);
    color: rgba(255,255,255,0.7);
    font-size: 18px;
    width: 44px; height: 44px;
    display: flex; align-items: center; justify-content: center;
    cursor: pointer;
    border-radius: 50%;
    transition: all 0.15s ease;
    flex-shrink: 0;
  }
  .jj-lb-arrow:hover {
    background: rgba(255,255,255,0.08);
    color: #fff;
    border-color: rgba(255,255,255,0.4);
  }
  .jj-lb-counter {
    position: absolute;
    bottom: 76px; left: 50%;
    transform: translateX(-50%);
    font-family: 'Inter', sans-serif;
    font-size: 11px; letter-spacing: 0.1em;
    color: rgba(255,255,255,0.3);
  }

  /* Similar items row */
  .new-similar-items .collection-list-wrapper {
    height: auto !important; min-height: 0 !important;
    margin: 0 !important; padding: 0 !important;
  }
  .new-similar-items .collection-list-2.contents-of-scroll {
    display: flex !important; flex-direction: row !important;
    flex-wrap: nowrap !important; align-items: flex-start !important;
    height: auto !important; min-height: 0 !important;
    padding-top: 10px !important; padding-bottom: 20px !important;
    gap: 16px !important;
  }
  .new-similar-items .collection-item-2.product,
  .new-similar-items .collection-item-2 {
    flex: 0 0 170px !important; width: 170px !important;
    height: auto !important; min-height: 0 !important; margin: 0 !important;
  }
  .new-similar-items .collection-item-2.product .link-block-2,
  .new-similar-items .collection-item-2 .link-block-2 {
    display: flex !important; flex-direction: column !important;
    height: auto !important; border: 1px solid #2e2e2e !important;
    border-radius: 8px !important; background-color: #0b0b0b !important;
    padding: 0 0 12px 0 !important; overflow: hidden !important;
  }
</style>
