      title: {{ product.title | json }},
      type: {{ product.type | json }},
      price: {{ product.price | json }},
      featured_image: {{ product.featured_image | img_url: '600x' | json }},
      variants: {{ product.variants | json }},
      selectedVariantId: {{ product.selected_or_first_available_variant.id | json }}
    };

    function getAllImages() {
      var imgs = [];
      var thumbs = document.querySelectorAll('.jj-thumb');
      if (thumbs.length > 0) {
        thumbs.forEach(function(t) {
          var src = t.getAttribute('data-full') || t.src;
          if (src) {
            var norm = src.replace(/_(\\d+x|\\d+x\\d+)(\\.[a-z]+)$/i, '_1920x$2');
            if (!imgs.includes(norm)) imgs.push(norm);
          }
        });
      }
      if (!imgs.length) {
        var mobileSlides = document.querySelectorAll('.jj-mobile-slide');
        if (mobileSlides.length > 0) {
          mobileSlides.forEach(function(s) {
            var src = s.getAttribute('data-full') || s.src;
            if (src) {
              var norm = src.replace(/_(\\d+x|\\d+x\\d+)(\\.[a-z]+)$/i, '_1920x$2');
              if (!imgs.includes(norm)) imgs.push(norm);
            }
          });
        }
      }
      if (!imgs.length) {
        var focal = document.getElementById('jj-focal-img');
        if (focal && focal.src) {
          imgs.push(focal.src.replace(/_(\\d+x|\\d+x\\d+)(\\.[a-z]+)$/i, '_1920x$2'));
        }
      }
      return imgs;
    }

    // ── LIGHTBOX ENGINE ────────────────────────────────────────────
    var lb = document.getElementById('jj-lightbox');
    var lbImg = document.getElementById('jj-lb-img');
    var lbClose = document.getElementById('jj-lb-close');
    var lbPrev = document.getElementById('jj-lb-prev');
    var lbNext = document.getElementById('jj-lb-next');
    var lbCounter = document.getElementById('jj-lb-counter');
    var lbImages = [];
    var lbIndex = 0;
    var lbZoomed = false;
    var lbScale = 1;

    function openLightbox(clickedSrc) {
      lb = document.getElementById('jj-lightbox');
      lbImg = document.getElementById('jj-lb-img');
      lbImages = getAllImages();
      if (!lbImages.length) return;
      var norm = clickedSrc ? clickedSrc.replace(/_(\\d+x|\\d+x\\d+)(\\.[a-z]+)$/i, '_1920x$2') : '';
      lbIndex = lbImages.indexOf(norm);
      if (lbIndex < 0) lbIndex = 0;
      showLbImage();
      if (lb) lb.classList.add('open');
      document.body.style.overflow = 'hidden';
      var hasMultiple = lbImages.length > 1;
      if (lbPrev) lbPrev.style.display = hasMultiple ? '' : 'none';
      if (lbNext) lbNext.style.display = hasMultiple ? '' : 'none';
      populateLbThumbs();
    }

    function closeLightbox() {
      if (lb) lb.classList.remove('open');
      document.body.style.overflow = '';
      resetZoom();
    }

    function showLbImage() {
      if (!lbImages.length || !lbImg) return;
      lbImg.src = lbImages[lbIndex];
      if (lbCounter) lbCounter.textContent = lbImages.length > 1 ? (lbIndex + 1) + ' / ' + lbImages.length : '';
      
      document.querySelectorAll('.jj-lb-thumb').forEach(function(thumb, idx) {
        thumb.classList.toggle('jj-lb-thumb-active', idx === lbIndex);
      });

      resetZoom();
    }

    function triggerImmediateZoom() {
      lbZoomed = true;
      lbScale = 1.8;
      if (lbImg) {
        lbImg.classList.add('zoomed');
        lbImg.style.cursor = 'zoom-out';
        lbImg.style.transform = 'scale(' + lbScale + ') translate(0,0)';
      }
    }

    function resetZoom() {
      lbZoomed = false;
      lbScale = 1.0;
      if (lbImg) {
        lbImg.style.transform = 'scale(1) translate(0,0)';
        lbImg.classList.remove('zoomed');
        lbImg.style.cursor = 'zoom-in';
      }
    }

    function populateLbThumbs() {
      var thumbsContainer = document.getElementById('jj-lb-thumbs');
      if (!thumbsContainer) return;
      thumbsContainer.innerHTML = '';
      if (lbImages.length < 2) {
        thumbsContainer.style.display = 'none';
        return;
      }
      thumbsContainer.style.display = 'flex';
      lbImages.forEach(function(src, idx) {
        var img = document.createElement('img');
        img.src = src.replace('_1920x', '_150x');
        img.className = 'jj-lb-thumb' + (idx === lbIndex ? ' jj-lb-thumb-active' : '');
        img.addEventListener('click', function(e) {
          e.stopPropagation();
          lbIndex = idx;
          showLbImage();
        });
        thumbsContainer.appendChild(img);
      });
    }

    // ── THUMBNAIL SELECTOR (DIRECT LISTENER) ───────────────────────
    function initThumbnailClicks() {
      var thumbs = document.querySelectorAll('.jj-thumb');
      var focalImg = document.getElementById('jj-focal-img');
      thumbs.forEach(function(thumb) {
        function handleThumbClick(e) {
          e.preventDefault();
          e.stopPropagation();
          var fullSrc = thumb.getAttribute('data-full') || thumb.src;
          if (focalImg) {
            focalImg.src = fullSrc;
            focalImg.setAttribute('data-index', thumb.getAttribute('data-index') || '0');
          }
          thumbs.forEach(function(t) { t.classList.remove('jj-thumb-active'); });
          thumb.classList.add('jj-thumb-active');
        }
        thumb.onclick = handleThumbClick;
      });
    }

    // Focal image & mobile slide click -> open lightbox
    document.addEventListener('click', function(e) {
      var target = e.target;
      if (!target) return;

      if (target.closest('.jj-thumb')) return;

      var focal = target.closest('#jj-focal-img, .jj-focal-image, #jj-focal-wrap');
      if (focal) {
        e.preventDefault();
        var mainImg = document.getElementById('jj-focal-img') || focal.querySelector('img');
        if (mainImg) openLightbox(mainImg.src);
        return;
      }

      var mobileSlide = target.closest('.jj-mobile-slide');
      if (mobileSlide) {
        e.preventDefault();
        openLightbox(mobileSlide.src);
        return;
      }
    });

    if (lbClose) lbClose.addEventListener('click', closeLightbox);
    if (lb) lb.addEventListener('click', function(e) {
      if (e.target === lb || e.target.id === 'jj-lb-img-wrap') closeLightbox();
    });

    if (lbPrev) lbPrev.addEventListener('click', function(e) {
      e.stopPropagation();
      lbIndex = (lbIndex - 1 + lbImages.length) % lbImages.length;
      showLbImage();
    });
    if (lbNext) lbNext.addEventListener('click', function(e) {
      e.stopPropagation();
      lbIndex = (lbIndex + 1) % lbImages.length;
      showLbImage();
    });

    document.addEventListener('keydown', function(e) {
      if (!lb || !lb.classList.contains('open')) return;
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowLeft') { lbIndex = (lbIndex - 1 + lbImages.length) % lbImages.length; showLbImage(); }
      if (e.key === 'ArrowRight') { lbIndex = (lbIndex + 1) % lbImages.length; showLbImage(); }
    });

    var wrap = document.getElementById('jj-lb-img-wrap');
    if (lbImg && wrap) {
      lbImg.addEventListener('click', function(e) {
        e.stopPropagation();
        if (!lbZoomed) triggerImmediateZoom(); else resetZoom();
      });

      wrap.addEventListener('mousemove', function(e) {
        if (!lbZoomed) return;
        var rect = wrap.getBoundingClientRect();
        var cx = (e.clientX - rect.left) / rect.width - 0.5;
        var cy = (e.clientY - rect.top) / rect.height - 0.5;
        var transX = -cx * rect.width * (lbScale - 1) * 0.45;
        var transY = -cy * rect.height * (lbScale - 1) * 0.45;
        lbImg.style.transform = 'scale(' + lbScale + ') translate(' + transX + 'px,' + transY + 'px)';
      });
    }

    // ── DESKTOP FOCAL HOVER ZOOM ──────────────────────────────────
    function initDesktopHoverZoom() {
      var focalWrap = document.getElementById('jj-focal-wrap');
      var focalImg = document.getElementById('jj-focal-img');
      if (!focalWrap || !focalImg) return;

      focalWrap.addEventListener('mousemove', function(e) {
        if (window.innerWidth < 992) return;
        var rect = focalWrap.getBoundingClientRect();
        var x = ((e.clientX - rect.left) / rect.width) * 100;
        var y = ((e.clientY - rect.top) / rect.height) * 100;
        focalImg.style.transformOrigin = x + '% ' + y + '%';
        focalImg.style.transform = 'scale(1.4)';
      });

      focalWrap.addEventListener('mouseleave', function() {
        if (window.innerWidth < 992) return;
        focalImg.style.transformOrigin = 'center center';
        focalImg.style.transform = 'scale(1)';
      });
    }

    // ── MOBILE SWIPE CAROUSEL & INDICATOR LINES ──────────────────
    function initDots() {
      var dotsContainer = document.getElementById('jj-swipe-dots');
      var swipeTrack = document.getElementById('jj-mobile-swipe');
      if (!dotsContainer || !swipeTrack) return;

      var slides = swipeTrack.querySelectorAll('.jj-mobile-slide');
      if (slides.length <= 1) {
        dotsContainer.style.display = 'none';
        return;
      }
      dotsContainer.style.display = 'flex';

      dotsContainer.querySelectorAll('.jj-swipe-dot').forEach(function(dot, i) {
        dot.addEventListener('click', function() {
          if (slides[i]) {
            slides[i].scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
          }
        });
      });

      swipeTrack.addEventListener('scroll', function() {
        var scrollLeft = swipeTrack.scrollLeft;
        var slideWidth = swipeTrack.offsetWidth || window.innerWidth;
        var activeIndex = Math.round(scrollLeft / slideWidth);
        dotsContainer.querySelectorAll('.jj-swipe-dot').forEach(function(d, i) {
          d.classList.toggle('active', i === activeIndex);
        });
      }, {passive: true});
    }

    // ── VARIANT DROPDOWN SYNC ─────────────────────────────────────
    function initVariantDropdowns() {
      var selects = document.querySelectorAll('.jj-styled-select');
      selects.forEach(function(select) {
        select.addEventListener('change', function() {
          var selectedVal = select.value;
          var optIndex = select.getAttribute('data-option-index');

          var nativeSelect = document.getElementById('jj-native-select-' + optIndex);
          if (nativeSelect) {
            nativeSelect.value = selectedVal;
            nativeSelect.dispatchEvent(new Event('change', { bubbles: true }));
          }

          var fieldset = select.closest('.jj-option-fieldset');
          if (fieldset) {
            var pillGroup = fieldset.querySelector('.jj-pills-hidden');
            if (pillGroup) {
              var pills = pillGroup.querySelectorAll('.button-2.w-commerce-commerceaddtocartoptionpill');
              pills.forEach(function(pill) {
                var text = (pill.textContent || '').trim();
                if (text === selectedVal) {
                  pill.click();
                }
              });
            }
          }
        });
      });
    }

    // ── WEBFLOW TABS ───────────────────────────────────────────────
    function initWebflowTabs() {
      var tabLinks = document.querySelectorAll('.tabs .w-tab-link');
      var tabPanes = document.querySelectorAll('.tabs .w-tab-pane');
      tabLinks.forEach(function(link) {
        link.addEventListener('click', function(e) {
          e.preventDefault();
          var tabName = link.getAttribute('data-w-tab');
          tabLinks.forEach(function(l) { l.classList.remove('w--current'); });
          tabPanes.forEach(function(p) { p.classList.remove('w--tab-active'); });
          link.classList.add('w--current');
          var targetPane = document.querySelector('.tabs .w-tab-pane[data-w-tab="' + tabName + '"]');
          if (targetPane) targetPane.classList.add('w--tab-active');
        });
      });
    }

    // ── IOS SLIDE-UP CONTACT DRAWER & AI CHAT CONNECTION ───────────
    var drawer = document.getElementById('jj-contact-drawer');
    var drawerOverlay = document.getElementById('jj-drawer-overlay');
    var drawerClose = document.getElementById('jj-drawer-close');
    var drawerForm = document.getElementById('jj-drawer-form');

    function openContactDrawer() {
      var dOverlay = document.getElementById('jj-drawer-overlay');
      var dDrawer = document.getElementById('jj-contact-drawer');
      if (dOverlay && dDrawer) {
        dOverlay.classList.add('open');
        dDrawer.classList.add('open');
        document.body.style.overflow = 'hidden';
      }
    }

    function closeContactDrawer() {
      var dOverlay = document.getElementById('jj-drawer-overlay');
      var dDrawer = document.getElementById('jj-contact-drawer');
      if (dOverlay && dDrawer) {
        dOverlay.classList.remove('open');
        dDrawer.classList.remove('open');
        document.body.style.overflow = '';
      }
    }

    document.addEventListener('click', function(e) {
      var askBtn = e.target.closest('#jj-ask-btn, .jj-ask-question-btn');
      if (askBtn) {
        e.preventDefault();
        openContactDrawer();
      }
    });

    if (drawerClose) drawerClose.addEventListener('click', closeContactDrawer);
    if (drawerOverlay) drawerOverlay.addEventListener('click', closeContactDrawer);

    if (drawerForm) {
      drawerForm.addEventListener('submit', function(e) {
        e.preventDefault();
        e.stopPropagation();

        var submitBtn = drawerForm.querySelector('.jj-drawer-submit');
        var successMsg = document.getElementById('jj-drawer-success');
        var errorMsg = document.getElementById('jj-drawer-error');

        var name = document.getElementById('drawer-name').value.trim();
        var email = document.getElementById('drawer-email').value.trim();
        var message = document.getElementById('drawer-message').value.trim();
        var reason = document.getElementById('drawer-reason').value;

        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.textContent = 'Sending...';
        }
        if (successMsg) successMsg.style.display = 'none';
        if (errorMsg) errorMsg.style.display = 'none';

        setTimeout(function() {
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = 'Send Message';
          }
          if (successMsg) {
            successMsg.style.display = 'block';
          }
          
          setTimeout(function() {
            closeContactDrawer();
            drawerForm.reset();
            if (successMsg) successMsg.style.display = 'none';
            
            if (window.jjAIChat && typeof window.jjAIChat.sendMessage === 'function') {
              var fullQuery = "I have a question about " + {{ product.title | json }} + " (" + reason + "): \"" + message + "\"";
              window.jjAIChat.sendMessage(fullQuery);
              
              setTimeout(function() {
                var disclaimerMsg = "Customer service will also review your question and respond to your email (" + email + ") within 24 hours if needed.";
                window.jjAIChat.appendSystemMessage(disclaimerMsg);
              }, 1500);
            }
          }, 800);
        }, 600);
      });
    }

    // ── ADD TO CART AJAX ENGINE (PREVENTS PAGE RELOAD & OPENS DRAWER) ──
    function initAddToCart() {
      document.addEventListener('submit', function(e) {
        var form = e.target.closest('form[action^="/cart/add"], .w-commerce-commerceaddtocartform');
        if (!form) return;

        e.preventDefault();
        e.stopPropagation();
        if (typeof e.stopImmediatePropagation === 'function') e.stopImmediatePropagation();

        var selectEl = form.querySelector('.jj-styled-select');
        var selectedVal = selectEl ? selectEl.value : null;

        var variantId = null;
        var variantIdInput = form.querySelector('[name="id"]');
        if (variantIdInput && variantIdInput.value) {
          variantId = variantIdInput.value;
        }

        if (!variantId && selectedVal && currentProduct && currentProduct.variants) {
          var match = currentProduct.variants.find(function(v) {
            return v.options.includes(selectedVal) || v.title.includes(selectedVal);
          });
          if (match) variantId = match.id;
        }

        if (!variantId && currentProduct && currentProduct.selectedVariantId) {
          variantId = currentProduct.selectedVariantId;
        }

        if (!variantId) {
          alert('Please select a size / variant option.');
          return;
        }

        var submitBtn = form.querySelector('[type="submit"], .add-to-cart-button');
        if (submitBtn) {
          submitBtn.disabled = true;
          if (submitBtn.value) submitBtn.value = 'Adding...';
          else submitBtn.textContent = 'Adding...';
        }

        fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ items: [{ id: parseInt(variantId, 10), quantity: 1 }] })
        })
        .then(function(res) { return res.json(); })
        .then(function(data) {
          if (submitBtn) {
            submitBtn.disabled = false;
            if (submitBtn.value) submitBtn.value = 'Added!';
            else submitBtn.textContent = 'Added!';
            setTimeout(function() {
              if (submitBtn.value) submitBtn.value = 'Add to Cart';
              else submitBtn.textContent = 'Add to Cart';
            }, 2000);
          }
          fetch('/cart.js')
            .then(function(r) { return r.json(); })
            .then(function(cartData) {
              var countEl = document.querySelector('.w-commerce-commercecartopenlinkcount, .cart-quantity');
              if (countEl) countEl.textContent = cartData.item_count;
              var flashDot = document.querySelector('.cart-flash-dot');
              if (flashDot) flashDot.style.display = cartData.item_count > 0 ? 'block' : 'none';
            });

          var cartLink = document.querySelector('.w-commerce-commercecartopenlink, [data-node-type="commerce-cart-open-link"]');
          if (cartLink) {
            cartLink.click();
          }
          if (typeof window.Udesly !== 'undefined') {
            window.Udesly.dispatch('product-added', true);
          }
        })
        .catch(function(err) {
          if (submitBtn) {
            submitBtn.disabled = false;
            if (submitBtn.value) submitBtn.value = 'Add to Cart';
            else submitBtn.textContent = 'Add to Cart';
          }
          console.error('Add to Cart error:', err);
        });
      }, true);
    }

    // ── FIT CURATOR WIDGET ─────────────────────────────────────────
    function initFitCurator() {
      var container = document.getElementById('jj-canvas-container');
      var listContainer = document.getElementById('jj-curator-items-list');
      var subtotalEl = document.getElementById('jj-bundle-subtotal');
      var totalEl = document.getElementById('jj-bundle-total');
      var addBtn = document.getElementById('jj-add-bundle-btn');
      var loadingEl = document.getElementById('jj-curator-loading');
      
      if (!container || !listContainer) return;

      var typeLower = (currentProduct.type || '').toLowerCase();
      var titleLower = currentProduct.title.toLowerCase();
      var isCurrentProductShirt = typeLower.includes('shirt') || typeLower.includes('tee') || titleLower.includes('shirt') || titleLower.includes('tee');
      
      var currentCat = 'shoes';
      if (typeLower.includes('hoodie') || typeLower.includes('jacket') || typeLower.includes('sweater') || typeLower.includes('tee') || typeLower.includes('shirt') || typeLower.includes('top') || titleLower.includes('hoodie') || titleLower.includes('tee') || titleLower.includes('shirt')) {
        currentCat = 'top';
      } else if (typeLower.includes('pant') || typeLower.includes('jean') || typeLower.includes('short') || typeLower.includes('sweatpant') || typeLower.includes('bottom') || titleLower.includes('pant') || titleLower.includes('jean') || titleLower.includes('short')) {
        currentCat = 'bottom';
      }

      fetch('/products.json?limit=250')
        .then(function(res) { return res.json(); })
        .then(function(data) {
          var products = data.products || [];
          
          var tops = [], bottoms = [], shoes = [];
          products.forEach(function(p) {
            if (p.id === currentProduct.id) return;
            var hasStock = p.variants && p.variants.some(function(v) { return v.available !== false; });
            if (!hasStock) return;
            if (p.handle.indexOf('insurance') !== -1 || p.title.indexOf('Insurance') !== -1) return;

            var t = (p.product_type || '').toLowerCase();
            var tit = p.title.toLowerCase();
            var combo = t + ' ' + tit;

            if (/pant|jean|short|sweat|bottom|trouser|camo|cargo|denim|trackpant|boxer|tight/i.test(combo)) {
              bottoms.push(p);
            } else if (/sneaker|shoe|boot|slide|runner|foam|kicks|dunk|jordan|yeezy|forum|og|low|high|mid|550|990|trainer|clog|sandal/i.test(combo)) {
              shoes.push(p);
            } else {
              if (isCurrentProductShirt && /hoodie|jacket|coat|parka|windbreaker/i.test(combo)) {
              } else {
                tops.push(p);
              }
            }
          });

          if (tops.length === 0) tops = products.slice(0, 10);
          if (bottoms.length === 0) bottoms = products.slice(10, 20);
          if (shoes.length === 0) shoes = products.slice(20, 30);

          function shuffleArray(arr) {
            for (var i = arr.length - 1; i > 0; i--) {
              var j = Math.floor(Math.random() * (i + 1));
              var temp = arr[i];
              arr[i] = arr[j];
              arr[j] = temp;
            }
          }
          shuffleArray(tops);
          shuffleArray(bottoms);
          shuffleArray(shoes);

          var outfit = [];
          outfit.push({
            product: currentProduct,
            isCurrent: true,
            selectedVariantId: currentProduct.selectedVariantId,
            price: currentProduct.price / 100,
            removed: false
          });

          var randB = bottoms.length > 0 ? Math.floor(Math.random() * bottoms.length) : 0;
          var randS = shoes.length > 0 ? Math.floor(Math.random() * shoes.length) : 0;
          var randT = tops.length > 0 ? Math.floor(Math.random() * tops.length) : 0;

          if (currentCat === 'top') {
            outfit.push({ catalog: bottoms, index: randB, price: 0, removed: false });
            outfit.push({ catalog: shoes, index: randS, price: 0, removed: false });
          } else if (currentCat === 'bottom') {
            outfit.push({ catalog: tops, index: randT, price: 0, removed: false });
            outfit.push({ catalog: shoes, index: randS, price: 0, removed: false });
          } else {
            outfit.push({ catalog: tops, index: randT, price: 0, removed: false });
            outfit.push({ catalog: bottoms, index: randB, price: 0, removed: false });
          }

          if (loadingEl) loadingEl.remove();

          renderOutfit();

          function renderOutfit() {
            container.innerHTML = '';
            listContainer.innerHTML = '';
            var subtotal = 0;
            var activeCount = 0;

            outfit.forEach(function(item, idx) {
              var p = item.isCurrent ? item.product : item.catalog[item.index];
              var priceVal = item.isCurrent ? item.price : parseFloat(p.variants[0].price);
              
              if (!item.isCurrent && !item.selectedVariantId) {
                var firstAvail = p.variants.find(function(v) { return v.available !== false; });
                item.selectedVariantId = firstAvail ? firstAvail.id : p.variants[0].id;
                item.price = parseFloat(firstAvail ? firstAvail.price : p.variants[0].price);
              }
              
              if (!item.removed) {
                priceVal = item.price || priceVal;
                subtotal += priceVal;
                activeCount++;
              }

              var imgUrl = item.isCurrent ? p.featured_image : (p.images && p.images.length > 0 ? (p.images[0].src || p.images[0]) : '');
              var title = p.title;

              if (!item.removed) {
                var card = document.createElement('div');
                card.className = 'jj-flat-card';
                var isMobile = window.innerWidth < 768;
                if (isMobile) {
                  var cW = container.clientWidth || 340;
                  var centerX = cW / 2;
                  if (idx === 0) {
                    card.style.left = Math.max(10, centerX - 120) + 'px';
                    card.style.top = '15px';
                  } else if (idx === 1) {
                    card.style.left = Math.max(10, centerX - 35) + 'px';
                    card.style.top = '115px';
                  } else {
                    card.style.left = Math.min(cW - 135, centerX + 15) + 'px';
                    card.style.top = '30px';
                  }
                } else {
                  card.style.left = (30 + idx * 210) + 'px';
                  card.style.top = (80 + (idx % 2) * 40) + 'px';
                }
                
                var refreshHtml = '<div class="jj-flat-card-refresh" data-index="' + idx + '" title="Cycle Item">↻</div>';

                card.innerHTML = 
                  refreshHtml +
                  '<div class="jj-flat-card-img"><img src="' + imgUrl + '" alt="' + title + '" draggable="false"></div>' +
                  '<div class="jj-flat-card-title">' + title + '</div>';

                container.appendChild(card);
                makeDraggable(card, container);

                var refreshEl = card.querySelector('.jj-flat-card-refresh');
                if (refreshEl) {
                  var handleRefresh = function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    if (item.isCurrent) {
                      if (item.product && item.product.variants && item.product.variants.length > 1) {
                        var currIdx = item.product.variants.findIndex(function(v) { return v.id == item.selectedVariantId; });
                        var nextV = item.product.variants[(currIdx + 1) % item.product.variants.length];
                        item.selectedVariantId = nextV.id;
                        item.price = nextV.price / 100;
                      }
                    } else if (item.catalog && item.catalog.length > 0) {
                      item.index = (item.index + 1) % item.catalog.length;
                      item.selectedVariantId = null;
                    }
                    renderOutfit();
                  };
                  refreshEl.addEventListener('click', handleRefresh);
                  refreshEl.addEventListener('touchstart', handleRefresh, { passive: false });
                }
              }

              var itemRow = document.createElement('div');
              itemRow.className = 'jj-details-row';
              itemRow.style.display = 'flex';
              itemRow.style.alignItems = 'center';
              itemRow.style.justifyContent = 'space-between';
              itemRow.style.gap = '10px';
              itemRow.style.borderBottom = '1px solid #1a1a1a';
              itemRow.style.paddingBottom = '10px';
              itemRow.style.marginBottom = '10px';

              if (item.removed) {
                itemRow.style.opacity = '0.5';
                itemRow.innerHTML = 
                  '<div style="display:flex; align-items:center; gap:8px;">' +
                  '  <span class="jj-add-back-item" data-index="' + idx + '" style="color:#22c55e; font-size:18px; font-weight:800; cursor:pointer;" title="Add back to outfit">+</span>' +
                  '  <span style="font-size:11px; color:#888; text-decoration:line-through; text-transform:uppercase;">' + title + '</span>' +
                  '</div>' +
                  '<span style="font-size:10px; color:#555; text-transform:uppercase;">Removed</span>';
                
                listContainer.appendChild(itemRow);
                
                var addBackEl = itemRow.querySelector('.jj-add-back-item');
                if (addBackEl) {
                  addBackEl.addEventListener('click', function() {
                    item.removed = false;
                    renderOutfit();
                  });
                }
              } else {
                var removeHtml = '';
                if (!item.isCurrent) {
                  removeHtml = '<span class="jj-remove-item" data-index="' + idx + '" style="color:#ff3b30; font-size:18px; font-weight:800; cursor:pointer;" title="Remove from outfit">×</span>';
                } else {
                  removeHtml = '<span style="width:14px; display:inline-block;"></span>';
                }

                var selectHtml = '';
                if (!item.isCurrent) {
                  selectHtml = '<select class="jj-details-select" style="background:#111; border:1px solid #333; color:#fff; font-size:10px; padding:4px 6px; border-radius:4px; outline:none; cursor:pointer; font-family:inherit; max-width:80px;">';
                  p.variants.forEach(function(v) {
                    var sel = (v.id.toString() === (item.selectedVariantId || '').toString()) ? 'selected' : '';
                    selectHtml += '<option value="' + v.id + '" data-price="' + v.price + '" ' + sel + '>' + v.title + '</option>';
                  });
                  selectHtml += '</select>';
                } else {
                  selectHtml = '<span style="font-size:10px; color:#888; text-transform:uppercase; font-weight:700;">Active Size</span>';
                }

                var addSingleBtnHtml = '';
                if (!item.isCurrent) {
                  addSingleBtnHtml = '<button class="jj-details-add-item-btn" style="background:#fff; color:#000; font-size:9px; font-weight:800; border:none; padding:4px 8px; border-radius:4px; cursor:pointer; text-transform:uppercase;">ADD</button>';
                }

                itemRow.innerHTML = 
                  '<div style="display:flex; align-items:center; gap:8px; flex-grow:1; min-width:0;">' +
                     removeHtml +
                  '  <img src="' + imgUrl + '" style="width:32px; height:32px; object-fit:contain; border-radius:4px; background:#fff; flex-shrink:0;">' +
                  '  <div style="min-width:0; flex-grow:1;">' +
                  '    <div style="font-size:11px; color:#fff; font-weight:700; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; text-transform:uppercase; letter-spacing:0.5px;">' + title + '</div>' +
                  '    <div style="font-size:10px; color:#888;">$' + priceVal.toFixed(2).replace('.00','') + '</div>' +
                  '  </div>' +
                  '</div>' +
                  '<div style="display:flex; align-items:center; gap:8px;">' +
                     selectHtml +
                     addSingleBtnHtml +
                  '</div>';

                listContainer.appendChild(itemRow);

                if (!item.isCurrent) {
                  var removeEl = itemRow.querySelector('.jj-remove-item');
                  if (removeEl) {
                    removeEl.addEventListener('click', function() {
                      item.removed = true;
                      renderOutfit();
                    });
                  }

                  var selectEl = itemRow.querySelector('.jj-details-select');
                  if (selectEl) {
                    selectEl.addEventListener('change', function() {
                      item.selectedVariantId = selectEl.value;
                      var opt = selectEl.options[selectEl.selectedIndex];
                      item.price = parseFloat(opt.getAttribute('data-price'));
                      updateTotals();
                    });
                  }

                  var addSingleBtn = itemRow.querySelector('.jj-details-add-item-btn');
                  if (addSingleBtn) {
                    addSingleBtn.addEventListener('click', function() {
                      addSingleBtn.disabled = true;
                      addSingleBtn.textContent = 'ADDING...';

                      var payload = {
                        id: parseInt(item.selectedVariantId, 10),
                        quantity: 1
                      };

                      fetch('/cart/add.js', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                      })
                      .then(function(res) { return res.json(); })
                      .then(function(data) {
                        addSingleBtn.disabled = false;
                        addSingleBtn.textContent = 'ADDED!';
                        setTimeout(function() { addSingleBtn.textContent = 'ADD'; }, 2000);

                        fetch('/cart.js')
                          .then(function(r) { return r.json(); })
                          .then(function(cartData) {
                            var countEl = document.querySelector('.w-commerce-commercecartopenlinkcount, .cart-quantity');
                            if (countEl) countEl.textContent = cartData.item_count;
                            var flashDot = document.querySelector('.cart-flash-dot');
                            if (flashDot) flashDot.style.display = cartData.item_count > 0 ? 'block' : 'none';
                          });

                        var cartLink = document.querySelector('.w-commerce-commercecartopenlink, [data-node-type="commerce-cart-open-link"]');
                        if (cartLink) {
                          cartLink.click();
                        }
                      })
                      .catch(function(err) {
                        addSingleBtn.disabled = false;
                        addSingleBtn.textContent = 'ADD';
                        console.error('Failed to add item:', err);
                      });
                    });
                  }
                }
              }
            });

            function updateTotals() {
              var newSub = 0;
              var newActive = 0;
              outfit.forEach(function(item) {
                if (!item.removed) {
                  newSub += item.price;
                  newActive++;
                }
              });
              subtotal = newSub;
              activeCount = newActive;
              subtotalEl.textContent = '$' + subtotal.toFixed(2);
              
              var discount = activeCount >= 2 ? 25 : 0;
              var discountEl = document.getElementById('jj-bundle-discount-row');
              if (discountEl) {
                discountEl.style.display = discount > 0 ? 'flex' : 'none';
              }
              
              var total = Math.max(0, subtotal - discount);
              totalEl.textContent = '$' + total.toFixed(2);
            }

            updateTotals();
          }

          function makeDraggable(el, container) {
            var isDragging = false;
            var offsetX = 0, offsetY = 0;
            
            el.addEventListener('mousedown', function(e) {
              if (e.target.closest('.jj-flat-card-refresh')) return;
              isDragging = true;
              offsetX = e.clientX - el.offsetLeft;
              offsetY = e.clientY - el.offsetTop;
              el.style.zIndex = 100;
              container.querySelectorAll('.jj-flat-card').forEach(function(c) {
                if (c !== el) c.style.zIndex = 10;
              });
            });
            
            document.addEventListener('mousemove', function(e) {
              if (!isDragging) return;
              var left = e.clientX - offsetX;
              var top = e.clientY - offsetY;
              var maxLeft = container.clientWidth - el.clientWidth;
              var maxTop = container.clientHeight - el.clientHeight;
              
              el.style.left = Math.max(0, Math.min(maxLeft, left)) + 'px';
              el.style.top = Math.max(0, Math.min(maxTop, top)) + 'px';
            });
            
            document.addEventListener('mouseup', function() {
              if (isDragging) {
                isDragging = false;
                el.style.zIndex = 15;
              }
            });

            el.addEventListener('touchstart', function(e) {
              if (e.target.closest('.jj-flat-card-refresh')) return;
              isDragging = true;
              var touch = e.touches[0];
              offsetX = touch.clientX - el.offsetLeft;
              offsetY = touch.clientY - el.offsetTop;
              el.style.zIndex = 100;
            }, { passive: true });

            document.addEventListener('touchmove', function(e) {
              if (!isDragging) return;
              var touch = e.touches[0];
              var left = touch.clientX - offsetX;
              var top = touch.clientY - offsetY;
              var maxLeft = container.clientWidth - el.clientWidth;
              var maxTop = container.clientHeight - el.clientHeight;
              
              el.style.left = Math.max(0, Math.min(maxLeft, left)) + 'px';
              el.style.top = Math.max(0, Math.min(maxTop, top)) + 'px';
            }, { passive: true });

            document.addEventListener('touchend', function() {
              if (isDragging) {
                isDragging = false;
                el.style.zIndex = 15;
              }
            });
          }

          if (addBtn) {
            addBtn.addEventListener('click', function() {
              addBtn.disabled = true;
              addBtn.textContent = 'Adding Bundle...';

              var itemsToAdd = [];
              outfit.forEach(function(item) {
                if (!item.removed && item.selectedVariantId) {
                  itemsToAdd.push({
                    id: parseInt(item.selectedVariantId, 10),
                    quantity: 1
                  });
                }
              });

              if (itemsToAdd.length === 0) {
                addBtn.disabled = false;
                addBtn.textContent = 'Add Outfit to Cart';
                return;
              }

              fetch('/cart/add.js', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ items: itemsToAdd })
              })
              .then(function(res) { return res.json(); })
              .then(function(data) {
                addBtn.disabled = false;
                addBtn.textContent = 'Outfit Added!';
                setTimeout(function() { addBtn.textContent = 'Add Outfit to Cart'; }, 2000);

                fetch('/cart.js')
                  .then(function(r) { return r.json(); })
                  .then(function(cartData) {
                    var countEl = document.querySelector('.w-commerce-commercecartopenlinkcount, .cart-quantity');
                    if (countEl) countEl.textContent = cartData.item_count;
                    var flashDot = document.querySelector('.cart-flash-dot');
                    if (flashDot) flashDot.style.display = cartData.item_count > 0 ? 'block' : 'none';
                  });

                var cartLink = document.querySelector('.w-commerce-commercecartopenlink, [data-node-type="commerce-cart-open-link"]');
                if (cartLink) {
                  cartLink.click();
                }
              })
              .catch(function(err) {
                addBtn.disabled = false;
                addBtn.textContent = 'Add Outfit to Cart';
                console.error('Failed to add bundle to cart:', err);
              });
            });
          }

        })
        .catch(function(err) {
          console.error('[FitCurator] Failed to fetch catalog:', err);
          if (loadingEl) loadingEl.textContent = 'Could not load outfit curator.';
        });
    }

    // ── MASTER INITIALIZER ─────────────────────────────────────────
    function initAllProductFeatures() {
      initThumbnailClicks();
      initDots();
      initVariantDropdowns();
      initWebflowTabs();
      initDesktopHoverZoom();
      initFitCurator();
      initAddToCart();
    }

    if (document.readyState !== 'loading') {
      initAllProductFeatures();
    } else {
      document.addEventListener('DOMContentLoaded', initAllProductFeatures);
    }
    window.addEventListener('load', initAllProductFeatures);
  })();
</script>

