  /* ── MARQUEE INNER STYLES ─────────────────────────────────────── */
  .jj-marquee-wrapper {
    width: 100%;
    height: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
  }
  .jj-centered-mask {
    width: 60%;
    max-width: 800px;
    height: 100%;
    overflow: hidden;
    display: flex;
    align-items: center;
    mask-image: linear-gradient(to right, transparent 0%, black 15%, black 85%, transparent 100%);
    -webkit-mask-image: linear-gradient(to right, transparent 0%, black 15%, black 85%, transparent 100%);
  }
  .jj-marquee-track {
    display: flex;
    align-items: center;
    width: max-content;
    flex-shrink: 0;
    animation: promo-scroll 25s linear infinite;
  }
  .jj-content-group {
    display: flex;
    align-items: center;
    padding-right: 6rem;
  }
  .jj-text-item {
    font-size: inherit;
    color: inherit;
    font-weight: inherit;
    white-space: nowrap;
    margin-right: 4rem;
  }
  .jj-text-item:last-child { margin-right: 0; }
  @keyframes promo-scroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
  @media (max-width: 767px) {
    .jj-marquee-track { animation-duration: 20s; }
    .jj-centered-mask { width: 90%; }
    .jj-content-group { padding-right: 3rem; }
    .jj-text-item { margin-right: 2rem; }
  }
</style>

