        <style>
  /* --- 1. OUTER WRAPPER (Full Width) --- */
  .jj-marquee-wrapper {
    width: 100%;
    height: 100%;
    display: flex;
    justify-content: center; /* Forces the marquee to the center */
    align-items: center;
    position: relative;
    border-top: 1px solid #2e2e2e;
    border-bottom: 1px solid #2e2e2e;
  }
  /* --- 2. THE CENTERED VISIBLE AREA (Restricted Width) --- */
  .jj-centered-mask {
    /* VISIBILITY CONTROLS */
    width: 60%; /* Only show text in the middle 60% of the parent */
    max-width: 800px; /* Optional cap so it doesn't get too wide on giant screens */
    height: 100%;
    overflow: hidden;
    display: flex;
    align-items: center;
    /* FADE MASK: Soft edges on the constrained area */
    mask-image: linear-gradient(to right, transparent 0%, black 15%, black 85%, transparent 100%);
    -webkit-mask-image: linear-gradient(to right, transparent 0%, black 15%, black 85%, transparent 100%);
  }
  /* --- 3. THE SCROLLING TRACK --- */
  .jj-marquee-track {
    display: flex;
    align-items: center;
    width: max-content;
    flex-shrink: 0;
    /* EDITED: Slower Speed (25s) */
    animation: promo-scroll 25s linear infinite;
  }
  /* --- CONTENT GROUPS --- */
  .jj-content-group {
    display: flex;
    align-items: center;
    /* This padding pushes the next duplicate away */
    padding-right: 6rem; 
  }
  /* --- TEXT STYLING --- */
  .jj-text-item {
    font-size: inherit; 
    color: inherit; 
    font-weight: inherit;
    white-space: nowrap;
    margin-right: 4rem; /* Gap between statements */
  }
  .jj-text-item:last-child { margin-right: 0; }
  /* --- ANIMATION --- */
  @keyframes promo-scroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); } 
  }
  /* --- MOBILE --- */
  @media (max-width: 767px) {
    /* EDITED: Slower Mobile Speed (20s) */
    .jj-marquee-track { animation-duration: 20s; } 
    /* Make it wider on phones so it's readable */
    .jj-centered-mask { width: 90%; }
    .jj-content-group { padding-right: 3rem; }
    .jj-text-item { margin-right: 2rem; }
  }
</style>
