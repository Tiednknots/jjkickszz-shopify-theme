                          <div data-node-type="add-to-cart-option-pill-group" class="button-group w-commerce-commerceaddtocartoptionpillgroup jj-pills-hidden" aria-label="{{ "option" | append: forloop.index }}" aria-hidden="true">
                            {%- for value in option.values -%}
                              {%- assign is_available = false -%}
                              {%- for variant in product.variants -%}
                                {%- if variant.options contains value -%}
                                  {%- if variant.available -%}{%- assign is_available = true -%}{%- endif -%}
                                {%- endif -%}
                              {%- endfor -%}
                              <div data-node-type="add-to-cart-option-pill" class="button-2 w-commerce-commerceaddtocartoptionpill{% unless is_available %} jj-pill-sold-out{% endunless %}" data-option-name="{{ value | handle }}">
