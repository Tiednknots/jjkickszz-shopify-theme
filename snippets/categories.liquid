{% comment %}
  Shop By Brand — Dedicated Isolated Component
{% endcomment %}

{%- assign all_col = collections['all'] -%}
{%- if all_col == nil or all_col.products_count == 0 -%}
  {%- assign all_col = collections['all-products'] -%}
{%- endif -%}
{%- if all_col == nil or all_col.products_count == 0 -%}
  {%- assign all_col = collections['frontpage'] -%}
{%- endif -%}

{% capture listItems %}
{% for _ven in shop.vendors %}
  {%- assign _ven_handle = _ven | handleize -%}
  {%- assign _ven_col = collections[_ven_handle] -%}
  {%- assign _img_url = '' -%}
  {%- assign _prod_count = 0 -%}

  {%- if _ven_col == blank or _ven_col.products_count == 0 -%}
    {%- if _ven_handle == 'roughplay' -%}
      {%- assign _ven_col = collections['rough-play'] -%}
    {%- elsif _ven_handle == 'rough-play' -%}
      {%- assign _ven_col = collections['roughplay'] -%}
    {%- endif -%}
  {%- endif -%}

  {%- if _ven_col != blank and _ven_col.products_count > 0 -%}
    {%- assign _prod_count = _ven_col.products_count -%}
    {%- if _ven_col.image != blank -%}
      {%- assign _img_url = _ven_col.image | img_url: '600x' -%}
    {%- elsif _ven_col.products.first.featured_image != blank -%}
      {%- assign _img_url = _ven_col.products.first.featured_image | img_url: '600x' -%}
    {%- endif -%}
  {%- endif -%}

  {%- if _img_url == '' or _prod_count == 0 -%}
    {%- paginate all_col.products by 250 -%}
      {%- for _p in all_col.products -%}
        {%- if _p.vendor == _ven -%}
          {%- if _img_url == '' and _p.featured_image != blank -%}
            {%- assign _img_url = _p.featured_image | img_url: '600x' -%}
          {%- endif -%}
          {%- assign _prod_count = _prod_count | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endpaginate -%}
  {%- endif -%}

  <div role="listitem" class="jj-brand-card-item" data-vendor="{{ _ven | escape }}">
    <a href="{{ pages['shop'].url | default: '/collections/all' }}?vendor={{ _ven | url_escape }}" class="jj-brand-card-link">
      <div class="jj-brand-card-inner">
        <div class="jj-brand-card-title">{{ _ven }}</div>
        <div class="jj-brand-card-count">
          {{ _prod_count }} {% if _prod_count == 1 %}Product{% else %}Products{% endif %}
        </div>
        {%- if _img_url != '' -%}
          <img src="{{ _img_url }}" alt="{{ _ven }}" loading="lazy" class="jj-brand-card-img">
        {%- endif -%}
        <div class="jj-brand-card-overlay"></div>
      </div>
    </a>
  </div>
{% endfor %}
{% endcapture %}
{% assign items_length = listItems | strip | size %}

<div class="jj-brand-slider-wrap">
  {%- unless items_length == 0 -%}
    <div role="list" class="jj-brand-slider-list contents-of-scroll">
      {{ listItems }}
    </div>
  {%- endunless -%}
  {%- if items_length == 0 -%}
    <div class="w-dyn-empty"><div>No brands found.</div></div>
  {%- endif -%}
</div>
