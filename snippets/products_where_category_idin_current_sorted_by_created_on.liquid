{% paginate collection.products by 48 %}
{% capture listItems %}
{%- for item in collection.products -%}
 <div role="listitem" class="collection-item-2 margin w-dyn-item" data-vendor="{{ item.vendor | escape }}">
                    <a href="{{ item.url }}" class="link-block-2 w-inline-block">
                      {%- assign _is_sold_out = true -%}
                      {%- assign _avail_count = 0 -%}
                      {%- capture _sizes_rendered -%}
                        {%- for _sv in item.variants -%}
                          {%- if _sv.inventory_quantity > 0 or _sv.inventory_policy == 'continue' -%}
                            {%- assign _is_sold_out = false -%}
                            {%- assign _avail_count = _avail_count | plus: 1 -%}
                            {%- assign _sl = _sv.title | strip -%}
                            {%- assign _sl_down = _sl | downcase -%}
                            {%- if _sl_down contains 'xxxl' or _sl_down contains '3xl' -%}{%- assign _sl = '3XL' -%}
                            {%- elsif _sl_down contains 'xxl' or _sl_down contains '2xl' or _sl_down contains 'xx-large' or _sl_down contains 'xx large' or _sl_down == 'xxlarge' -%}{%- assign _sl = 'XXL' -%}
                            {%- elsif _sl_down contains 'xl' or _sl_down contains 'x-large' or _sl_down contains 'x large' or _sl_down contains 'xlarge' -%}{%- assign _sl = 'XL' -%}
                            {%- elsif _sl_down contains 'small' or _sl_down == 's' -%}{%- assign _sl = 'S' -%}
                            {%- elsif _sl_down contains 'medium' or _sl_down == 'm' -%}{%- assign _sl = 'M' -%}
                            {%- elsif _sl_down contains 'large' or _sl_down == 'l' -%}{%- assign _sl = 'L' -%}
                            {%- elsif _sl_down contains 'one size' or _sl_down contains 'onesize' or _sl_down contains 'osfm' or _sl_down contains 'os' -%}{%- assign _sl = 'O/S' -%}
                            {%- endif -%}
                            <div class="text-block-4 asd sizes-variants">{{ _sl }}</div>
                          {%- endif -%}
                        {%- endfor -%}
                      {%- endcapture -%}
                      <div class="div-block-15 {% unless item.available %}jj-sold-out-card{% endunless %}"><img loading="lazy" src="{{ item.featured_image | img_url: '600x' }}" alt="{{ item.featured_image.alt | default: item.title }}" class="image-6" data-commerce-type="variation-image" srcset="{{ item.featured_image | img_url: '600x' }} 600w, {{ item.featured_image | img_url: '1024x' }} 1024w">
                        <div class="link-overlay bs">{{ item.vendor }}</div>
                        {%- if _is_sold_out -%}<div class="sold-out-label">
                          <div class="div-block-1167">
                            <div class="text-block-793">Sold Out</div>
                          </div>
                        </div>{%- endif -%}
                      {%- unless item.available -%}<div class="jj-sold-out-badge">SOLD OUT</div>{%- endunless -%}</div>
                      <div class="text-block-4 title">{{ item.title }}</div>
                      <div data-commerce-type="variation-price" class="text-block-779">{{ item.price | money }}</div>
                      <div class="div-block-1163">
                        <div class="text-block-4 asd">Sizes :</div>
                        <div class="size-contents">
                          {%- if _avail_count > 3 -%}
                            <div class="text-block-4 asd sizes-variants">Multiple Sizes</div>
                          {%- else -%}
                            {{ _sizes_rendered }}
                          {%- endif -%}
                        </div>
                      </div>

{%- capture _jj_meta -%}{{ item.vendor }}|{{ item.product_type }}|{{ item.tags | join: "|" }}|{{ item.price | money_without_trailing_zeros }}|{{ item.price_min | money_without_trailing_zeros }}|{{ item.price_max | money_without_trailing_zeros }}{%- for _v in item.variants -%}|{{ _v.title }}{%- endfor -%}{%- for _opt in item.options_with_values -%}{%- for _val in _opt.values -%}|{{ _val }}{%- endfor -%}{%- endfor -%}{%- endcapture -%}<span class="jj-search-meta" aria-hidden="true" style="display:none;position:absolute;width:1px;height:1px;overflow:hidden;">{{ _jj_meta }}</span>                    </a>
                  </div>
{%- endfor -%}
{% endcapture %}
{% assign items_length = listItems | strip | size %}

<div class="collection-list-wrapper w-dyn-list" udy-collection="product">
                {%- unless items_length == 0 -%}<div role="list" class="collection-list-2 shop w-dyn-items">
                  {{ listItems }}
                </div>
                {%- if paginate.pages > 1 -%}
                  <div class="jj-pagination-container" style="display: flex; justify-content: center; align-items: center; gap: 8px; margin: 40px 0 20px 0; width: 100%; font-family: 'Inter', sans-serif;">
                    {%- if paginate.previous -%}
                      <a href="{{ paginate.previous.url }}" class="jj-page-link jj-page-prev" style="padding: 10px 18px; background: #141414; border: 1px solid #2e2e2e; color: #ffffff; text-decoration: none; border-radius: 4px; font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; transition: all 0.2s ease;">
                        ← Previous
                      </a>
                    {%- endif -%}
                    {%- for part in paginate.parts -%}
                      {%- if part.is_link -%}
                        <a href="{{ part.url }}" class="jj-page-link" style="padding: 8px 14px; background: #141414; border: 1px solid #2e2e2e; color: rgba(255,255,255,0.7); text-decoration: none; border-radius: 4px; font-size: 13px; font-weight: 600; transition: all 0.2s ease;">
                          {{ part.title }}
                        </a>
                      {%- else -%}
                        {%- if part.title == paginate.current_page -%}
                          <span class="jj-page-link jj-page-active" style="padding: 8px 14px; background: #c60000; border: 1px solid #c60000; color: #ffffff; border-radius: 4px; font-size: 13px; font-weight: 700;">
                            {{ part.title }}
                          </span>
                        {%- else -%}
                          <span class="jj-page-link jj-page-dots" style="padding: 8px 10px; color: rgba(255,255,255,0.4); font-size: 13px;">
                            {{ part.title }}
                          </span>
                        {%- endif -%}
                      {%- endif -%}
                    {%- endfor -%}
                    {%- if paginate.next -%}
                      <a href="{{ paginate.next.url }}" class="jj-page-link jj-page-next" style="padding: 10px 18px; background: #141414; border: 1px solid #2e2e2e; color: #ffffff; text-decoration: none; border-radius: 4px; font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; transition: all 0.2s ease;">
                        Next →
                      </a>
                    {%- endif -%}
                  </div>
                {%- endif -%}
                {%- endunless -%}
                {%- if items_length == 0 -%}<div class="empty-state-3 w-dyn-empty">
                  <div class="text-block-790">We're adding more<br>product to this collection</div>
                  <a href="{{ pages["shop"].url }}" class="button w-button">Shop All Products</a>
                </div>{%- endif -%}
              </div>
{% endpaginate %}