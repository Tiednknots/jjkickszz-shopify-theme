<style>
  /* --- Editable Sizing for Home Collection --- */
  .home-custom-grid {
    /* Add grid styles here if needed */
  }
  .home-custom-img-wrap {
    height: 350px; /* Increase Desktop Height Here */
  }
  .home-custom-img {
    width: 100% !important;
    height: 100% !important;
    min-height: 100% !important;
    max-height: 100% !important;
    object-fit: cover !important;
  }
  @media (max-width: 767px) {
    .home-custom-img-wrap {
      height: 250px; /* Increase Mobile Height Here */
    }
  }
</style>

{% capture listItems %}
{%- assign _all_sorted = collections.all.products | sort: 'created_at' | reverse -%}
{%- assign _rendered_vendors = "" -%}
{%- for item in _all_sorted -%}
  {%- if item.handle == 'shipping-insurance' or item.title contains 'Insurance' -%}{%- continue -%}{%- endif -%}
  {%- unless item.available -%}{%- continue -%}{%- endunless -%}
  {%- assign _vendor_pipe = item.vendor | append: "|" -%}
  {%- unless _rendered_vendors contains _vendor_pipe -%}
    {%- assign _rendered_vendors = _rendered_vendors | append: _vendor_pipe -%}
                <div role="listitem" class="collection-item-2 w-dyn-item">
                  <a href="{{ item.url }}" class="link-block-2 w-inline-block">
                    <div class="div-block-15 home-custom-img-wrap {% unless item.available %}jj-sold-out-card{% endunless %}"><img loading="lazy" src="{{ item.featured_image | img_url: '600x' }}" alt="{{ item.featured_image.alt }}" class="image-6 home-custom-img" data-commerce-type="variation-image" srcset="{{ item.featured_image | img_url: '1920x' }} 1920w,{{ item.featured_image | img_url: '1600x' }} 1600w,{{ item.featured_image | img_url: '1366x' }} 1366w,{{ item.featured_image | img_url: '1024x' }} 1024w,{{ item.featured_image | img_url: '768x' }} 768w,{{ item.featured_image | img_url: '640x' }} 640w">
                      <div class="link-overlay bs">{{ item.vendor }}</div>
                    {%- unless item.available -%}<div class="jj-sold-out-badge">SOLD OUT</div>{%- endunless -%}</div>
                    <div class="text-block-4 title">{{ item.title }}</div>
                    <div data-commerce-type="variation-price" class="text-block-779">{{ item.price | money }}</div>
                    <div class="div-block-1163">
                      <div class="text-block-4 asd">Sizes :</div>
                      <div class="size-contents">
                        {%- assign _avail_count = 0 -%}{%- for _sv in item.variants -%}{%- if _sv.inventory_quantity > 0 or _sv.inventory_policy == 'continue' -%}{%- assign _avail_count = _avail_count | plus: 1 -%}{%- endif -%}{%- endfor -%}{%- if _avail_count > 3 -%}<div class="text-block-4 asd sizes-variants">Multiple Sizes</div>{%- else -%}{%- for _sv in item.variants -%}{%- if _sv.inventory_quantity > 0 or _sv.inventory_policy == 'continue' -%}{%- assign _sl = _sv.title | strip -%}{%- assign _sl_down = _sl | downcase -%}{%- if _sl_down contains 'xxxl' or _sl_down contains '3xl' -%}{%- assign _sl = '3XL' -%}{%- elsif _sl_down contains 'xxl' or _sl_down contains '2xl' or _sl_down contains 'xx-large' or _sl_down contains 'xx large' or _sl_down == 'xxlarge' -%}{%- assign _sl = 'XXL' -%}{%- elsif _sl_down contains 'xl' or _sl_down contains 'x-large' or _sl_down contains 'x large' or _sl_down == 'xlarge' -%}{%- assign _sl = 'XL' -%}{%- elsif _sl_down contains 'xs' or _sl_down contains 'xsmall' or _sl_down contains 'x-small' or _sl_down contains 'extra small' or _sl_down == 'xs' -%}{%- assign _sl = 'XS' -%}{%- elsif _sl_down contains 'small' or _sl_down == 's' -%}{%- assign _sl = 'S' -%}{%- elsif _sl_down contains 'medium' or _sl_down == 'm' -%}{%- assign _sl = 'M' -%}{%- elsif _sl_down contains 'large' or _sl_down == 'l' -%}{%- assign _sl = 'L' -%}{%- elsif _sl_down contains 'one size' or _sl_down contains 'onesize' or _sl_down contains 'osfm' or _sl_down contains 'os' -%}{%- assign _sl = 'O/S' -%}{%- endif -%}<div class="text-block-4 asd sizes-variants">{{ _sl }}</div>{%- endif -%}{%- endfor -%}{%- endif -%}
                      </div>
                    </div>
{%- capture _jj_meta -%}{{ item.vendor }}|{{ item.product_type }}|{{ item.tags | join: "|" }}|{{ item.price | money_without_trailing_zeros }}|{{ item.price_min | money_without_trailing_zeros }}|{{ item.price_max | money_without_trailing_zeros }}{%- for _v in item.variants -%}|{{ _v.title }}{%- endfor -%}{%- for _opt in item.options_with_values -%}{%- for _val in _opt.values -%}|{{ _val }}{%- endfor -%}{%- endfor -%}{%- endcapture -%}<span class="jj-search-meta" aria-hidden="true" style="display:none;position:absolute;width:1px;height:1px;overflow:hidden;">{{ _jj_meta }}</span>
                  </a>
                </div>
  {%- endunless -%}
{%- endfor -%}
{% endcapture %}
{% assign items_length = listItems | strip | size %}

<div setting-name="Home Collection" class="collection-list-wrapper w-dyn-list">
              {%- unless items_length == 0 -%}<div role="list" class="collection-list-2 contents-of-scroll home-custom-grid w-dyn-items">
                {{ listItems }}
              </div>{%- endunless -%}
              {%- if items_length == 0 -%}<div class="w-dyn-empty">
                <div>No items found.</div>
              </div>{%- endif -%}
            </div>