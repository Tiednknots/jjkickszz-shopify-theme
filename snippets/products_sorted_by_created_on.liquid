<style>
  /* --- Editable Sizing for Home Collection --- */
  .home-custom-grid {
    /* Add grid styles here if needed */
  }
  .home-custom-img-wrap {
    height: 350px; /* Increase Desktop Height Here */
  }
  .home-custom-img {
    width: 100% !important;
    height: 100% !important;
    min-height: 100% !important;
    max-height: 100% !important;
    object-fit: cover !important;
  }
  @media (max-width: 767px) {
    .home-custom-img-wrap {
      height: 250px; /* Increase Mobile Height Here */
    }
  }
</style>

{% capture listItems %}
{%- assign _all_sorted = collections.all.products | sort: 'created_at' | reverse -%}
{%- assign _rendered_vendors = "" -%}
{%- assign date_seed = "now" | date: "%j" | plus: 0 -%}

{%- for item in _all_sorted -%}
  {%- if item.handle == 'shipping-insurance' or item.title contains 'Insurance' -%}{%- continue -%}{%- endif -%}
  {%- unless item.available -%}{%- continue -%}{%- endunless -%}
  {%- assign _vendor_pipe = item.vendor | append: "|" -%}
  {%- unless _rendered_vendors contains _vendor_pipe -%}
    {%- assign _rendered_vendors = _rendered_vendors | append: _vendor_pipe -%}
    
    {% comment %} Gather up to 8 newest available items for this vendor {% endcomment %}
    {%- assign _vendor_items_handles = "" -%}
    {%- assign _vendor_items_count = 0 -%}
    {%- for p in _all_sorted -%}
      {%- if p.vendor == item.vendor and p.available -%}
        {%- if p.handle == 'shipping-insurance' or p.title contains 'Insurance' -%}{%- continue -%}{%- endif -%}
        {%- assign _vendor_items_handles = _vendor_items_handles | append: p.handle | append: "," -%}
        {%- assign _vendor_items_count = _vendor_items_count | plus: 1 -%}
        {%- if _vendor_items_count >= 8 -%}{%- break -%}{%- endif -%}
      {%- endif -%}
    {%- endfor -%}
    
    {%- if _vendor_items_count > 0 -%}
      {%- assign _index = date_seed | modulo: _vendor_items_count -%}
      {%- assign _handles_arr = _vendor_items_handles | split: "," -%}
      {%- assign _selected_handle = _handles_arr[_index] -%}
      
      {% comment %} Find and render the selected product {% endcomment %}
      {%- for p in _all_sorted -%}
        {%- if p.handle == _selected_handle -%}
          <div role="listitem" class="collection-item-2 w-dyn-item">
            <a href="{{ p.url }}" class="link-block-2 w-inline-block">
              <div class="div-block-15 home-custom-img-wrap {% unless p.available %}jj-sold-out-card{% endunless %}"><img loading="lazy" src="{{ p.featured_image | img_url: '600x' }}" alt="{{ p.featured_image.alt }}" class="image-6 home-custom-img" data-commerce-type="variation-image" srcset="{{ p.featured_image | img_url: '1920x' }} 1920w,{{ p.featured_image | img_url: '1600x' }} 1600w,{{ p.featured_image | img_url: '1366x' }} 1366w,{{ p.featured_image | img_url: '1024x' }} 1024w,{{ p.featured_image | img_url: '768x' }} 768w,{{ p.featured_image | img_url: '640x' }} 640w">
                <div class="link-overlay bs">{{ p.vendor }}</div>
              {%- unless p.available -%}<div class="jj-sold-out-badge">SOLD OUT</div>{%- endunless -%}</div>
              <div class="text-block-4 title">{{ p.title }}</div>
              <div data-commerce-type="variation-price" class="text-block-779">{{ p.price | money }}</div>
              <div class="div-block-1163">
                <div class="text-block-4 asd">Sizes :</div>
                <div class="size-contents">
                  {%- assign _avail_count = 0 -%}{%- for _sv in p.variants -%}{%- if _sv.inventory_quantity > 0 or _sv.inventory_policy == 'continue' -%}{%- assign _avail_count = _avail_count | plus: 1 -%}{%- endif -%}{%- endfor -%}{%- if _avail_count > 3 -%}<div class="text-block-4 asd sizes-variants">Multiple Sizes</div>{%- else -%}{%- for _sv in p.variants -%}{%- if _sv.inventory_quantity > 0 or _sv.inventory_policy == 'continue' -%}{%- assign _sl = _sv.title | strip -%}{%- assign _sl_down = _sl | downcase -%}{%- if _sl_down contains 'xxxl' or _sl_down contains '3xl' -%}{%- assign _sl = '3XL' -%}{%- elsif _sl_down contains 'xxl' or _sv.title contains '2xl' or _sv.title contains 'XX-Large' or _sv.title contains 'XX Large' or _sv.title == 'XXLarge' or _sl_down contains '2xl' or _sl_down contains 'xx-large' or _sl_down contains 'xx large' or _sl_down == 'xxlarge' -%}{%- assign _sl = 'XXL' -%}{%- elsif _sl_down contains 'xl' or _sl_down contains 'x-large' or _sl_down contains 'x large' or _sl_down == 'xlarge' -%}{%- assign _sl = 'XL' -%}{%- elsif _sl_down contains 'xs' or _sl_down contains 'xsmall' or _sl_down contains 'x-small' or _sl_down contains 'extra small' or _sl_down == 'xs' -%}{%- assign _sl = 'XS' -%}{%- elsif _sl_down contains 'small' or _sl_down == 's' -%}{%- assign _sl = 'S' -%}{%- elsif _sl_down contains 'medium' or _sl_down == 'm' -%}{%- assign _sl = 'M' -%}{%- elsif _sl_down contains 'large' or _sl_down == 'l' -%}{%- assign _sl = 'L' -%}{%- elsif _sl_down contains 'one size' or _sl_down contains 'onesize' or _sl_down contains 'osfm' or _sl_down contains 'os' -%}{%- assign _sl = 'O/S' -%}{%- endif -%}<div class="text-block-4 asd sizes-variants">{{ _sl }}</div>{%- endif -%}{%- endfor -%}{%- endif -%}
                </div>
              </div>
{%- capture _jj_meta -%}{{ p.vendor }}|{{ p.product_type }}|{{ p.tags | join: "|" }}|{{ p.price | money_without_trailing_zeros }}|{{ p.price_min | money_without_trailing_zeros }}|{{ p.price_max | money_without_trailing_zeros }}{%- for _v in p.variants -%}|{{ _v.title }}{%- endfor -%}{%- for _opt in p.options_with_values -%}{%- for _val in _opt.values -%}|{{ _val }}{%- endfor -%}{%- endfor -%}{%- endcapture -%}<span class="jj-search-meta" aria-hidden="true" style="display:none;position:absolute;width:1px;height:1px;overflow:hidden;">{{ _jj_meta }}</span>
            </a>
          </div>
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}
  {%- endunless -%}
{%- endfor -%}
{% endcapture %}
{% assign items_length = listItems | strip | size %}

<div setting-name="Home Collection" class="collection-list-wrapper w-dyn-list">
              {%- unless items_length == 0 -%}<div role="list" class="collection-list-2 contents-of-scroll home-custom-grid w-dyn-items">
                {{ listItems }}
              </div>{%- endunless -%}
              {%- if items_length == 0 -%}<div class="w-dyn-empty">
                <div>No items found.</div>
              </div>{%- endif -%}
            </div>