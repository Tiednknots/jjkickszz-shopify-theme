{% comment %}
  JJKICKSZZ AI Chat & Universal Music Floater (v26.0 - Standalone)
  Features:
  - Music Controls: Play / Pause toggle + Mute / Unmute toggle
  - AI Chat Trigger: "JJKICKSZZ AI — What are you looking for today? 👟"
  - 30-Second Engagement Tooltip: Auto pops-up after 30s of browsing to encourage chat interaction
  - Streetwear Flat-Lay Outfit Builder & AI Assistant Modal Drawer
{% endcomment %}

<style>
  :root {
    --jj-bg: rgba(10, 10, 10, 0.95);
    --jj-accent: #c60000;
    --jj-text: #ffffff;
    --jj-z: 2147483647;
  }

  /* Floating Bar Container */
  .jj-floater-wrapper {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: var(--jj-z);
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 8px;
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
  }

  /* 30-Second Engagement Bubble Tooltip */
  .jj-persuasion-bubble {
    background: linear-gradient(135deg, rgba(30, 0, 0, 0.95), rgba(15, 15, 15, 0.98));
    border: 1px solid rgba(198, 0, 0, 0.5);
    color: #fff;
    padding: 12px 14px;
    border-radius: 16px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.8), 0 0 20px rgba(198, 0, 0, 0.3);
    max-width: 280px;
    display: flex;
    align-items: flex-start;
    gap: 10px;
    animation: jjPopIn 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    cursor: pointer;
  }

  @keyframes jjPopIn {
    from { opacity: 0; transform: translateY(12px) scale(0.95); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }

  .jj-bubble-icon {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: rgba(198, 0, 0, 0.2);
    border: 1px solid rgba(198, 0, 0, 0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  /* Main Combined Pill */
  .jj-floater-bar {
    background: var(--jj-bg);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 40px;
    padding: 6px 12px 6px 8px;
    display: flex;
    align-items: center;
    gap: 10px;
    box-shadow: 0 10px 35px rgba(0, 0, 0, 0.7);
  }

  /* Left: Music Controls */
  .jj-music-box {
    display: flex;
    align-items: center;
    gap: 6px;
    background: rgba(20, 20, 20, 0.9);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 30px;
    padding: 4px 8px;
  }

  .jj-btn-circle {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: none;
    background: var(--jj-accent);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: transform 0.2s, background-color 0.2s;
  }

  .jj-btn-circle:hover {
    transform: scale(1.05);
    background: #e60000;
  }

  .jj-btn-icon {
    background: none;
    border: none;
    color: #888;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: color 0.2s, background-color 0.2s;
  }

  .jj-btn-icon:hover {
    color: #fff;
    background: rgba(255, 255, 255, 0.1);
  }

  .jj-btn-icon.muted {
    color: var(--jj-accent);
  }

  .jj-divider {
    width: 1px;
    height: 24px;
    background: rgba(255, 255, 255, 0.12);
  }

  /* Right: AI Chat Trigger */
  .jj-chat-trigger {
    display: flex;
    align-items: center;
    gap: 10px;
    background: none;
    border: none;
    color: #fff;
    cursor: pointer;
    padding: 4px 6px;
    text-align: left;
  }

  .jj-ai-badge {
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 1px;
    color: var(--jj-accent);
    text-transform: uppercase;
  }

  .jj-ai-msg {
    font-size: 11px;
    font-weight: 500;
    color: #e4e4e7;
    white-space: nowrap;
  }

  /* AI Chat & Flat-Lay Modal Drawer */
  .jj-drawer-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(8px);
    z-index: calc(var(--jj-z) + 1);
    display: flex;
    justify-content: flex-end;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .jj-drawer-overlay.open {
    opacity: 1;
    pointer-events: auto;
  }

  .jj-drawer-content {
    width: 100%;
    max-width: 480px;
    height: 100%;
    background: #09090b;
    border-left: 1px solid rgba(255, 255, 255, 0.1);
    display: flex;
    flex-direction: column;
    transform: translateX(100%);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    color: #fff;
  }

  .jj-drawer-overlay.open .jj-drawer-content {
    transform: translateX(0);
  }

  @media (max-width: 767px) {
    .jj-floater-wrapper {
      right: 12px;
      bottom: 16px;
    }
    .jj-ai-msg {
      font-size: 10px;
    }
  }
</style>

<!-- Floating Component UI -->
<div class="jj-floater-wrapper">
  
  <!-- 30-Second Persuasion Tooltip -->
  <div class="jj-persuasion-bubble" id="jj-persuasion-bubble" style="display: none;">
    <div class="jj-bubble-icon">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#c60000" stroke-width="2"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
    </div>
    <div style="flex:1;" onclick="openAiChatDrawer()">
      <div style="font-size:10px; font-weight:800; color:#c60000; text-transform:uppercase; margin-bottom:2px;">JJKICKSZZ AI STYLIST</div>
      <div style="font-size:11px; color:#ddd; line-height:1.3;">👋 Looking for size 10s or want me to build a custom outfit under your budget?</div>
    </div>
    <button onclick="closePersuasionBubble(event)" style="background:none; border:none; color:#777; cursor:pointer; padding:2px;">✕</button>
  </div>

  <!-- Main Control Pill -->
  <div class="jj-floater-bar">
    
    <!-- Music Controls (Play/Pause & Mute/Unmute) -->
    <div class="jj-music-box">
      <button class="jj-btn-circle" id="jj-play-toggle" title="Play/Pause">
        <svg id="jj-icon-play" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
        <svg id="jj-icon-pause" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" style="display:none;"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
      </button>

      <button class="jj-btn-icon" id="jj-mute-toggle" title="Mute/Unmute">
        <svg id="jj-icon-volume" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 5L6 9H2v6h4l5 4V5zM19.07 4.93a10 10 0 010 14.14M15.54 8.46a5 5 0 010 7.07"/></svg>
        <svg id="jj-icon-muted" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display:none;"><path d="M11 5L6 9H2v6h4l5 4V5zM23 9l-6 6M17 9l6 6"/></svg>
      </button>
    </div>

    <div class="jj-divider"></div>

    <!-- AI Chat Trigger -->
    <button class="jj-chat-trigger" onclick="openAiChatDrawer()">
      <div style="width:26px; height:26px; border-radius:50%; background:#18181b; border:1px solid #3f3f46; display:flex; align-items:center; justify-center:center;">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#c60000" stroke-width="2"><path d="M12 2l2.4 7.2h7.6l-6 4.8 2.4 7.2-6-4.8-6 4.8 2.4-7.2-6-4.8h7.6z"/></svg>
      </div>
      <div>
        <div class="jj-ai-badge">JJKICKSZZ AI</div>
        <div class="jj-ai-msg">What are you looking for today? 👟</div>
      </div>
    </button>
  </div>
</div>

<!-- Audio Stream Tag -->
{%- assign music_src = settings.music_url | default: 'https://dl.dropboxusercontent.com/scl/fi/27cr46xqki92kkrv0oep1/New-Rap-Songs-2026-Mix-May-Trap-Tape-133-New-Hip-Hop-2026-Mixtape-DJ-Noize-DJ-Noize-128k-_compressed?rlkey=ylnxkkoxlzniy1opm7atb9xti&raw=1' -%}
<audio id="jj-floater-audio" preload="metadata" loop>
  <source src="{{ music_src }}" type="audio/mpeg">
</audio>

<!-- AI Chat Drawer Modal Container -->
<div class="jj-drawer-overlay" id="jj-chat-drawer-overlay" onclick="closeAiChatDrawer(event)">
  <div class="jj-drawer-content" onclick="event.stopPropagation()">
    <!-- Header -->
    <div style="padding:16px; border-bottom:1px solid #27272a; display:flex; justify-content:space-between; align-items:center; background:#000;">
      <div>
        <div style="font-size:13px; font-weight:800; text-transform:uppercase; tracking-wide:1px;">JJKICKSZZ AI Assistant & Stylist</div>
        <div style="font-size:10px; color:#22c55e; font-family:monospace;">● Live Store Catalog Synchronized</div>
      </div>
      <button onclick="closeAiChatDrawer()" style="background:none; border:none; color:#888; cursor:pointer; font-size:18px;">✕</button>
    </div>

    <!-- Body Area -->
    <div style="flex:1; padding:20px; overflow-y:auto; font-size:12px; line-height:1.6; color:#ccc;">
      <div style="background:#18181b; border:1px solid #27272a; padding:12px; border-radius:12px; margin-bottom:16px;">
        <span style="color:#c60000; font-weight:bold;">JJKICKSZZ AI:</span> Yo! I can help you find Jordan 4s under $300, check shoe sizing in stock, or build you a complete 3-piece streetwear outfit flat-lay matching your budget.
      </div>
      <p style="text-align:center; opacity:0.6; margin-top:40px;">[ Interactive Chat & Flat-Lay Outfit Builder Integration Active ]</p>
    </div>
  </div>
</div>

<script>
(function() {
  const audio = document.getElementById('jj-floater-audio');
  const playBtn = document.getElementById('jj-play-toggle');
  const muteBtn = document.getElementById('jj-mute-toggle');
  const playIcon = document.getElementById('jj-icon-play');
  const pauseIcon = document.getElementById('jj-icon-pause');
  const volumeIcon = document.getElementById('jj-icon-volume');
  const mutedIcon = document.getElementById('jj-icon-muted');
  const bubble = document.getElementById('jj-persuasion-bubble');

  if (!audio || !playBtn || !muteBtn) return;

  // 30-Second Inactivity Engagement Timer
  setTimeout(function() {
    if (bubble && sessionStorage.getItem('jj_bubble_closed') !== 'true') {
      bubble.style.display = 'flex';
    }
  }, 30000);

  window.closePersuasionBubble = function(e) {
    if (e) e.stopPropagation();
    if (bubble) bubble.style.display = 'none';
    sessionStorage.setItem('jj_bubble_closed', 'true');
  };

  window.openAiChatDrawer = function() {
    const overlay = document.getElementById('jj-chat-drawer-overlay');
    if (overlay) overlay.classList.add('open');
    if (bubble) bubble.style.display = 'none';
  };

  window.closeAiChatDrawer = function(e) {
    const overlay = document.getElementById('jj-chat-drawer-overlay');
    if (overlay) overlay.classList.remove('open');
  };

  // Play / Pause Action
  playBtn.onclick = function(e) {
    e.stopPropagation();
    if (audio.paused) {
      audio.play().then(() => {
        playIcon.style.display = 'none';
        pauseIcon.style.display = 'block';
      }).catch(err => console.log('Playback blocked:', err));
    } else {
      audio.pause();
      playIcon.style.display = 'block';
      pauseIcon.style.display = 'none';
    }
  };

  // Mute / Unmute Action
  muteBtn.onclick = function(e) {
    e.stopPropagation();
    audio.muted = !audio.muted;
    if (audio.muted) {
      volumeIcon.style.display = 'none';
      mutedIcon.style.display = 'block';
      muteBtn.classList.add('muted');
    } else {
      volumeIcon.style.display = 'block';
      mutedIcon.style.display = 'none';
      muteBtn.classList.remove('muted');
    }
  };
})();
</script>
