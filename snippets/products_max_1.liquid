{% capture listItems %}
{% paginate collections.all.products by 250 %}
{%- for item in collections.all.products limit: 1 %}
 <div role="listitem" class="w-dyn-item"></div>
{%- endfor -%}
{% endpaginate %}
{% endcapture %}
{% assign items_length = listItems | strip | size %}

<div class="w-dyn-list" udy-collection="product">
          {%- unless items_length == 0 -%}<div role="list" class="w-dyn-items">
            {{ listItems }}
          </div>{%- endunless -%}
          {%- if items_length == 0 -%}<div class="w-dyn-empty">
            <div>No items found.</div>
          </div>{%- endif -%}
        </div>