      {%- if ref == 'all' or ref == 'frontpage' or ref == 'shop' or ref == 'new-drops' -%}{%- continue -%}{%- endif -%}
      {%- if globalRefs contains ref -%}{%- assign _match = true -%}{%- break -%}{%- endif -%}
