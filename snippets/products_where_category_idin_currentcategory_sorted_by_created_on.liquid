{% endcapture %}
{% assign items_length = listItems | strip | size %}

<div setting-name="Home Collection" class="collection-list-wrapper similar-items w-dyn-list">
          {%- unless items_length == 0 -%}<div role="list" class="collection-list-2 contents-of-scroll scroll product w-dyn-items">
            {{ listItems }}
          </div>{%- endunless -%}
          {%- if items_length == 0 -%}<div class="w-dyn-empty">
            <div>No items found.</div>
          </div>{%- endif -%}
        </div>