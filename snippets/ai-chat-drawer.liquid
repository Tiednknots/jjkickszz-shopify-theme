<!-- 🤖 JJKICKSZZ AI — Storefront Chat Drawer -->
<div class="jj-ai-chat-wrapper" id="jj-ai-chat-root">
  <!-- Floating Trigger Button -->
  <button class="jj-ai-chat-trigger" id="jj-ai-chat-trigger" aria-label="Toggle sneaker stylist">
    <!-- Sparkles Icon -->
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="jj-ai-spark-icon icon-sparkle">
      <path d="M9.813 15.904L9 21L8.188 15.904L3 15L8.188 14.096L9 9L9.813 14.096L15 15L9.813 15.904Z" fill="currentColor"/>
      <path d="M19.071 4.929L18.5 8L17.929 4.929L15 4.358L17.929 3.787L18.5 0.716L19.071 3.787L22 4.358L19.071 4.929Z" fill="currentColor"/>
    </svg>
    <!-- Close Icon -->
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="jj-ai-close-icon icon-close" style="display: none;">
      <line x1="18" y1="6" x2="6" y2="18"></line>
      <line x1="6" y1="6" x2="18" y2="18"></line>
    </svg>
  </button>

  <!-- Slide-Out Chat Drawer -->
  <div class="jj-ai-chat-drawer" id="jj-ai-chat-drawer" aria-hidden="true">
    <!-- Header -->
    <div class="jj-ai-chat-header">
      <div class="jj-ai-chat-header-title">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 3c.132 0 .263 0 .393.007a3 3 0 0 0 .19.016l.128.016.126.021a8 8 0 0 1 6.138 6.138l.021.126.016.128a3 3 0 0 0 .016.19c.007.13.007.261.007.393a3 3 0 0 0-.007.393 3 3 0 0 0-.016.19l-.016.128-.021.126a8 8 0 0 1-6.138 6.138l-.126.021-.128.016a3 3 0 0 0-.19.016c-.13.007-.261.007-.393.007a3 3 0 0 0-.393-.007a3 3 0 0 0-.19-.016l-.128-.016-.126-.021a8 8 0 0 1-6.138-6.138l-.021-.126-.016-.128a3 3 0 0 0-.016-.19A3 3 0 0 0 3 12.393a3 3 0 0 0 .007-.393 3 3 0 0 0 .016-.19l.016-.128.021-.126a8 8 0 0 1 6.138-6.138l.126-.021.128-.016c.062-.007.126-.012.19-.016.13-.007.261-.007.393-.007zM5 19a2 2 0 1 0 0-4 2 2 0 0 0 0 4z"/>
        </svg>
        <span>JJKICKSZZ AI STYLIST</span>
      </div>
      <button class="jj-ai-chat-close" id="jj-ai-chat-close" aria-label="Close stylist">&times;</button>
    </div>

    <!-- Messages Container -->
    <div class="jj-ai-chat-messages" id="jj-ai-chat-messages">
      <!-- Welcome Message -->
      <div class="jj-ai-msg bot">
        <div class="jj-ai-msg-bubble">
          Yo! I'm your JJKICKSZZ AI Stylist. Ask me to find sneakers, coordinate outfits, check returns, or look up sizes!
        </div>
      </div>
    </div>

    <!-- Suggested Quick Prompts -->
    <div class="jj-ai-chat-suggested">
      <button type="button" class="jj-ai-chat-prompt-btn" data-prompt="Build me a clean outfit">👕 Outfit Stylist</button>
      <button type="button" class="jj-ai-chat-prompt-btn" data-prompt="Show me Jordan 4s under $300">⚡ Jordans under $300</button>
      <button type="button" class="jj-ai-chat-prompt-btn" data-prompt="What is your return policy?">📦 Return Policy</button>
    </div>

    <!-- Input Form -->
    <form class="jj-ai-chat-form" id="jj-ai-chat-form">
      <input type="text" class="jj-ai-chat-input" id="jj-ai-chat-input" placeholder="Ask about outfits, sizes, or stock..." autocomplete="off" required>
      <button type="submit" class="jj-ai-chat-send" aria-label="Send message">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
      </button>
    </form>
  </div>
</div>

<style>
  /* Launcher Bubble Button */
  .jj-ai-chat-trigger {
    position: fixed;
    bottom: 24px;
    right: 24px;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: #ffffff;
    color: #000000;
    border: 1px solid rgba(0,0,0,0.06);
    box-shadow: 0 4px 20px rgba(0,0,0,0.25);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 9999;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .jj-ai-chat-trigger:hover {
    transform: scale(1.08) translateY(-2px);
    box-shadow: 0 6px 24px rgba(0,0,0,0.35);
  }
  .jj-ai-chat-trigger svg {
    width: 24px;
    height: 24px;
  }
  @media (max-width: 767px) {
    .jj-ai-chat-trigger {
      bottom: 16px;
      right: 16px;
      width: 48px;
      height: 48px;
    }
    .jj-ai-chat-trigger svg {
      width: 20px;
      height: 20px;
    }
  }

  /* Slide-Out Drawer Panel */
  .jj-ai-chat-drawer {
    position: fixed;
    top: 74px; /* Starts at the end of the menu header */
    right: -420px; /* Initially hidden offscreen */
    width: 400px;
    height: calc(100% - 74px);
    background: #0b0b0b; /* Deep black theme */
    border-left: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: -10px 0 40px rgba(0,0,0,0.7);
    display: flex;
    flex-direction: column;
    z-index: 10000;
    transition: right 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    box-sizing: border-box;
  }
  .jj-ai-chat-drawer.open {
    right: 0;
  }
  @media (max-width: 767px) {
    .jj-ai-chat-drawer {
      width: 100%;
      right: -100%;
      border-left: none;
      top: 64px; /* Starts at the end of the mobile menu header */
      height: calc(100% - 64px);
    }
  }

  /* Header */
  .jj-ai-chat-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    background: #111111;
  }
  .jj-ai-chat-header-title {
    display: flex;
    align-items: center;
    gap: 8px;
    color: #ffffff;
    font-family: var(--font-display), 'Inter', sans-serif;
    font-size: 13px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .jj-ai-chat-close {
    background: transparent;
    border: none;
    outline: none;
    color: rgba(255,255,255,0.4);
    font-size: 24px;
    cursor: pointer;
    padding: 0;
    line-height: 1;
    transition: color 0.2s ease;
  }
  .jj-ai-chat-close:hover {
    color: #ffffff;
  }

  /* Message Window */
  .jj-ai-chat-messages {
    flex: 1;
    overflow-y: auto;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    scrollbar-width: thin;
    scrollbar-color: rgba(255,255,255,0.1) transparent;
  }
  .jj-ai-chat-messages::-webkit-scrollbar {
    width: 4px;
  }
  .jj-ai-chat-messages::-webkit-scrollbar-thumb {
    background-color: rgba(255,255,255,0.15);
    border-radius: 2px;
  }

  /* Messages Styling */
  .jj-ai-msg {
    display: flex;
    flex-direction: column;
    max-width: 85%;
  }
  .jj-ai-msg.bot {
    align-self: flex-start;
  }
  .jj-ai-msg.user {
    align-self: flex-end;
  }
  .jj-ai-msg-bubble {
    padding: 12px 16px;
    border-radius: 12px;
    font-family: var(--font-body), 'Inter', sans-serif;
    font-size: 13px;
    line-height: 1.5;
    word-wrap: break-word;
  }
  .jj-ai-msg.bot .jj-ai-msg-bubble {
    background: #191919;
    color: rgba(255,255,255,0.9);
    border: 1px solid rgba(255,255,255,0.05);
  }
  .jj-ai-msg.user .jj-ai-msg-bubble {
    background: #ffffff;
    color: #000000;
  }

  /* Interactive Outfit Card styling */
  .jj-ai-chat-outfit-container {
    margin-top: 10px;
    border: 1px solid rgba(255,255,255,0.08);
    background: #111111;
    border-radius: 12px;
    padding: 12px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    box-sizing: border-box;
  }
  .jj-ai-chat-outfit-title {
    font-family: var(--font-display), 'Inter', sans-serif;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.1em;
    color: rgba(255,255,255,0.4);
    margin-bottom: 2px;
    text-transform: uppercase;
  }
  .jj-ai-chat-card {
    display: flex;
    align-items: center;
    gap: 12px;
    background: rgba(255,255,255,0.02);
    border: 1px solid rgba(255,255,255,0.04);
    border-radius: 8px;
    padding: 8px;
    text-decoration: none;
    box-sizing: border-box;
  }
  .jj-ai-chat-card-img {
    width: 50px;
    height: 50px;
    background: #ffffff;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    flex-shrink: 0;
  }
  .jj-ai-chat-card-img img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .jj-ai-chat-card-info {
    flex: 1;
    min-width: 0;
  }
  .jj-ai-chat-card-title {
    font-family: var(--font-body), 'Inter', sans-serif;
    font-size: 11px;
    font-weight: 700;
    color: #ffffff;
    text-transform: uppercase;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin-bottom: 2px;
  }
  .jj-ai-chat-card-price {
    font-family: var(--font-body), 'Inter', sans-serif;
    font-size: 11px;
    font-weight: 800;
    color: #22c55e;
  }
  .jj-ai-chat-outfit-btn {
    width: 100%;
    background: #ffffff;
    color: #000000;
    border: none;
    outline: none;
    border-radius: 6px;
    padding: 10px;
    font-family: var(--font-body), 'Inter', sans-serif;
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    cursor: pointer;
    text-align: center;
    transition: opacity 0.2s ease;
    margin-top: 4px;
  }
  .jj-ai-chat-outfit-btn:hover {
    opacity: 0.9;
  }

  /* Quick Prompts list */
  .jj-ai-chat-suggested {
    display: flex;
    flex-wrap: nowrap;
    overflow-x: auto;
    gap: 8px;
    padding: 12px 20px;
    border-top: 1px solid rgba(255,255,255,0.06);
    background: #111111;
    scrollbar-width: none;
  }
  .jj-ai-chat-suggested::-webkit-scrollbar {
    display: none;
  }
  .jj-ai-chat-prompt-btn {
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.08);
    color: rgba(255,255,255,0.7);
    border-radius: 16px;
    padding: 6px 12px;
    font-family: var(--font-body), 'Inter', sans-serif;
    font-size: 11px;
    font-weight: 500;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.2s ease;
  }
  .jj-ai-chat-prompt-btn:hover {
    background: #ffffff;
    color: #000000;
    border-color: #ffffff;
  }

  /* Input Form */
  .jj-ai-chat-form {
    display: flex;
    align-items: center;
    padding: 16px 20px;
    border-top: 1px solid rgba(255,255,255,0.08);
    background: #111111;
    gap: 12px;
  }
  .jj-ai-chat-input {
    flex: 1;
    background: #000000;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 20px;
    color: #ffffff;
    padding: 10px 18px;
    font-family: var(--font-body), 'Inter', sans-serif;
    font-size: 13px;
    outline: none;
    transition: border-color 0.25s ease;
  }
  .jj-ai-chat-input:focus {
    border-color: rgba(255,255,255,0.3);
  }
  .jj-ai-chat-send {
    background: transparent;
    border: none;
    outline: none;
    color: rgba(255,255,255,0.4);
    cursor: pointer;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color 0.2s ease;
  }
  .jj-ai-chat-send:hover {
    color: #ffffff;
  }

  /* Typing loader animation */
  .jj-ai-typing-indicator {
    display: flex;
    gap: 4px;
    padding: 8px 12px;
  }
  .jj-ai-typing-indicator span {
    width: 6px;
    height: 6px;
    background: rgba(255,255,255,0.4);
    border-radius: 50%;
    animation: jj-typing-anim 1.2s infinite;
  }
  .jj-ai-typing-indicator span:nth-child(2) { animation-delay: 0.2s; }
  .jj-ai-typing-indicator span:nth-child(3) { animation-delay: 0.4s; }

  @keyframes jj-typing-anim {
    0%, 100% { transform: translateY(0); opacity: 0.4; }
    50% { transform: translateY(-4px); opacity: 1; }
  }
</style>

<script>
  (function() {
    var triggerBtn = document.getElementById('jj-ai-chat-trigger');
    var closeBtn = document.getElementById('jj-ai-chat-close');
    var drawerEl = document.getElementById('jj-ai-chat-drawer');
    var formEl = document.getElementById('jj-ai-chat-form');
    var inputEl = document.getElementById('jj-ai-chat-input');
    var messagesContainer = document.getElementById('jj-ai-chat-messages');

    if (!triggerBtn || !drawerEl) return;

    // Toggle Drawer Open
    triggerBtn.addEventListener('click', function() {
      var isOpen = drawerEl.classList.contains('open');
      if (isOpen) {
        closeDrawer();
      } else {
        openDrawer();
      }
    });

    closeBtn.addEventListener('click', closeDrawer);

    function openDrawer() {
      drawerEl.classList.add('open');
      drawerEl.setAttribute('aria-hidden', 'false');
      triggerBtn.classList.add('open');
      triggerBtn.querySelector('.icon-sparkle').style.display = 'none';
      triggerBtn.querySelector('.icon-close').style.display = 'block';
      inputEl.focus();
    }

    function closeDrawer() {
      drawerEl.classList.remove('open');
      drawerEl.setAttribute('aria-hidden', 'true');
      triggerBtn.classList.remove('open');
      triggerBtn.querySelector('.icon-sparkle').style.display = 'block';
      triggerBtn.querySelector('.icon-close').style.display = 'none';
    }

    // Suggested prompts listeners
    var promptBtns = document.querySelectorAll('.jj-ai-chat-prompt-btn');
    promptBtns.forEach(function(btn) {
      btn.addEventListener('click', function() {
        var text = btn.getAttribute('data-prompt');
        sendUserMessage(text);
      });
    });

    // Form submit listener
    formEl.addEventListener('submit', function(e) {
      e.preventDefault();
      var text = inputEl.value.trim();
      if (text.length > 0) {
        sendUserMessage(text);
        inputEl.value = '';
      }
    });

    function sendUserMessage(text) {
      // Append User message UI
      appendMessage('user', text);
      scrollToBottom();

      // Show typing indicator
      var loaderId = appendTypingIndicator();
      scrollToBottom();

      // Consult backend serverless endpoint
      var payload = {
        message: text,
        history: getChatHistory()
      };

      // SERVERLESS ENDPOINT URL (This endpoint securely passes commands to Google Gemini API)
      var workerEndpoint = 'https://jjkickszz-ai.create-d8d.workers.dev/';

      fetch(workerEndpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      })
      .then(function(res) { return res.json(); })
      .then(function(data) {
        removeTypingIndicator(loaderId);
        
        var rawText = data.response || '';
        if (!rawText) {
          console.error('[AIChat] Error or empty response from worker:', data);
          processOfflineFallback(text);
          return;
        }
        processBotResponse(rawText);
      })
      .catch(function(err) {
        console.error('[AIChat] Error querying endpoint:', err);
        removeTypingIndicator(loaderId);
        // Fallback Response if serverless endpoint is offline or not set up
        processOfflineFallback(text);
      });
    }

    function processBotResponse(rawText) {
      // Parse out product handles like [Product: handle]
      var handles = [];
      var cleanText = rawText.replace(/\[Product:\s*([a-zA-Z0-9\-]+)\]/g, function(match, handle) {
        handles.push(handle.trim());
        return ''; // remove references from the displayed bubble text
      });

      appendMessage('bot', cleanText);
      
      // If the response contains product recommendations, fetch and display checkout cards
      if (handles.length > 0) {
        injectProductCards(handles);
      }
      
      scrollToBottom();
    }

    function injectProductCards(handles) {
      var outfitId = 'outfit-' + Date.now();
      var outfitCard = document.createElement('div');
      outfitCard.className = 'jj-ai-chat-outfit-container';
      outfitCard.id = outfitId;
      outfitCard.innerHTML = '<div class="jj-ai-chat-outfit-title">STYLING SELECTIONS:</div>';
      
      messagesContainer.appendChild(outfitCard);

      var fetchPromises = handles.map(function(handle) {
        return fetch(window.Shopify.routes.root + 'products/' + handle + '.js')
          .then(function(res) { return res.json(); })
          .catch(function(err) {
            console.warn('[AIChat] Failed to fetch product info for:', handle, err);
            return null;
          });
      });

      Promise.all(fetchPromises).then(function(products) {
        var validProducts = products.filter(function(p) { return p !== null; });
        if (validProducts.length === 0) {
          outfitCard.remove();
          return;
        }

        var variantsList = [];
        validProducts.forEach(function(p) {
          var isAvailable = p.available;
          var variantId = '';
          if (p.variants && p.variants.length > 0) {
            var firstAvail = p.variants.find(function(v) { return v.available; });
            variantId = firstAvail ? firstAvail.id : p.variants[0].id;
          }

          if (isAvailable && variantId) {
            variantsList.push(variantId);
          }

          var priceStr = p.price ? '$' + (parseFloat(p.price) / 100).toFixed(2).replace('.00', '') : '';
          var imgUrl = p.featured_image || (p.images && p.images.length > 0 ? p.images[0] : '');

          var cardHtml = 
            '<a href="' + p.url + '" class="jj-ai-chat-card" target="_blank">' +
            '  <div class="jj-ai-chat-card-img"><img src="' + imgUrl + '" alt="' + p.title + '" loading="lazy"></div>' +
            '  <div class="jj-ai-chat-card-info">' +
            '    <div class="jj-ai-chat-card-title">' + p.title + '</div>' +
            '    <div class="jj-ai-chat-card-price">' + (isAvailable ? priceStr : 'SOLD OUT') + '</div>' +
            '  </div>' +
            '</a>';
          
          outfitCard.insertAdjacentHTML('beforeend', cardHtml);
        });

        // Add Checkout Trigger Button
        if (variantsList.length > 0) {
          var btnText = validProducts.length > 1 ? 'Add Outfit to Cart' : 'Add to Cart';
          var addBtn = document.createElement('button');
          addBtn.type = 'button';
          addBtn.className = 'jj-ai-chat-outfit-btn';
          addBtn.textContent = btnText;
          
          addBtn.addEventListener('click', function() {
            addBtn.disabled = true;
            addBtn.textContent = 'Adding...';

            var items = variantsList.map(function(vId) {
              return { id: parseInt(vId, 10), quantity: 1 };
            });

            fetch(window.Shopify.routes.root + 'cart/add.js', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ items: items })
            })
            .then(function(res) { return res.json(); })
            .then(function(data) {
              addBtn.disabled = false;
              addBtn.textContent = 'Added!';
              setTimeout(function() { addBtn.textContent = btnText; }, 2000);
              
              // Trigger theme cart drawer
              if (typeof window.Udesly !== 'undefined') {
                window.Udesly.dispatch('product-added', true);
              } else {
                window.location.href = '/cart';
              }
            })
            .catch(function(err) {
              addBtn.disabled = false;
              addBtn.textContent = btnText;
              console.error('[AIChat] Multi add failed:', err);
            });
          });

          outfitCard.appendChild(addBtn);
        }
        
        scrollToBottom();
      });
    }

    function processOfflineFallback(text) {
      var textLower = text.toLowerCase();
      var botResponse = '';

      if (textLower.indexOf('outfit') !== -1 || textLower.indexOf('coordinate') !== -1) {
        // Fallback Stylist match (uses active best-sellers!)
        botResponse = "I've coordinated a clean street fit from our current catalog featuring our popular shirts and tees: [Product: 2-in-1-hybrid-tee] [Product: after-life-tee]";
      } else if (textLower.indexOf('jordan') !== -1 || textLower.indexOf('sneaker') !== -1 || textLower.indexOf('amiri') !== -1) {
        botResponse = "Searching the collection for premium items... Try checking these models currently in stock: [Product: amiri-ma-core-logo-tee] [Product: 2-in-1-hybrid-tee]";
      } else if (textLower.indexOf('return') !== -1 || textLower.indexOf('refund') !== -1) {
        botResponse = "All sales are final due to the high demand and exclusive nature of our inventory. If you have an order issue, please drop us a message on the Contact page!";
      } else if (textLower.indexOf('shipping') !== -1 || textLower.indexOf('delivery') !== -1) {
        botResponse = "Orders are processed within 1-3 business days. Shipping takes approximately 5-8 days depending on your location. We offer free shipping on all orders over $400!";
      } else {
        botResponse = "I'm currently updating our inventory records. For now, check out these popular arrivals: [Product: 2-in-1-hybrid-tee]";
      }

      setTimeout(function() {
        processBotResponse(botResponse);
      }, 800);
    }

    // Helper functions
    function appendMessage(sender, text) {
      var msgDiv = document.createElement('div');
      msgDiv.className = 'jj-ai-msg ' + sender;
      msgDiv.innerHTML = '<div class="jj-ai-msg-bubble">' + escapeHTML(text) + '</div>';
      messagesContainer.appendChild(msgDiv);
    }

    function appendTypingIndicator() {
      var loaderId = 'loader-' + Date.now();
      var loaderDiv = document.createElement('div');
      loaderDiv.className = 'jj-ai-msg bot';
      loaderDiv.id = loaderId;
      loaderDiv.innerHTML = 
        '<div class="jj-ai-msg-bubble">' +
        '  <div class="jj-ai-typing-indicator"><span></span><span></span><span></span></div>' +
        '</div>';
      messagesContainer.appendChild(loaderDiv);
      return loaderId;
    }

    function removeTypingIndicator(id) {
      var loader = document.getElementById(id);
      if (loader) loader.remove();
    }

    function scrollToBottom() {
      messagesContainer.scrollTop = messagesContainer.scrollHeight;
    }

    function escapeHTML(str) {
      return str
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    function getChatHistory() {
      var history = [];
      var bubbleEls = messagesContainer.querySelectorAll('.jj-ai-msg');
      bubbleEls.forEach(function(el) {
        var role = el.classList.contains('bot') ? 'assistant' : 'user';
        var text = el.querySelector('.jj-ai-msg-bubble').textContent.trim();
        history.push({ role: role, content: text });
      });
      return history.slice(-6); // Only pass the last 6 messages to keep payloads small
    }
  })();
</script>
