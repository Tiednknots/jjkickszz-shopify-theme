<!--
  FIXES APPLIED (Aug 2026):
  1. Removed the MutationObserver on .cart-quantity — it called updateCartDot(),
     which wrote back to .cart-quantity.textContent, which re-triggered the
     observer, forever. That was an infinite background loop hitting /cart.js
     nonstop. Cart quantity is now refreshed only at the specific moments it
     can actually change (page load, cart open, add-to-cart, qty change,
     remove, insurance toggle) — no more self-triggering watcher.
  2. Consolidated three previously-duplicated script blocks (two competing
     window.openCartDrawer/closeCartDrawer definitions, and two identical
     checkout-discount-redirect click handlers) into one canonical set.
  3. Added a listener for ?open_cart=true so the redirect in templates/cart.liquid
     actually finishes what it starts — previously the flag was set in the URL
     but nothing ever read it, so the cart never opened after the redirect.
-->
<script>
(function() {
  var INSURANCE_VARIANT_ID = '50793201402142';

  function checkCartForInsurance(toggle) {
    fetch('/cart.js').then(function(r){ return r.json(); }).then(function(cart) {
      var hasInsurance = cart.items.some(function(item) { return item.variant_id.toString() === INSURANCE_VARIANT_ID; });
      toggle.checked = hasInsurance;
    });
  }

  function initShippingInsurance() {
    document.addEventListener('change', function(e) {
      if (e.target && e.target.id === 'shipping-insurance-toggle') {
        var toggle = e.target;
        if (toggle.checked) {
          fetch('/cart/add.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ items: [{ id: INSURANCE_VARIANT_ID, quantity: 1 }] })
          }).then(function() {
            window.refreshCartDrawer();
            if (window.Webflow && window.Webflow.require && window.Webflow.require('cart')) window.Webflow.require('cart').update();
          });
        } else {
          fetch('/cart.js').then(function(r){ return r.json(); }).then(function(cart) {
            var item = cart.items.find(function(i) { return i.variant_id.toString() === INSURANCE_VARIANT_ID; });
            if (item) {
              fetch('/cart/change.js', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id: item.key, quantity: 0 })
              }).then(function() {
                window.refreshCartDrawer();
                if (window.Webflow && window.Webflow.require && window.Webflow.require('cart')) window.Webflow.require('cart').update();
              });
            }
          });
        }
      }
    });

    // Check state whenever the cart opens
    document.addEventListener('click', function(e) {
      if (e.target.closest('.w-commerce-commercecartopenlink')) {
        setTimeout(function() {
          var toggle = document.getElementById('shipping-insurance-toggle');
          if (toggle) checkCartForInsurance(toggle);
        }, 500);
      }
    });
  }

  // Redirect to checkout with dynamic tiered bundle discount code (OUTFIT25, OUTFIT25-2, etc.)
  // NOTE: this is the only copy of this handler now — it was previously duplicated
  // in a second script block below, causing the redirect to fire twice per click.
  document.addEventListener('click', function(e) {
    var checkoutBtn = e.target.closest('a[href*="/checkout"], .w-commerce-commercecartcheckoutbutton');
    if (checkoutBtn) {
      var discountCode = sessionStorage.getItem('jj_outfit_discount_code') || (sessionStorage.getItem('jj_outfit_discount') === 'true' ? 'OUTFIT25' : null);
      if (discountCode) {
        e.preventDefault();
        e.stopPropagation();
        window.location.href = '/discount/' + discountCode + '?redirect=/checkout';
      }
    }
  }, true);

  document.addEventListener('DOMContentLoaded', function() {
    initShippingInsurance();
    window.refreshCartDrawer();
  });
})();
</script>

<script>
(function() {
  // ── Single canonical cart drawer controller ──────────────────────────
  // (Previously defined twice in this file; the second copy silently
  // overwrote the first and both sets of click listeners kept firing.)

  window.refreshCartDrawer = function() {
    var rootPath = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) || '/';
    fetch(rootPath + 'cart.js', { cache: 'no-store' })
      .then(function(r) { return r.json(); })
      .then(function(cart) {
        var countEls = document.querySelectorAll('.w-commerce-commercecartopenlinkcount, .cart-quantity');
        countEls.forEach(function(el) { el.textContent = cart.item_count || 0; });

        var flashDot = document.querySelector('.cart-flash-dot');
        if (flashDot) flashDot.style.display = (cart.item_count > 0) ? 'block' : 'none';

        var totalEls = document.querySelectorAll('.w-commerce-commercecartordervalue');
        var totalPriceStr = '$' + (((cart.total_price || 0) / 100).toFixed(2));
        totalEls.forEach(function(el) {
          el.textContent = totalPriceStr;
        });

        var emptyState = document.querySelector('.w-commerce-commercecartemptystate');
        var cartForm = document.querySelector('.w-commerce-commercecartform, [data-node-type="commerce-cart-form"]');
        var cartList = document.querySelector('.w-commerce-commercecartlist, [data-node-type="commerce-cart-list"]');

        if (!cartList || !cartForm || !emptyState) return;

        if (cart.item_count > 0 && cart.items && cart.items.length > 0) {
          emptyState.style.setProperty('display', 'none', 'important');
          cartForm.style.setProperty('display', 'block', 'important');

          var itemsHtml = '';
          cart.items.forEach(function(item) {
            var itemLinePrice = item.final_line_price !== undefined ? item.final_line_price : (item.line_price !== undefined ? item.line_price : (item.price * item.quantity));
            var priceFormatted = '$' + ((itemLinePrice / 100).toFixed(2));
            
            var imgUrl = '';
            if (typeof item.image === 'string' && item.image) {
              imgUrl = item.image;
            } else if (item.featured_image) {
              if (typeof item.featured_image === 'string') {
                imgUrl = item.featured_image;
              } else if (item.featured_image.url) {
                imgUrl = item.featured_image.url;
              }
            }

            var itemTitle = item.product_title || item.title || 'Product';
            var variantTitle = item.variant_title || '';

            itemsHtml += '<div data-node-type="cart-item" class="cart-item w-commerce-commercecartitem" style="display:flex;align-items:center;gap:12px;padding:12px 0;border-bottom:1px solid #222;">' +
              (imgUrl ? '<img class="image-12 w-commerce-commercecartitemimage" src="' + imgUrl + '" alt="' + itemTitle + '" style="width:60px;height:60px;object-fit:cover;border-radius:6px;flex-shrink:0;">' : '<div style="width:60px;height:60px;background:#222;border-radius:6px;flex-shrink:0;"></div>') +
              '<div class="w-commerce-commercecartiteminfo" style="flex-grow:1;min-width:0;">' +
                '<div class="text-block-784 w-commerce-commercecartproductname" style="font-weight:700;font-size:13px;color:#fff;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">' + itemTitle + '</div>' +
                '<div class="text-block-785" style="font-size:13px;color:#ccc;margin-top:2px;">' + priceFormatted + '</div>' +
                (variantTitle && variantTitle !== 'Default Title' ? '<div style="font-size:11px;color:#888;margin-top:2px;">Size: ' + variantTitle + '</div>' : '') +
                '<a class="remove-button jj-remove-cart-item" href="#" role="button" data-key="' + item.key + '" style="margin-top:4px;display:inline-block;font-size:11px;color:#ff4444;text-decoration:underline;">' +
                  '<div class="text-block-780">Remove</div>' +
                '</a>' +
              '</div>' +
              '<input class="w-commerce-commercecartquantity jj-cart-qty-input" data-key="' + item.key + '" type="number" min="1" value="' + item.quantity + '" style="width:45px;background:#111;color:#fff;border:1px solid #333;text-align:center;border-radius:4px;padding:4px;flex-shrink:0;">' +
            '</div>';
          });
          cartList.innerHTML = itemsHtml;

          cartList.querySelectorAll('.jj-remove-cart-item').forEach(function(btn) {
            btn.addEventListener('click', function(e) {
              e.preventDefault();
              var key = btn.getAttribute('data-key');
              fetch(rootPath + 'cart/change.js', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id: key, quantity: 0 })
              }).then(function() { window.refreshCartDrawer(); });
            });
          });

          cartList.querySelectorAll('.jj-cart-qty-input').forEach(function(input) {
            input.addEventListener('change', function() {
              var key = input.getAttribute('data-key');
              var q = parseInt(input.value, 10) || 1;
              fetch(rootPath + 'cart/change.js', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id: key, quantity: q })
              }).then(function() { window.refreshCartDrawer(); });
            });
          });

        } else {
          emptyState.style.setProperty('display', 'block', 'important');
          cartForm.style.setProperty('display', 'none', 'important');
          cartList.innerHTML = '';
        }
      })
      .catch(function(err) {
        console.error('Cart refresh error:', err);
      });
  };

  window.openCartDrawer = function() {
    var wrapper = document.querySelector('.w-commerce-commercecartwrapper, [data-node-type="commerce-cart-wrapper"]');
    var containerWrapper = document.querySelector('.w-commerce-commercecartcontainerwrapper, [data-node-type="commerce-cart-container-wrapper"]');
    var container = document.querySelector('.w-commerce-commercecartcontainer, [data-node-type="commerce-cart-container"]');

    if (wrapper) wrapper.setAttribute('data-cart-open', '');
    if (containerWrapper) {
      containerWrapper.classList.add('is-open');
      containerWrapper.style.setProperty('display', 'flex', 'important');
      containerWrapper.style.setProperty('opacity', '1', 'important');
      containerWrapper.style.setProperty('visibility', 'visible', 'important');
    }
    if (container) {
      container.style.setProperty('transform', 'translateX(0)', 'important');
      container.style.setProperty('opacity', '1', 'important');
      container.style.setProperty('visibility', 'visible', 'important');
    }
    window.refreshCartDrawer();
  };

  window.closeCartDrawer = function() {
    var wrapper = document.querySelector('.w-commerce-commercecartwrapper, [data-node-type="commerce-cart-wrapper"]');
    var containerWrapper = document.querySelector('.w-commerce-commercecartcontainerwrapper, [data-node-type="commerce-cart-container-wrapper"]');

    if (wrapper) wrapper.removeAttribute('data-cart-open');
    if (containerWrapper) {
      containerWrapper.classList.remove('is-open');
      containerWrapper.style.setProperty('display', 'none', 'important');
    }
  };

  // Capture phase click handler ensures instant response before any propagation block
  document.addEventListener('click', function(e) {
    var openBtn = e.target.closest('.w-commerce-commercecartopenlink, .cart-button, [data-node-type="commerce-cart-open-link"]');
    if (openBtn) {
      e.preventDefault();
      e.stopPropagation();
      window.openCartDrawer();
      return;
    }

    var closeBtn = e.target.closest('.w-commerce-commercecartcloselink, [data-node-type="commerce-cart-close-link"]');
    if (closeBtn) {
      e.preventDefault();
      e.stopPropagation();
      window.closeCartDrawer();
      return;
    }

    var containerWrapper = document.querySelector('.w-commerce-commercecartcontainerwrapper, [data-node-type="commerce-cart-container-wrapper"]');
    var container = document.querySelector('.w-commerce-commercecartcontainer, [data-node-type="commerce-cart-container"]');
    if (containerWrapper && containerWrapper.classList.contains('is-open') && e.target === containerWrapper && container && !container.contains(e.target)) {
      window.closeCartDrawer();
    }
  }, true);

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      window.closeCartDrawer();
    }
  });

  // ── Consume the ?open_cart=true flag set by templates/cart.liquid ────
  // Previously nothing read this param, so the "/cart redirects back and
  // opens the drawer" flow silently did nothing on arrival.
  document.addEventListener('DOMContentLoaded', function() {
    var params = new URLSearchParams(window.location.search);
    if (params.get('open_cart') === 'true') {
      window.openCartDrawer();
      params.delete('open_cart');
      var cleanUrl = window.location.pathname + (params.toString() ? '?' + params.toString() : '') + window.location.hash;
      window.history.replaceState({}, document.title, cleanUrl);
    }
  });
})();
</script>
