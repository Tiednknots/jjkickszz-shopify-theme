{%- assign collection = collections[section.settings.collection] -%}

<style>
  #col-grid-{{ section.id }} {
    margin-bottom: 4rem;
  }

  .col-grid-title-{{ section.id }} {
    text-align: center;
    margin-bottom: 2rem;
    font-family: 'Aerosoldierbasic Personal Use Only', 'Barlow Condensed', sans-serif;
    font-size: 2.5rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .banner-col-{{ section.id }} {
    position: relative;
    width: auto;
    margin-left: 20px;
    margin-right: 20px;
    margin-bottom: 2.5rem;
    overflow: hidden;
    border-radius: 8px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.4);
    height: {{ section.settings.desktop_banner_height }}px;
  }
  
  .banner-col-{{ section.id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  
  .banner-col-{{ section.id }} .banner-overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: rgba(0,0,0,0.3);
    z-index: 1;
  }

  /* Responsive Grid layouts */
  #col-grid-{{ section.id }} .collection-list-2.custom-grid-list {
    padding-left: 20px;
    padding-right: 20px;
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    justify-content: center;
    overflow: visible;
  }
  
  #col-grid-{{ section.id }} .collection-list-2.custom-grid-list .collection-item-2 {
    {%- if section.settings.desktop_columns == 2 -%}
      flex: 0 0 calc(50% - 10px) !important;
      width: calc(50% - 10px) !important;
    {%- elsif section.settings.desktop_columns == 3 -%}
      flex: 0 0 calc(33.333% - 14px) !important;
      width: calc(33.333% - 14px) !important;
    {%- else -%}
      flex: 0 0 calc(25% - 15px) !important;
      width: calc(25% - 15px) !important;
    {%- endif -%}
    min-width: 220px;
    margin: 0 !important;
  }

  @media (max-width: 991px) and (min-width: 768px) {
    #col-grid-{{ section.id }} .collection-list-2.custom-grid-list .collection-item-2 {
      flex: 0 0 calc(33.333% - 14px) !important;
      width: calc(33.333% - 14px) !important;
    }
  }

  @media (max-width: 767px) {
    .banner-col-{{ section.id }} {
      height: {{ section.settings.mobile_banner_height }}px;
      margin-left: 15px;
      margin-right: 15px;
    }

    /* 2x2/2-column vertical grid wrapping by default on mobile */
    #col-grid-{{ section.id }} .collection-list-2.custom-grid-list.grid-wrap {
      display: flex !important;
      flex-wrap: wrap !important;
      gap: 16px 12px !important;
      overflow: visible !important;
      padding-left: 15px !important;
      padding-right: 15px !important;
    }
    #col-grid-{{ section.id }} .collection-list-2.custom-grid-list.grid-wrap .collection-item-2 {
      flex: 0 0 calc(50% - 6px) !important;
      width: calc(50% - 6px) !important;
      min-width: 0 !important;
      margin: 0 !important;
    }
    #col-grid-{{ section.id }} .collection-list-2.custom-grid-list.grid-wrap .home-custom-img-wrap {
      height: 180px !important;
    }

    /* 1x1 Horizontal Scroll option */
    #col-grid-{{ section.id }} .collection-list-2.custom-grid-list.scroll-1x1 {
      display: flex !important;
      flex-wrap: nowrap !important;
      overflow-x: auto !important;
      gap: 12px !important;
      scroll-snap-type: x mandatory !important;
      padding: 1rem 15px !important;
      -webkit-overflow-scrolling: touch !important;
    }
    #col-grid-{{ section.id }} .collection-list-2.custom-grid-list.scroll-1x1 .collection-item-2 {
      flex: 0 0 75% !important;
      width: auto !important;
      scroll-snap-align: start !important;
      margin: 0 !important;
    }

    /* 2x2 Horizontal Scroll option */
    #col-grid-{{ section.id }} .collection-list-2.custom-grid-list.scroll-2x2 {
      display: grid !important;
      grid-template-rows: repeat(2, auto) !important;
      grid-auto-flow: column !important;
      overflow-x: auto !important;
      grid-column-gap: 12px !important;
      grid-row-gap: 16px !important;
      scroll-snap-type: x mandatory !important;
      padding: 1rem 15px !important;
      -webkit-overflow-scrolling: touch !important;
    }
    #col-grid-{{ section.id }} .collection-list-2.custom-grid-list.scroll-2x2 .collection-item-2 {
      width: 250px !important;
      flex: none !important;
      scroll-snap-align: start !important;
      margin: 0 !important;
    }
  }
</style>

<div class="home-section custom-collection-section" id="col-grid-{{ section.id }}">
  {%- if section.settings.heading != blank -%}
    <h1 class="col-grid-title-{{ section.id }}">{{ section.settings.heading }}</h1>
  {%- endif -%}

  {%- if section.settings.banner_image != blank -%}
    <div class="banner-col-{{ section.id }}">
      <img src="{{ section.settings.banner_image | img_url: '1920x' }}" alt="{{ section.settings.heading | escape }}" loading="lazy">
      <div class="banner-overlay"></div>
    </div>
  {%- endif -%}

  {%- if collection != blank -%}
    <div class="brand-view">
      <div class="collection-list-wrapper w-dyn-list">
        <div role="list" class="collection-list-2 contents-of-scroll home-custom-grid w-dyn-items custom-grid-list {{ section.settings.mobile_layout }}">
          {%- for item in collection.products limit: section.settings.limit -%}
            {%- if item.handle == 'shipping-insurance' or item.title contains 'Insurance' -%}{%- continue -%}{%- endif -%}
            <div role="listitem" class="collection-item-2 w-dyn-item">
              <a href="{{ item.url }}" class="link-block-2 w-inline-block">
                <div class="div-block-15 home-custom-img-wrap {% unless item.available %}jj-sold-out-card{% endunless %}">
                  <img loading="lazy" src="{{ item.featured_image | img_url: '600x' }}" alt="{{ item.featured_image.alt }}" class="image-6 home-custom-img" data-commerce-type="variation-image" srcset="{{ item.featured_image | img_url: '1920x' }} 1920w,{{ item.featured_image | img_url: '1600x' }} 1600w,{{ item.featured_image | img_url: '1366x' }} 1366w,{{ item.featured_image | img_url: '1024x' }} 1024w,{{ item.featured_image | img_url: '768x' }} 768w,{{ item.featured_image | img_url: '640x' }} 640w">
                  <div class="link-overlay bs">{{ item.vendor }}</div>
                  {%- unless item.available -%}<div class="jj-sold-out-badge">SOLD OUT</div>{%- endunless -%}
                </div>
                <div class="text-block-4 title">{{ item.title }}</div>
                <div data-commerce-type="variation-price" class="text-block-779">{{ item.price | money }}</div>
                <div class="div-block-1163">
                  <div class="text-block-4 asd">Sizes :</div>
                  <div class="size-contents">
                    {%- assign _avail_count = 0 -%}{%- for _sv in item.variants -%}{%- if _sv.inventory_quantity > 0 or _sv.inventory_policy == 'continue' -%}{%- assign _avail_count = _avail_count | plus: 1 -%}{%- endif -%}{%- endfor -%}{%- if _avail_count > 3 -%}<div class="text-block-4 asd sizes-variants">Multiple Sizes</div>{%- else -%}{%- for _sv in item.variants -%}{%- if _sv.inventory_quantity > 0 or _sv.inventory_policy == 'continue' -%}{%- assign _sl = _sv.title | strip -%}{%- assign _sl_down = _sl | downcase -%}{%- if _sl_down contains 'xxxl' or _sl_down contains '3xl' -%}{%- assign _sl = '3XL' -%}{%- elsif _sl_down contains 'xxl' or _sl_down contains '2xl' or _sl_down contains 'xx-large' or _sl_down contains 'xx large' or _sl_down == 'xxlarge' -%}{%- assign _sl = 'XXL' -%}{%- elsif _sl_down contains 'xl' or _sl_down contains 'x-large' or _sl_down contains 'x large' or _sl_down == 'xlarge' -%}{%- assign _sl = 'XL' -%}{%- elsif _sl_down contains 'small' or _sl_down == 's' -%}{%- assign _sl = 'S' -%}{%- elsif _sl_down contains 'medium' or _sl_down == 'm' -%}{%- assign _sl = 'M' -%}{%- elsif _sl_down contains 'large' or _sl_down == 'l' -%}{%- assign _sl = 'L' -%}{%- elsif _sl_down contains 'one size' or _sl_down contains 'onesize' or _sl_down contains 'osfm' or _sl_down contains 'os' -%}{%- assign _sl = 'O/S' -%}{%- endif -%}<div class="text-block-4 asd sizes-variants">{{ _sl }}</div>{%- endif -%}{%- endfor -%}{%- endif -%}
                  </div>
                </div>
              </a>
            </div>
          {%- endfor -%}
        </div>
      </div>
    </div>

    {%- if section.settings.button_text != blank -%}
      <div style="text-align:center;margin-top:2rem;">
        <a href="{{ section.settings.custom_button_link | default: collection.url }}" class="button w-button" style="background-color: var(--secret-red); color: #fff;">{{ section.settings.button_text }}</a>
      </div>
    {%- endif -%}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Custom Collection Grid",
  "tag": "section",
  "class": "custom-collection-grid-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "FEATURED PRODUCTS"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Select Collection"
    },
    {
      "type": "range",
      "id": "limit",
      "min": 4,
      "max": 24,
      "step": 1,
      "label": "Product Limit",
      "default": 12
    },
    {
      "type": "select",
      "id": "desktop_columns",
      "label": "Desktop Columns",
      "options": [
        { "value": "2", "label": "2 Columns" },
        { "value": "3", "label": "3 Columns" },
        { "value": "4", "label": "4 Columns (Default)" }
      ],
      "default": "4"
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile Layout Style",
      "options": [
        { "value": "grid-wrap", "label": "2x2 Vertical Grid" },
        { "value": "scroll-1x1", "label": "1x1 Horizontal Scroll" },
        { "value": "scroll-2x2", "label": "2x2 Horizontal Scroll" }
      ],
      "default": "grid-wrap"
    },
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "Optional Banner Image"
    },
    {
      "type": "range",
      "id": "desktop_banner_height",
      "min": 100,
      "max": 600,
      "step": 10,
      "unit": "px",
      "label": "Desktop Banner Height",
      "default": 300
    },
    {
      "type": "range",
      "id": "mobile_banner_height",
      "min": 100,
      "max": 400,
      "step": 10,
      "unit": "px",
      "label": "Mobile Banner Height",
      "default": 180
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Shop All"
    },
    {
      "type": "url",
      "id": "custom_button_link",
      "label": "Custom Button Link (Optional)"
    }
  ],
  "presets": [
    {
      "name": "Custom Collection Grid",
      "category": "Collection"
    }
  ]
}
{% endschema %}
