
          <div class="authentic-gaurentee-section">
            <div class="left-side-image-contents"><img src="{{ 'chatgpt-image-dec-10-2025-02_18_34-pm.png' | asset_url }}" loading="lazy" sizes="(max-width: 1536px) 100vw, 1536px" srcset="{{ 'chatgpt-image-dec-10-2025-02_18_34-pm.png' | asset_img_url: '500x' }} 500w, {{ 'chatgpt-image-dec-10-2025-02_18_34-pm.png' | asset_img_url: '800x' }} 800w, {{ 'chatgpt-image-dec-10-2025-02_18_34-pm.png' | asset_img_url: '1080x' }} 1080w, {{ 'chatgpt-image-dec-10-2025-02_18_34-pm.png' | asset_url }} 1536w" alt="" class="verified-image">
              <div class="background-video w-background-video w-background-video-atom" style="position: relative !important; width: 100%; height: 100%; overflow: hidden; border-radius: 8px;">
                <video autoplay loop muted playsinline style="width:100%; height:100%; object-fit:cover; position:absolute; inset:0;" poster="{{ 'streetwear_hoodie_video_generation2_poster.0000000.jpg' | asset_url }}">
                  <source src="{{ 'streetwear_hoodie_video_generation2_mp4.mp4' | asset_url }}" type="video/mp4">
                  <source src="{{ 'streetwear_hoodie_video_generation2_webm.webm' | asset_url }}" type="video/webm">
                </video>
              </div>
            </div>
            <div class="right-side-authentic-content"><img src="{{ 'freesample-vectorizer-io-gemini_generated_image_8vr3an8vr3an8vr3_x-design.png' | asset_url }}" loading="lazy" sizes="(max-width: 4494px) 100vw, 4494px" srcset="{{ 'freesample-vectorizer-io-gemini_generated_image_8vr3an8vr3an8vr3_x-design.png' | asset_img_url: '500x' }} 500w, {{ 'freesample-vectorizer-io-gemini_generated_image_8vr3an8vr3an8vr3_x-design.png' | asset_img_url: '800x' }} 800w, {{ 'freesample-vectorizer-io-gemini_generated_image_8vr3an8vr3an8vr3_x-design.png' | asset_img_url: '1080x' }} 1080w, {{ 'freesample-vectorizer-io-gemini_generated_image_8vr3an8vr3an8vr3_x-design.png' | asset_img_url: '1600x' }} 1600w, {{ 'freesample-vectorizer-io-gemini_generated_image_8vr3an8vr3an8vr3_x-design.png' | asset_img_url: '2000x' }} 2000w, {{ 'freesample-vectorizer-io-gemini_generated_image_8vr3an8vr3an8vr3_x-design.png' | asset_img_url: '2600x' }} 2600w, {{ 'freesample-vectorizer-io-gemini_generated_image_8vr3an8vr3an8vr3_x-design.png' | asset_img_url: '3200x' }} 3200w, {{ 'freesample-vectorizer-io-gemini_generated_image_8vr3an8vr3an8vr3_x-design.png' | asset_url }} 4494w" alt="" class="authentic-image-policy">
              {%- assign _raw_title = section.settings.section_title -%}
              {%- if _raw_title contains "VERIFIED" and _raw_title contains "AUTHENTICITY" -%}
                <h1 class="heading-3"><span class="jj-title-word">VERIFIED</span><br class="jj-mobile-br"><span class="jj-title-word">AUTHENTICITY</span></h1>
              {%- else -%}
                <h1 class="heading-3">{{ _raw_title }}</h1>
              {%- endif -%}
              <h6 class="heading-2">{{ section.settings.section_sub_heading | newline_to_br }}</h6>
              <h6 class="paragraph-2 text">{{ section.settings.authentic_full_text | newline_to_br }}</h6>
              <a href="/pages/{{ section.settings.button_link }}" class="button w-button" style="background-color: {{ section.settings.button_color }} !important; color: {{ section.settings.button_text_color }} !important;">{{ section.settings.button_link_text }}</a>
            </div>
          </div>
        

<script>var currentSection = document.currentScript.closest('.shopify-section');currentSection.setAttribute("class","section-over-view");</script>
        
{% schema %}
{
  "name": "general section",
  "tag": "section",
  "class": "section-over-view",
  "settings": [
    {
      "type": "text",
      "id": "section_title",
      "label": "section title",
      "default": "VERIFIED AUTHENTICITY"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "button-text",
      "default": "Authenticity Policy"
    },
    {
      "type": "textarea",
      "id": "section_sub_heading",
      "label": "section sub heading",
      "default": "100% Authentic. Every Single Time."
    },
    {
      "type": "textarea",
      "id": "authentic_full_text",
      "label": "authentic full text",
      "default": "We don’t play games with quality. Every piece that touches our inventory is inspected by hand—checking the stitching, the weight, and the tags. If it’s not legit, it doesn’t ship. You get exactly what you paid for, verified and secured."
    },
    {
      "type": "page",
      "id": "button_link",
      "label": "button link"
    },
    {
      "type": "text",
      "id": "button_link_text",
      "label": "button link Text",
      "default": "{{ section.settings.button_text }}"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "button text color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "button color",
      "default": "#000000"
    }
  ],
  "presets": [
    {
      "name": "General Section"
    }
  ]
}
{% endschema %}