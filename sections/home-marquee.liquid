{% schema %}
{
  "name": "Marquee",
  "tag": "section",
  "class": "jj-home-marquee-section",
  "settings": [
    {
      "type": "text",
      "id": "text_1",
      "label": "Text Item 1",
      "default": "100% Authentic Heat 🔥 Guaranteed"
    },
    {
      "type": "text",
      "id": "text_2",
      "label": "Text Item 2",
      "default": "All Sales Are Final"
    },
    {
      "type": "text",
      "id": "text_3",
      "label": "Text Item 3",
      "default": "Free Shipping on orders over $400"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "checkbox",
      "id": "show_borders",
      "label": "Show Top and Bottom Borders",
      "default": true
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "#2e2e2e"
    }
  ],
  "presets": [
    {
      "name": "Marquee"
    }
  ]
}
{% endschema %}

<style>
  .jj-home-marquee-section {
    width: 100% !important;
    display: block !important;
    position: -webkit-sticky !important;
    position: sticky !important;
    top: 80px !important;
    z-index: 90 !important;
    margin: 0 !important;
    padding: 0 !important;
  }
  @media (max-width: 767px) {
    .jj-home-marquee-section {
      top: 60px !important;
    }
  }
  .jj-home-marquee-wrapper {
    width: 100% !important;
    height: 44px !important;
    min-height: 44px !important;
    max-height: 44px !important;
    display: flex !important;
    align-items: center !important;
    overflow: hidden !important;
    box-sizing: border-box !important;
  }
  .jj-home-marquee-inner {
    width: 100% !important;
    height: 100% !important;
    display: flex !important;
    align-items: center !important;
    overflow: hidden !important;
    position: relative !important;
    mask-image: linear-gradient(to right, transparent 0%, black 15%, black 85%, transparent 100%) !important;
    -webkit-mask-image: linear-gradient(to right, transparent 0%, black 15%, black 85%, transparent 100%) !important;
  }
  .jj-home-marquee-track {
    display: flex !important;
    align-items: center !important;
    width: max-content !important;
    flex-shrink: 0 !important;
    animation: jj-home-marquee-anim 25s linear infinite !important;
    will-change: transform !important;
  }
  .jj-home-marquee-group {
    display: flex !important;
    align-items: center !important;
    padding-right: 4rem !important;
    flex-shrink: 0 !important;
  }
  .jj-home-marquee-badge {
    font-size: 11px !important;
    font-family: 'Inter', -apple-system, sans-serif !important;
    font-weight: 600 !important;
    text-transform: uppercase !important;
    letter-spacing: 0.12em !important;
    white-space: nowrap !important;
    margin-right: 3rem !important;
    color: inherit !important;
  }
  @keyframes jj-home-marquee-anim {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
</style>

<div class="jj-home-marquee-wrapper" style="background-color: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }}; {% if section.settings.show_borders %}border-top: 1px solid {{ section.settings.border_color }}; border-bottom: 1px solid {{ section.settings.border_color }};{% endif %}">
  <div class="jj-home-marquee-inner">
    <div class="jj-home-marquee-track">
      {% for i in (1..6) %}
      <div class="jj-home-marquee-group">
        <span class="jj-home-marquee-badge">{{ section.settings.text_1 }}</span>
        <span class="jj-home-marquee-badge">{{ section.settings.text_2 }}</span>
        <span class="jj-home-marquee-badge">{{ section.settings.text_3 }}</span>
      </div>
      {% endfor %}
    </div>
  </div>
</div>
