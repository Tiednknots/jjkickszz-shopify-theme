{% schema %}
{
  "name": "Marquee",
  "tag": "section",
  "class": "white-section menu hero",
  "settings": [
    {
      "type": "text",
      "id": "text_1",
      "label": "Text Item 1",
      "default": "100% Authentic Heat 🔥 Guaranteed"
    },
    {
      "type": "text",
      "id": "text_2",
      "label": "Text Item 2",
      "default": "All Sales Are Final"
    },
    {
      "type": "text",
      "id": "text_3",
      "label": "Text Item 3",
      "default": "Free Shipping on orders over $400"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    },
    {
      "type": "checkbox",
      "id": "show_borders",
      "label": "Show Top and Bottom Borders",
      "default": true
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "#2e2e2e"
    }
  ],
  "presets": [
    {
      "name": "Marquee"
    }
  ]
}
{% endschema %}

<section class="section-3" style="background-color: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }}; {% if section.settings.show_borders %}border-top: 1px solid {{ section.settings.border_color }}; border-bottom: 1px solid {{ section.settings.border_color }};{% endif %}">
  <div class="code-embed-3 w-embed">
    <style>
      .jj-marquee-wrapper { width: 100%; height: 100%; display: flex; justify-content: center; align-items: center; position: relative; }
      .jj-centered-mask { width: 60%; max-width: 800px; height: 100%; overflow: hidden; display: flex; align-items: center; mask-image: linear-gradient(to right, transparent 0%, black 15%, black 85%, transparent 100%); -webkit-mask-image: linear-gradient(to right, transparent 0%, black 15%, black 85%, transparent 100%); }
      .jj-marquee-track { display: flex; align-items: center; width: max-content; flex-shrink: 0; animation: promo-scroll 25s linear infinite; }
      .jj-content-group { display: flex; align-items: center; padding-right: 6rem; }
      .jj-text-item { font-size: inherit; color: inherit; font-weight: inherit; white-space: nowrap; margin-right: 4rem; }
      .jj-text-item:last-child { margin-right: 0; }
      @keyframes promo-scroll { 0% { transform: translateX(0); } 100% { transform: translateX(-50%); } }
      @media (max-width: 767px) { .jj-marquee-track { animation-duration: 20s; } .jj-centered-mask { width: 90%; } .jj-content-group { padding-right: 3rem; } .jj-text-item { margin-right: 2rem; } }
    </style>
    <div class="jj-marquee-wrapper">
      <div class="jj-centered-mask">
        <div class="jj-marquee-track">
          {% for i in (1..4) %}
          <div class="jj-content-group">
            <span class="jj-text-item">{{ section.settings.text_1 }}</span>
            <span class="jj-text-item">{{ section.settings.text_2 }}</span>
            <span class="jj-text-item">{{ section.settings.text_3 }}</span>
          </div>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</section>
