
        <section class="section-5 black-background">
          <div class="code-embed-5 w-embed w-script">{{ section.settings.radio_iframe }}</div>
        </section>
      

<script>var currentSection = document.currentScript.closest('.shopify-section');currentSection.setAttribute("class","section-hold");</script>
        
{% schema %}
{
  "name": "Radio",
  "tag": "div",
  "class": "section-hold",
  "settings": [
    {
      "type": "html",
      "id": "radio_iframe",
      "label": "Radio iframe",
      "default": "\n            <style>\n  /* --- 1. CONTAINER --- */\n  .radio-hero-section {\n    position: relative;\n    width: 100%;\n    height: 100%;\n    background: radial-gradient(circle at center, #232323 0%, #050505 90%);\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n    overflow: hidden;\n    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;\n  }\n  /* --- 2. THE ASSEMBLY --- */\n  .vinyl-assembly {\n    position: relative;\n    width: 100%;\n    max-width: 320px;\n    aspect-ratio: 1 / 1;\n    z-index: 10;\n    cursor: pointer;\n  }\n  /* Sleeve (Cover Art) */\n  .vinyl-sleeve {\n    position: absolute;\n    top: 0; left: 0;\n    width: 100%; height: 100%;\n    background-image: url('https://www.udiscovermusic.com/wp-content/uploads/2018/06/90s-Hip-Hop.jpg');\n    background-size: cover;\n    background-position: center;\n    box-shadow: 0 10px 40px rgba(0,0,0,0.8);\n    z-index: 20; \n    border-radius: 2px;\n  }\n  /* --- 3. THE SLIDING RECORD --- */\n  .vinyl-disc-wrapper {\n    position: absolute;\n    top: 2%; \n    left: 2%; \n    width: 96%; \n    height: 96%;\n    border-radius: 50%;\n    display: flex; align-items: center; justify-content: center;\n    transition: transform 0.8s cubic-bezier(0.4, 0.0, 0.2, 1);\n    z-index: 15; /* Sits behind sleeve initially */\n  }\n  /* The Black Vinyl Image */\n  .vinyl-raw-img {\n    width: 100%; \n    height: 100%;\n    display: block; /* Fixes visibility issues */\n    object-fit: contain;\n    filter: drop-shadow(0 4px 10px rgba(0,0,0,0.5));\n    animation: spin linear 4s infinite;\n    animation-play-state: paused;\n  }\n  /* Center Label */\n  .vinyl-center-label {\n    position: absolute;\n    width: 38%; height: 38%;\n    background: #b71c1c;\n    border-radius: 50%;\n    border: 3px solid #fff;\n    display: flex; flex-direction: column;\n    align-items: center; justify-content: center;\n    text-align: center;\n    color: #fff;\n    animation: spin linear 4s infinite;\n    animation-play-state: paused;\n    box-shadow: inset 0 0 10px rgba(0,0,0,0.5);\n  }\n  .label-text-top { font-size: 10px; opacity: 0.9; letter-spacing: 1px; margin-bottom: 2px; }\n  .label-text-main { font-size: 16px; font-weight: 900; line-height: 1; text-transform: uppercase; }\n  .label-text-btm { font-size: 9px; margin-top: 4px; opacity: 0.8; }\n  /* --- 4. ANIMATIONS --- */\n  /* Slide Out logic */\n  .vinyl-assembly.is-playing .vinyl-disc-wrapper {\n    transform: translateX(40%); /* Slide out 40% to the right */\n  }\n  /* Spin logic */\n  .vinyl-assembly.is-playing .vinyl-raw-img,\n  .vinyl-assembly.is-playing .vinyl-center-label {\n    animation-play-state: running;\n  }\n  @keyframes spin { 100% { transform: rotate(360deg); } }\n  /* --- 5. CONTROLS --- */\n  .radio-meta {\n    margin-top: 50px;\n    z-index: 30;\n    display: flex; flex-direction: column; align-items: center; gap: 20px;\n  }\n  .album-title { color: #fff; text-transform: uppercase; letter-spacing: 2px; font-size: 14px; opacity: 0.6; }\n  .play-btn-hero {\n    width: 70px; height: 70px; border-radius: 50%;\n    background: #fff; color: #000;\n    display: flex; align-items: center; justify-content: center;\n    cursor: pointer; transition: transform 0.2s, background 0.2s;\n  }\n  .play-btn-hero:hover { transform: scale(1.1); background: #c60000; color: white; }\n  .play-btn-hero svg { width: 28px; height: 28px; fill: currentColor; }\n  #hero-pause { display: none; }\n</style>\n            <div class=\"radio-hero-section\">\n              <div class=\"vinyl-assembly\" id=\"hero-vinyl-assembly\">\n                <div class=\"vinyl-sleeve\"></div>\n                <div class=\"vinyl-disc-wrapper\">\n                  <img src=\"https://upload.wikimedia.org/wikipedia/commons/thumb/b/b6/Vinyl_record.svg/1024px-Vinyl_record.svg.png\" class=\"vinyl-raw-img\" alt=\"Vinyl Record\">\n                  <div class=\"vinyl-center-label\">\n                    <span class=\"label-text-top\">NYC CLASSICS</span>\n                    <span class=\"label-text-main\">SIDE<br>A</span>\n                    <span class=\"label-text-btm\">1994</span>\n                  </div>\n                </div>\n              </div>\n              <div class=\"radio-meta\">\n                <div class=\"album-title\">Now Spinning</div>\n                <div class=\"play-btn-hero\" id=\"hero-toggle-btn\">\n                  <svg id=\"hero-play\" viewBox=\"0 0 24 24\">\n                    <path d=\"M8 5v14l11-7z\"></path>\n                  </svg>\n                  <svg id=\"hero-pause\" viewBox=\"0 0 24 24\">\n                    <path d=\"M6 19h4V5H6v14zm8-14v14h4V5h-4z\"></path>\n                  </svg>\n                </div>\n              </div>\n            </div>\n            <script>\n(function() {\n  var initRadio = function() {\n    var globalAudio = document.getElementById('jj-audio');\n    var globalBar = document.getElementById('jj-player');\n    var globalTrigger = document.getElementById('jj-trigger');\n    var heroAssembly = document.getElementById('hero-vinyl-assembly');\n    var heroBtn = document.getElementById('hero-toggle-btn');\n    var heroPlayIcon = document.getElementById('hero-play');\n    var heroPauseIcon = document.getElementById('hero-pause');\n    if (!globalAudio || !heroAssembly) return;\n    // SYNC LOGIC\n    var syncUI = function() {\n      if (!document.body.contains(heroAssembly)) {\n        globalAudio.removeEventListener('play', syncUI);\n        globalAudio.removeEventListener('pause', syncUI);\n        return;\n      }\n      if (!globalAudio.paused) {\n        heroAssembly.classList.add('is-playing');\n        heroPlayIcon.style.display = 'none';\n        heroPauseIcon.style.display = 'block';\n      } else {\n        heroAssembly.classList.remove('is-playing');\n        heroPlayIcon.style.display = 'block';\n        heroPauseIcon.style.display = 'none';\n      }\n    };\n    // CLICK LOGIC\n    var toggleAudio = function(e) {\n      e.preventDefault();\n      if (globalAudio.paused) {\n        globalAudio.play();\n        if(globalBar) globalBar.style.transform = \"translateY(0%)\";\n        if(globalTrigger) globalTrigger.style.transform = \"scale(0)\";\n      } else {\n        globalAudio.pause();\n      }\n      syncUI();\n    };\n    heroBtn.onclick = toggleAudio;\n    heroAssembly.onclick = toggleAudio;\n    globalAudio.addEventListener('play', syncUI);\n    globalAudio.addEventListener('pause', syncUI);\n    syncUI();\n  };\n  initRadio();\n  setTimeout(initRadio, 100);\n})();\n</script>\n          "
    }
  ]
}
{% endschema %}