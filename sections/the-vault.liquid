
{% schema %}
{
  "name": "The Vault Room",
  "tag": "section",
  "class": "vault-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "THE VAULT"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "GRAIL SCANNER"
    },
    {
      "type": "text",
      "id": "instruction",
      "label": "Instruction",
      "default": "SCAN THE HEAT. LOCK IN YOUR LOOK."
    },
    {
      "type": "url",
      "id": "iframe_url",
      "label": "Iframe URL",
      "default": "https://jjvault.netlify.app"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#080808"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "The Vault Room"
    }
  ]
}
{% endschema %}

<style>
  .vault-container {
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    padding: 8rem 2rem;
    text-align: center;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
  }
  .vault-header {
    margin-bottom: 5rem;
    max-width: 800px;
  }
  .vault-title {
    font-family: 'Aerosoldierbasic Personal Use Only', sans-serif;
    font-size: clamp(3rem, 10vw, 6rem);
    letter-spacing: 0.3rem;
    margin-bottom: 0.5rem;
    text-transform: uppercase;
    color: #c60000; /* Adding a hit of brand red */
    text-shadow: 0 0 20px rgba(198,0,0,0.3);
  }
  .vault-subtitle {
    font-family: 'Aerosoldierbasic Personal Use Only', sans-serif;
    font-size: 1.5rem;
    letter-spacing: 0.15rem;
    margin-bottom: 1.5rem;
    opacity: 0.9;
  }
  .vault-instruction {
    font-size: 0.9rem;
    letter-spacing: 0.2rem;
    opacity: 0.6;
    text-transform: uppercase;
    font-weight: 300;
  }
  .vault-iframe-wrapper {
    position: relative;
    width: 100%;
    max-width: 1300px;
    height: 85vh;
    min-height: 650px;
    background: #000;
    border-radius: 4px;
    overflow: hidden;
    box-shadow: 0 30px 100px rgba(0,0,0,0.8);
    border: 1px solid #1a1a1a;
  }
  .vault-iframe {
    width: 100%;
    height: 100%;
    border: none;
  }
  
  /* NY Streetwear Loading State */
  .vault-loader {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: #000;
    z-index: 2;
    transition: opacity 0.5s ease;
  }
  .vault-loader.hidden {
    opacity: 0;
    pointer-events: none;
  }
  .loader-text {
    font-family: 'Aerosoldierbasic Personal Use Only', sans-serif;
    font-size: 1.2rem;
    letter-spacing: 0.2rem;
    animation: pulse-vault 1.5s infinite;
  }
  @keyframes pulse-vault {
    0% { opacity: 0.4; }
    50% { opacity: 1; }
    100% { opacity: 0.4; }
  }

  @media (max-width: 767px) {
    .vault-container {
      padding: 6rem 1rem;
    }
    .vault-header {
      margin-bottom: 3rem;
    }
    .vault-iframe-wrapper {
      height: 75vh;
      min-height: 500px;
    }
  }
</style>

<div class="vault-container">
  <div class="vault-header">
    <h1 class="vault-title">{{ section.settings.heading }}</h1>
    <div class="vault-subtitle">{{ section.settings.subheading }}</div>
    <div class="vault-instruction">{{ section.settings.instruction }}</div>
  </div>

  <div class="vault-iframe-wrapper">
    <div id="vault-loader" class="vault-loader">
       <div class="loader-text">INITIALIZING SCANNER...</div>
    </div>
    <iframe id="the-vault-frame" src="{{ section.settings.iframe_url }}" class="vault-iframe" title="Grail Scanner" allow="camera; microphone; clipboard-write" onload="document.getElementById('vault-loader').classList.add('hidden')">
    </iframe>
  </div>
</div>

<!-- Cart toast banner -->
<div id="vault-cart-toast" style="display:none;position:fixed;top:20px;right:20px;background:#111;color:#fff;padding:16px 24px;border-radius:8px;box-shadow:0 4px 20px rgba(0,0,0,0.3);z-index:99999;font-family:sans-serif;font-size:14px;border:1px solid #333;">
  ✓ Item added to cart!
  <a href="/cart" style="color:#c60000;margin-left:12px;text-decoration:underline;">View Cart</a>
</div>

<script>
window.addEventListener('message', function(event) {
  if (!event.data || event.data.action !== 'ADD_TO_CART') return;
  var variantId = event.data.variantId;
  console.log('[The Vault] Adding variant:', variantId);
  fetch('/cart/add.js', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ items: [{ id: variantId, quantity: 1 }] })
  })
  .then(function(res) { return res.json(); })
  .then(function() {
    var toast = document.getElementById('vault-cart-toast');
    if (toast) {
      toast.style.display = 'block';
      toast.style.opacity = '1';
      setTimeout(function() {
        toast.style.opacity = '0';
        setTimeout(function() { toast.style.display = 'none'; }, 300);
      }, 4000);
    }
    return fetch('/cart.js');
  })
  .then(function(res) { return res.json(); })
  .then(function(cart) {
    if (typeof updateCartDot === 'function') updateCartDot();
    var events = ['cart:refresh', 'cart:updated', 'cart:change', 'header:cart-update'];
    events.forEach(function(name) {
      document.dispatchEvent(new CustomEvent(name, { bubbles: true, detail: { cart: cart } }));
    });
  })
  .catch(function(err) {
    console.error('[The Vault] Error:', err);
    alert('Could not add item to cart. Please try again.');
  });
});
</script>
