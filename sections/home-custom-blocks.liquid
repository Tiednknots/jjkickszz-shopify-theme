{%- if section.settings.enable_section -%}
  <div class="custom-home-blocks-wrapper">
    {%- for block in section.blocks -%}
      {%- if block.settings.enable_block == false -%}{%- continue -%}{%- endif -%}
      
      {%- case block.type -%}
        {%- when 'collection_block' -%}
          {%- assign collection = collections[block.settings.collection] -%}
          {%- if collection != blank -%}
            
            <style>
              .banner-{{ block.id }} {
                position: relative;
                width: auto;
                margin-left: 20px;
                margin-right: 20px;
                margin-bottom: 2rem;
                overflow: hidden;
                border-radius: 8px;
                box-shadow: 0 4px 20px rgba(0,0,0,0.4);
              }
              .banner-{{ block.id }} img {
                width: 100%;
                height: 100%;
                object-fit: cover;
              }
              .banner-{{ block.id }} .banner-overlay {
                position: absolute;
                top: 0; left: 0; right: 0; bottom: 0;
                background: rgba(0,0,0,0.3);
                z-index: 1;
              }
              @media (max-width: 767px) {
                .banner-{{ block.id }} {
                  height: {{ block.settings.mobile_height }}px !important;
                  margin-left: 15px;
                  margin-right: 15px;
                }
              }

              /* Grid list container overrides */
              #block-{{ block.id }} .collection-list-2.custom-grid-list {
                padding-left: 20px;
                padding-right: 20px;
                display: flex;
                flex-wrap: wrap;
                gap: 20px;
                justify-content: center;
                overflow: visible;
              }
              
              #block-{{ block.id }} .collection-list-2.custom-grid-list .collection-item-2 {
                flex: 0 0 calc(25% - 15px) !important;
                width: calc(25% - 15px) !important;
                min-width: 220px;
                margin: 0 !important;
              }

              @media (max-width: 991px) and (min-width: 768px) {
                #block-{{ block.id }} .collection-list-2.custom-grid-list .collection-item-2 {
                  flex: 0 0 calc(33.333% - 14px) !important;
                  width: calc(33.333% - 14px) !important;
                }
              }

              @media (max-width: 767px) {
                /* 2x2/2-column vertical grid wrapping by default on mobile */
                #block-{{ block.id }} .collection-list-2.custom-grid-list.grid-wrap {
                  display: flex !important;
                  flex-wrap: wrap !important;
                  gap: 16px 12px !important;
                  overflow: visible !important;
                  padding-left: 15px !important;
                  padding-right: 15px !important;
                }
                #block-{{ block.id }} .collection-list-2.custom-grid-list.grid-wrap .collection-item-2 {
                  flex: 0 0 calc(50% - 6px) !important;
                  width: calc(50% - 6px) !important;
                  min-width: 0 !important;
                  margin: 0 !important;
                }
                #block-{{ block.id }} .collection-list-2.custom-grid-list.grid-wrap .home-custom-img-wrap {
                  height: 180px !important;
                }


                /* 1x1 Horizontal Scroll option */
                #block-{{ block.id }} .collection-list-2.custom-grid-list.scroll-1x1 {
                  display: flex !important;
                  flex-wrap: nowrap !important;
                  overflow-x: auto !important;
                  gap: 12px !important;
                  scroll-snap-type: x mandatory !important;
                  padding: 1rem 15px !important;
                  -webkit-overflow-scrolling: touch !important;
                }
                #block-{{ block.id }} .collection-list-2.custom-grid-list.scroll-1x1 .collection-item-2 {
                  flex: 0 0 75% !important;
                  width: auto !important;
                  scroll-snap-align: start !important;
                  margin: 0 !important;
                }

                /* 2x2 Horizontal Scroll option */
                #block-{{ block.id }} .collection-list-2.custom-grid-list.scroll-2x2 {
                  display: grid !important;
                  grid-template-rows: repeat(2, auto) !important;
                  grid-auto-flow: column !important;
                  overflow-x: auto !important;
                  grid-column-gap: 12px !important;
                  grid-row-gap: 16px !important;
                  scroll-snap-type: x mandatory !important;
                  padding: 1rem 15px !important;
                  -webkit-overflow-scrolling: touch !important;
                }
                #block-{{ block.id }} .collection-list-2.custom-grid-list.scroll-2x2 .collection-item-2 {
                  width: 250px !important;
                  flex: none !important;
                  scroll-snap-align: start !important;
                  margin: 0 !important;
                }
              }
            </style>

            <section class="home-section custom-collection-section" id="block-{{ block.id }}" style="margin-bottom: 4rem;">
              <h1 class="heading" style="text-align: center; margin-bottom: 1.5rem;">{{ block.settings.heading }}</h1>
              
              {%- if block.settings.banner_image != blank -%}
                <div class="banner-{{ block.id }}">
                  <img src="{{ block.settings.banner_image | img_url: '1920x' }}" alt="{{ block.settings.heading }}" loading="lazy">
                  <div class="banner-overlay"></div>
                </div>
              {%- endif -%}

              <div class="brand-view">
                <div class="collection-list-wrapper w-dyn-list">
                  <div role="list" class="collection-list-2 contents-of-scroll home-custom-grid w-dyn-items custom-grid-list {{ block.settings.mobile_layout }}">
                    {%- for item in collection.products limit: block.settings.limit -%}
                      {%- if item.handle == 'shipping-insurance' or item.title contains 'Insurance' -%}{%- continue -%}{%- endif -%}
                      <div role="listitem" class="collection-item-2 w-dyn-item">
                        <a href="{{ item.url }}" class="link-block-2 w-inline-block">
                          <div class="div-block-15 home-custom-img-wrap {% unless item.available %}jj-sold-out-card{% endunless %}">
                            <img loading="lazy" src="{{ item.featured_image | img_url: '600x' }}" alt="{{ item.featured_image.alt }}" class="image-6 home-custom-img" data-commerce-type="variation-image" srcset="{{ item.featured_image | img_url: '1920x' }} 1920w,{{ item.featured_image | img_url: '1600x' }} 1600w,{{ item.featured_image | img_url: '1366x' }} 1366w,{{ item.featured_image | img_url: '1024x' }} 1024w,{{ item.featured_image | img_url: '768x' }} 768w,{{ item.featured_image | img_url: '640x' }} 640w">
                            <div class="link-overlay bs">{{ item.vendor }}</div>
                            {%- unless item.available -%}<div class="jj-sold-out-badge">SOLD OUT</div>{%- endunless -%}
                          </div>
                          <div class="text-block-4 title">{{ item.title }}</div>
                          <div data-commerce-type="variation-price" class="text-block-779">{{ item.price | money }}</div>
                          <div class="div-block-1163">
                            <div class="text-block-4 asd">Sizes :</div>
                            <div class="size-contents">
                              {%- assign _avail_count = 0 -%}{%- for _sv in item.variants -%}{%- if _sv.inventory_quantity > 0 or _sv.inventory_policy == 'continue' -%}{%- assign _avail_count = _avail_count | plus: 1 -%}{%- endif -%}{%- endfor -%}{%- if _avail_count > 3 -%}<div class="text-block-4 asd sizes-variants">Multiple Sizes</div>{%- else -%}{%- for _sv in item.variants -%}{%- if _sv.inventory_quantity > 0 or _sv.inventory_policy == 'continue' -%}{%- assign _sl = _sv.title | strip -%}{%- assign _sl_down = _sl | downcase -%}{%- if _sl_down contains 'xxxl' or _sl_down contains '3xl' -%}{%- assign _sl = '3XL' -%}{%- elsif _sl_down contains 'xxl' or _sl_down contains '2xl' or _sl_down contains 'xx-large' or _sl_down contains 'xx large' or _sl_down == 'xxlarge' -%}{%- assign _sl = 'XXL' -%}{%- elsif _sl_down contains 'xl' or _sl_down contains 'x-large' or _sl_down contains 'x large' or _sl_down == 'xlarge' -%}{%- assign _sl = 'XL' -%}{%- elsif _sl_down contains 'small' or _sl_down == 's' -%}{%- assign _sl = 'S' -%}{%- elsif _sl_down contains 'medium' or _sl_down == 'm' -%}{%- assign _sl = 'M' -%}{%- elsif _sl_down contains 'large' or _sl_down == 'l' -%}{%- assign _sl = 'L' -%}{%- elsif _sl_down contains 'one size' or _sl_down contains 'onesize' or _sl_down contains 'osfm' or _sl_down contains 'os' -%}{%- assign _sl = 'O/S' -%}{%- endif -%}<div class="text-block-4 asd sizes-variants">{{ _sl }}</div>{%- endif -%}{%- endfor -%}{%- endif -%}
                            </div>
                          </div>
                        </a>
                      </div>
                    {%- endfor -%}
                  </div>
                </div>
              </div>

              {%- if block.settings.button_text != blank -%}
                <div style="text-align:center;margin-top:2rem;">
                  <a href="{{ block.settings.custom_button_link | default: collection.url }}" class="button w-button">{{ block.settings.button_text }}</a>
                </div>
              {%- endif -%}
            </section>
          {%- endif -%}

        {%- when 'html_embed' -%}
          {%- if block.settings.html_code != blank -%}
            <div class="custom-html-block" id="block-{{ block.id }}" style="margin-bottom: 3rem;">
              {{ block.settings.html_code }}
            </div>
          {%- endif -%}

      {%- endcase -%}
    {%- endfor -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Custom Home Blocks",
  "tag": "section",
  "class": "custom-home-blocks-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_section",
      "label": "Enable Custom Homepage Blocks",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "collection_block",
      "name": "Collection Banner Grid",
      "settings": [
        {
          "type": "checkbox",
          "id": "enable_block",
          "label": "Enable Block",
          "default": true
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Block Heading",
          "default": "FEATURED COLLECTION"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Select Collection"
        },
        {
          "type": "image_picker",
          "id": "banner_image",
          "label": "Banner Image"
        },
        {
          "type": "range",
          "id": "desktop_height",
          "min": 100,
          "max": 800,
          "step": 10,
          "unit": "px",
          "label": "Desktop Banner Height",
          "default": 350
        },
        {
          "type": "range",
          "id": "mobile_height",
          "min": 100,
          "max": 600,
          "step": 10,
          "unit": "px",
          "label": "Mobile Banner Height",
          "default": 200
        },
        {
          "type": "select",
          "id": "mobile_layout",
          "label": "Mobile Layout Style",
          "options": [
            {
              "value": "grid-wrap",
              "label": "2x2 Vertical Grid (Default)"
            },
            {
              "value": "scroll-1x1",
              "label": "1x1 Horizontal Scroll"
            },
            {
              "value": "scroll-2x2",
              "label": "2x2 Horizontal Scroll"
            }
          ],
          "default": "grid-wrap"
        },
        {
          "type": "range",
          "id": "limit",
          "min": 4,
          "max": 24,
          "step": 1,
          "label": "Product Limit",
          "default": 12
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button Text",
          "default": "Shop All"
        },
        {
          "type": "url",
          "id": "custom_button_link",
          "label": "Custom Button Link (Optional)"
        }
      ]
    },
    {
      "type": "html_embed",
      "name": "HTML Embed / Script",
      "settings": [
        {
          "type": "checkbox",
          "id": "enable_block",
          "label": "Enable Embed",
          "default": true
        },
        {
          "type": "text",
          "id": "title",
          "label": "Embed Label (For reference)",
          "default": "HTML Embed Code"
        },
        {
          "type": "textarea",
          "id": "html_code",
          "label": "HTML / Script Code"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Home Blocks",
      "blocks": [
        {
          "type": "collection_block"
        }
      ]
    }
  ]
}
{% endschema %}
