{%- assign g1_hex = section.settings.gradient_color_1 | default: '#000000' -%}
{%- assign g1_op = section.settings.gradient_opacity_1 | divided_by: 100.0 -%}
{%- assign g2_hex = section.settings.gradient_color_2 | default: '#0a0a0a' -%}
{%- assign g2_op = section.settings.gradient_opacity_2 | divided_by: 100.0 -%}

<style>
  .jj-brand-slider-wrap {
    width: 100% !important;
    max-width: 100% !important;
    overflow: hidden !important;
    margin-top: 0 !important;
    padding-top: 0 !important;
  }

  .jj-brand-slider-list {
    display: flex !important;
    flex-direction: row !important;
    flex-wrap: nowrap !important;
    overflow-x: auto !important;
    overflow-y: hidden !important;
    -webkit-overflow-scrolling: touch !important;
    touch-action: pan-x !important;
    width: 100% !important;
    scroll-snap-type: x mandatory !important;
    padding: 0 4rem 1.5rem !important;
    gap: 20px !important;
    box-sizing: border-box !important;
    scrollbar-width: none !important;
    -ms-overflow-style: none !important;
  }
  .jj-brand-slider-list::-webkit-scrollbar { display: none !important; }

  .jj-brand-card-item {
    flex: 0 0 280px !important;
    width: 280px !important;
    height: 380px !important; /* Restored full, non-condensed height */
    min-height: 380px !important;
    position: relative !important;
    scroll-snap-align: start !important;
    border-radius: 8px !important;
    overflow: hidden !important;
  }

  @media (max-width: 767px) {
    .jj-brand-slider-list {
      padding: 0 1.5rem 1rem !important;
      gap: 12px !important;
    }
    .jj-brand-card-item {
      flex: 0 0 200px !important;
      width: 200px !important;
      height: 280px !important;
      min-height: 280px !important;
    }
  }

  .jj-brand-card-link {
    display: block !important;
    width: 100% !important;
    height: 100% !important;
    position: relative !important;
    text-decoration: none !important;
    border-radius: 8px !important;
    overflow: hidden !important;
  }

  .jj-brand-card-inner {
    width: 100% !important;
    height: 100% !important;
    position: relative !important;
    display: flex !important;
    flex-direction: column !important;
    justify-content: center !important;
    align-items: center !important;
    padding: 20px !important;
    box-sizing: border-box !important;
  }

  .jj-brand-card-title {
    position: relative !important;
    z-index: 3 !important;
    font-family: var(--font-display), 'Inter', sans-serif !important;
    font-size: 1.4rem !important;
    font-weight: 800 !important;
    text-transform: uppercase !important;
    letter-spacing: 0.05em !important;
    color: #ffffff !important;
    text-align: center !important;
    margin-bottom: 6px !important;
    text-shadow: 0 2px 10px rgba(0,0,0,0.8) !important;
  }

  .jj-brand-card-count {
    position: relative !important;
    z-index: 3 !important;
    font-family: 'Inter', sans-serif !important;
    font-size: 11px !important;
    font-weight: 600 !important;
    text-transform: uppercase !important;
    letter-spacing: 0.1em !important;
    color: rgba(255, 255, 255, 0.75) !important;
    text-align: center !important;
  }

  .jj-brand-card-img {
    position: absolute !important;
    top: 0 !important;
    left: 0 !important;
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    z-index: 1 !important;
    transition: transform 0.4s ease !important;
  }

  .jj-brand-card-link:hover .jj-brand-card-img {
    transform: scale(1.05) !important;
  }

  #brand-section-{{ section.id }} .jj-brand-card-overlay {
    position: absolute !important;
    top: 0 !important;
    left: 0 !important;
    width: 100% !important;
    height: 100% !important;
    z-index: 2 !important;
    background-image: linear-gradient(180deg, 
      {{ g1_hex | color_modify: 'alpha', g1_op }}, 
      {{ g2_hex | color_modify: 'alpha', g2_op }}
    ) !important;
  }
</style>

<div class="brand-view" id="brand-section-{{ section.id }}" style="margin-top: 0 !important; padding-top: 0 !important;">
  <h1 class="heading" style="margin-top: 0 !important; margin-bottom: 1.5rem !important;">{{ section.settings.heading }}</h1>
  {%- render "categories" -%}
</div>

{% schema %}
{
  "name": "Shop By Brand",
  "tag": "section",
  "class": "hero-brand-listing",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "SHOP BY BRAND"
    },
    {
      "type": "header",
      "content": "Gradient Overlay Styles"
    },
    {
      "type": "color",
      "id": "gradient_color_1",
      "label": "Gradient Color (Top)",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "gradient_opacity_1",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Gradient Opacity (Top)",
      "default": 40
    },
    {
      "type": "color",
      "id": "gradient_color_2",
      "label": "Gradient Color (Bottom)",
      "default": "#0a0a0a"
    },
    {
      "type": "range",
      "id": "gradient_opacity_2",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Gradient Opacity (Bottom)",
      "default": 90
    }
  ],
  "presets": [
    {
      "name": "Shop By Brand"
    }
  ]
}
{% endschema %}
